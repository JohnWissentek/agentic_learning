# 双栈可观测性中心本地环境变量模板（复制为 .env 后即可启动，请勿提交真实 .env）

# Langfuse v3 加密与认证密钥（必须为 64 位十六进制字符 = 32 字节）
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=5f8a2e9c4b1d7036f2a4c8e1d9b37502a6c4e8f0123456789abcdef012345678
SALT=9d4e2f1a8c6b3057e2a9c4d6f8b0123456789abcdef0123456789abcdef01234
ENCRYPTION_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90
TELEMETRY_ENABLED=false

# 底层存储凭据（仅监听容器内网，安全隔离）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=langfuse_pg_local
POSTGRES_DB=postgres
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=langfuse_ch_local
REDIS_PASSWORD=langfuse_redis_local
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=langfuse_minio_local

# Langfuse v3 Headless 自动初始化（首次启动免注册直登）
LANGFUSE_INIT_ORG_ID=wissentek-org
LANGFUSE_INIT_ORG_NAME=Wissentek
LANGFUSE_INIT_PROJECT_ID=boiler-fbg-rd
LANGFUSE_INIT_PROJECT_NAME=BoilerSense-AI-IPD
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-boiler-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-boiler-local
LANGFUSE_INIT_USER_EMAIL=admin@wissentek.local
LANGFUSE_INIT_USER_NAME=ChiefEngineer
LANGFUSE_INIT_USER_PASSWORD=Admin123456!

# 双栈导出端点配置（宿主机 Python 进程调用）
OBS_LANGFUSE_OTLP_ENDPOINT=http://127.0.0.1:3000/api/public/otel/v1/traces
OBS_PHOENIX_OTLP_ENDPOINT=http://127.0.0.1:6006/v1/traces
OBS_LIVE_CANVAS_URL=http://127.0.0.1:8765
