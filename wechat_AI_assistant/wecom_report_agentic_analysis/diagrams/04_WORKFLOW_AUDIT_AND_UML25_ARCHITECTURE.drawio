        <mxCell id="lg_init_t" value="初始伪状态" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=middle;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="2708" y="28" width="86" height="38" as="geometry"/></mxCell>
        <mxCell id="lg_fin" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="2802" y="34" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="lg_fin_t" value="终止状态" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=middle;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="2834" y="28" width="76" height="38" as="geometry"/></mxCell>
        <mxCell id="lg_ch" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="2918" y="32" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="lg_ch_t" value="选择伪状态" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=middle;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="2954" y="28" width="86" height="38" as="geometry"/></mxCell>
        <mxCell id="lg_code" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:7px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;确定性底盘状态&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;do / 0模型事实与安全&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3060" y="18" width="160" height="74" as="geometry"/></mxCell>
        <mxCell id="lg_llm" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#4c1d95;padding:7px 10px 6px 10px;border-bottom:1.5px solid #6d28d9;&quot;&gt;&lt;b&gt;旗舰主脑状态&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;do / 翻查与初稿生成&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3235" y="18" width="160" height="74" as="geometry"/></mxCell>
        <mxCell id="lg_tool" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#064e3b;padding:7px 10px 6px 10px;border-bottom:1.5px solid #047857;&quot;&gt;&lt;b&gt;只读查证车间&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;do / 4项只读查证工具&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3410" y="18" width="160" height="74" as="geometry"/></mxCell>
        <mxCell id="lg_red" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#991b1b;padding:7px 10px 6px 10px;border-bottom:1.5px solid #dc2626;&quot;&gt;&lt;b&gt;独立红队复核&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;do / 专揪漏洞发预警&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3585" y="18" width="165" height="74" as="geometry"/></mxCell>
        <mxCell id="lg_ver" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#78350f;padding:7px 10px 6px 10px;border-bottom:1.5px solid #b45309;&quot;&gt;&lt;b&gt;证据核验定档&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;do / 查真伪定红黄蓝&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#b45309;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3765" y="18" width="160" height="74" as="geometry"/></mxCell>
        <mxCell id="lg_com" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#7c2d12;padding:7px 10px 6px 10px;border-bottom:1.5px solid #c2410c;&quot;&gt;&lt;b&gt;预警PDF与发信&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;do / 分级预警邮件&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3940" y="18" width="165" height="74" as="geometry"/></mxCell>
        <mxCell id="lg_note" value="&lt;b&gt;方案 B 核心定位：找漏洞 + 分级预警（Alert）+ 可落地整改建议&lt;/b&gt;&lt;br/&gt;每周低频高价值审计启用独立红队复核（100% 共享原始证据，绝不和稀泥），轻量防假证据核验保障预警稳定送达。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=16;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;spacingRight=14;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="4120" y="18" width="580" height="74" as="geometry"/></mxCell>
        <mxCell id="sys_root" value="维恩科仪周度经营漏洞预警与 AI 提效智能体系统 V2.3（独立运行 · 不集成网页看板 · 含两个并发正交区域）" style="swimlane;startSize=40;rounded=1;arcSize=2;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2.5;fontSize=17;fontStyle=1;fontColor=#0f172a;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="4660" height="1790" as="geometry"/></mxCell>
        <mxCell id="reg_a_lbl" value="正交区域 A｜周度经营漏洞挖掘、分级预警（Alert）与 PDF 邮件投递主状态机（首次全量 / 后续增量分流 → 主脑翻查 ≤18 轮出初稿 → 独立红队挑刺补漏洞 → 证据核验定档 → 预警 PDF 发信）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="64" y="160" width="4400" height="30" as="geometry"/></mxCell>
        <mxCell id="top_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="66" y="540" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="stg1" value="阶段一：确定性采集（首次全量 / 后续增量）与四期桌面装配底盘（0% 大模型）" style="swimlane;startSize=36;rounded=1;arcSize=3;fillColor=#f8fafc;strokeColor=#2563eb;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#1e3a8a;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="165" y="205" width="1380" height="975" as="geometry"/></mxCell>
        <mxCell id="s_check_wm" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:7px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;校验凭据与检查水位&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;entry / 读取企业微信只读凭据与 5 类汇报模板清单&lt;br/&gt;do / 同步最新公司花名册&lt;br/&gt;do / 读取本地同步水位记录，判定是否已完成首次全量历史拉取&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="188" y="415" width="255" height="280" as="geometry"/></mxCell>
        <mxCell id="c_sync_mode" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="500" y="533" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="s_full_sync" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:7px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;首次全量历史拉取&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;do / 自历史起点按 ≤25 天切片分页回溯，一次性拉取全部 5 类历史汇报（支持断点续传）&lt;br/&gt;exit / 按唯一汇报编号幂等写入本地分析库（绝不改写董事长任务主表），打标「已完成首次全量」并记录同步水位&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="655" y="265" width="300" height="210" as="geometry"/></mxCell>
        <mxCell id="s_inc_sync" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:7px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;后续增量拉取汇报&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;do / 仅从上次同步水位起拉取新增汇报（自动兼容近期迟交补报并按唯一编号跳过已入库记录，绝不重拉全量历史）&lt;br/&gt;exit / 幂等写入本次新增汇报至本地分析库（绝不改写董事长任务主表），推进最新同步水位&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="655" y="565" width="300" height="210" as="geometry"/></mxCell>
        <mxCell id="c_sync" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1018" y="533" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="s_desktop" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:7px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;核算四期趋势与装配桌面&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;entry / 读取四层战略目标配置文件（长期 / 年度 / 季度 / 月度）并生成日历锚点表&lt;br/&gt;do / 纯代码精确核算四层滚动趋势硬矩阵：自今日往前推【近1月 / 近1季 / 近1年 / 全量长期】提交率、负荷、出差与高成本研发占比曲线&lt;br/&gt;do / 只读装配公司 15 人花名册、董事长在途任务快照与历次月度/季度归档摘要&lt;br/&gt;exit / 为近 30 天汇报全文分配短编号（R-001起）并包裹不可信外部数据物理围栏&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1198" y="395" width="325" height="320" as="geometry"/></mxCell>
        <mxCell id="f_sync_err" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="785" y="1020" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="f_sync_empty" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1250" y="1020" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="stg2" value="阶段二：旗舰主脑多周期翻查（上限 18 轮，可配置）与诊断初稿生成（Model-First + ReAct）" style="swimlane;startSize=36;rounded=1;arcSize=3;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#5b21b6;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1600" y="205" width="1100" height="975" as="geometry"/></mxCell>
        <mxCell id="s_brain" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#4c1d95;padding:7px 10px 6px 10px;border-bottom:1.5px solid #6d28d9;&quot;&gt;&lt;b&gt;旗舰主脑研判与翻查&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;entry / 读取共享白板：四层目标、四期滚动趋势矩阵、围栏内近30天汇报及历次翻查回来的新证据&lt;br/&gt;do / 唤醒旗舰推理主脑（开启深度思考）：拿【月/季/年/长期】四层目标当照妖镜，识别业务偏离、执行漏洞与跨季异常拐点&lt;br/&gt;do / 若需核实更早历史因果或重点任务细节，则发起只读翻查请求（单轮可并发查多项）；若证据已查齐，则宣布停止翻查&lt;br/&gt;exit / 翻查次数 +1，全量思考链与上下文推送至监控大盘&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1625" y="395" width="325" height="320" as="geometry"/></mxCell>
        <mxCell id="c_react" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="2065" y="533" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="s_tools" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#064e3b;padding:7px 10px 6px 10px;border-bottom:1.5px solid #047857;&quot;&gt;&lt;b&gt;只读查证工具车间（仅 4 项只读工具）&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;entry / 校验工具白名单与严格只读权限（严禁写库或外发消息）&lt;br/&gt;do / 工具 1 · 查历次审计摘要：对比近月/近季/近年的整改落实与预警收敛轨迹&lt;br/&gt;do / 工具 2 · 回溯全量历史汇报原文：按员工、产品线或客户精准下钻任意历史窗口原件&lt;br/&gt;do / 工具 3 · 查关键员工与董事长任务详情：拉取重点人员或董事长在途任务完整进展流水&lt;br/&gt;do / 工具 4 · 精确日期与占比计算器：确定性计算跨度天数与环比变化，杜绝心算误差&lt;br/&gt;exit / 将真实查证结果（含外部围栏）贴回共享白板，出错时保留原文不崩溃&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1625" y="835" width="405" height="315" as="geometry"/></mxCell>
        <mxCell id="s_synth" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#4c1d95;padding:7px 10px 6px 10px;border-bottom:1.5px solid #6d28d9;&quot;&gt;&lt;b&gt;旗舰主脑生成诊断初稿&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;entry / 撤掉工具查证权限，锁定桌面上已集齐的全部四期证据与翻查事实&lt;br/&gt;do / 闭卷生成诊断初稿：梳理全公司核心任务还原、四层目标向好/偏离轨迹、高成本研发精力去向、董事长盲区空转项与 AI 提效机会&lt;br/&gt;exit / 将结构化诊断初稿写入共享白板，移交独立红队挑刺复核&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2350" y="395" width="325" height="320" as="geometry"/></mxCell>
        <mxCell id="stg3" value="阶段三（方案 B）：独立红队漏洞挑刺复核 + 证据真实性核验与 Alert 分级定档" style="swimlane;startSize=36;rounded=1;arcSize=3;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#92400e;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="2835" y="205" width="1025" height="975" as="geometry"/></mxCell>
        <mxCell id="s_redteam" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#991b1b;padding:7px 10px 6px 10px;border-bottom:1.5px solid #dc2626;&quot;&gt;&lt;b&gt;独立红队漏洞挑刺复核&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;entry / 100% 共享完整四层目标、四期硬统计、围栏内近30天汇报、翻查事实、阶段二初稿及（若有）证据纠偏清单（零传话断层）&lt;br/&gt;do / 唤醒独立红队复核大模型（严禁和稀泥）：专揪阶段二漏掉的管理漏洞、报喜不报忧、高成本研发稀释、零汇报黑箱、停滞任务与国产化/渠道化缺位&lt;br/&gt;do / 为每条漏洞输出明确的 Alert 预警级别（高危红警 / 偏离黄警 / 提效蓝提示）与董事长可直接拍板的硬建议&lt;br/&gt;exit / 输出漏洞预警增强版最终报告，并将全量挑刺思考链推送监控大盘&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2860" y="395" width="340" height="320" as="geometry"/></mxCell>
        <mxCell id="s_verify" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#78350f;padding:7px 10px 6px 10px;border-bottom:1.5px solid #b45309;&quot;&gt;&lt;b&gt;证据真实性核验与预警定档&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;entry / 校验报告基本结构与 Alert 预警列表完整性&lt;br/&gt;do / 轻量防幻觉核查：校验每条 Alert 引用的汇报短编号（R-xxx）与董事长任务号 100% 真实存在、日期跨度与数字不自相矛盾（杜绝 AI 冤枉或误报）&lt;br/&gt;do / 自动按「🔴高危漏洞 / 🟡偏离风险 / 🔵AI与效率提示」排序归档，过滤内部代码黑话&lt;br/&gt;exit / 通过则自动回填真实汇报编号；发现伪造证据则列出报错明细；纠偏超限时仅标灰剔除存疑单条，不阻断已查实预警送达&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#b45309;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3315" y="395" width="335" height="320" as="geometry"/></mxCell>
        <mxCell id="c_verify" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="3755" y="533" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="f_verify_fail" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="3760" y="1020" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="stg4" value="阶段四：归档、预警驱动 PDF 排版与赛博狮鹫分级预警投递（0% 大模型）" style="swimlane;startSize=36;rounded=1;arcSize=3;fillColor=#fff7ed;strokeColor=#c2410c;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#9a3412;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="4010" y="205" width="665" height="975" as="geometry"/></mxCell>
        <mxCell id="s_deliver" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#7c2d12;padding:7px 10px 6px 10px;border-bottom:1.5px solid #c2410c;&quot;&gt;&lt;b&gt;归档、预警 PDF 渲染与邮件投递&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;entry / 单事务原子写入周度审计与漏洞预警库（绝不修改董事长任务主表），检查本周期防重发幂等锁&lt;br/&gt;do / 确定性排版高管级 PDF：首页置顶《本周经营漏洞 Alert 告警台与董事长决断清单》（按红/黄/蓝排序附实证与建议），后附四层目标演进图、15人硬统计、高成本研发穿透与 AI 替代清单&lt;br/&gt;do / 经由赛博狮鹫专属发件邮箱发信：主题自动标注最高告警等级与条数，正文直出 Top 预警与建议动作，完整 PDF 作为附件投递&lt;br/&gt;exit / 留存本地 PDF 归档副本、写入发信回执并闭合本轮监控轨迹&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="4040" y="395" width="365" height="320" as="geometry"/></mxCell>
        <mxCell id="c_deliver" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="4505" y="533" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="f_done" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="4160" y="1020" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="f_deliver_err" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="4508" y="1020" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="e_init" value="/ 初始化白板&lt;br/&gt;(翻查=0, 纠偏=0)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="top_init" target="s_check_wm"><mxGeometry x="-0.1" y="-34" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_wm_mode" value="水位&lt;br/&gt;核查完" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_check_wm" target="c_sync_mode"><mxGeometry x="0.0" y="-26" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_mode_full" value="[尚未完成首次全量拉取]&lt;br/&gt;/ 启动首次全量回溯" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_sync_mode" target="s_full_sync"><mxGeometry x="0.1" y="-28" relative="1" as="geometry"><Array as="points"><mxPoint x="522" y="370"/></Array><mxPoint x="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_mode_inc" value="[else：已完成首次全量]&lt;br/&gt;/ 仅执行增量拉取" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_sync_mode" target="s_inc_sync"><mxGeometry x="0.1" y="28" relative="1" as="geometry"><Array as="points"><mxPoint x="522" y="670"/></Array><mxPoint x="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_full_res" value="全量结束" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_full_sync" target="c_sync"><mxGeometry x="-0.2" y="-16" relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="370"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_inc_res" value="增量&lt;br/&gt;结束" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_inc_sync" target="c_sync"><mxGeometry x="-0.25" y="26" relative="1" as="geometry"><Array as="points"><mxPoint x="988" y="670"/><mxPoint x="988" y="555"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_sync_ok" value="[else：存在有效&lt;br/&gt;汇报] / 指标核算" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_sync" target="s_desktop"><mxGeometry x="0.0" y="-32" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_sync_err" value="[企微接口异常 且 重试耗尽]&lt;br/&gt;/ 记错误日志并邮件告警管理员" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#64748b;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_sync" target="f_sync_err"><mxGeometry x="0.25" y="-28" relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="875"/><mxPoint x="802" y="875"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_sync_empty" value="[本地无任何有效周期汇报]&lt;br/&gt;/ 记空跑日志，0 模型调用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#64748b;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_sync" target="f_sync_empty"><mxGeometry x="0.25" y="-28" relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="875"/><mxPoint x="1267" y="875"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_desk_brain" value="桌面装配&lt;br/&gt;完成" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6d28d9;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#6d28d9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_desktop" target="s_brain"><mxGeometry x="0.0" y="-28" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_brain_c" value="完成本轮&lt;br/&gt;研判" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6d28d9;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#6d28d9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_brain" target="c_react"><mxGeometry x="0.0" y="-26" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_react_tool" value="[需要继续翻查历史档案 且 翻查次数 &amp;lt; 18]&lt;br/&gt;/ 放行调用只读查证工具" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_react" target="s_tools"><mxGeometry x="-0.25" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="2087" y="992"/></Array><mxPoint x="145" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_tool_brain" value="只读查证完毕 / 贴回围栏事实再次唤醒大脑" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.4;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_tools" target="s_brain"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="140" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_react_synth" value="[else：证据已查齐 或 翻查次数 &amp;gt;= 18]&lt;br/&gt;/ 停止翻查，进入初稿收口" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6d28d9;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#6d28d9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_react" target="s_synth"><mxGeometry x="0.0" y="-32" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_synth_red" value="提交诊断&lt;br/&gt;初稿" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b91c1c;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#b91c1c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_synth" target="s_redteam"><mxGeometry x="0.0" y="-28" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_red_ver" value="输出预警&lt;br/&gt;增强报告" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b45309;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#b45309;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_redteam" target="s_verify"><mxGeometry x="0.0" y="-28" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_ver_c" value="核验&lt;br/&gt;完成" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b45309;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#b45309;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_verify" target="c_verify"><mxGeometry x="0.0" y="-26" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_ver_retry" value="[发现伪造证据或结构解析失败 且 纠偏次数 &amp;lt; 2] / 纠偏次数 +1 并附精确报错退回红队定向修正" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#b91c1c;strokeWidth=2.5;fontSize=12.5;fontStyle=1;fontColor=#b91c1c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_verify" target="s_redteam"><mxGeometry x="0.0" y="-16" relative="1" as="geometry"><Array as="points"><mxPoint x="3777" y="296"/><mxPoint x="3030" y="296"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_ver_ok" value="[证据核验通过 或 次要存疑项已标灰剔除]&lt;br/&gt;/ 放行生成分级预警 PDF 并投递" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#c2410c;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#c2410c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_verify" target="s_deliver"><mxGeometry x="0.0" y="-32" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_ver_fail" value="[else：纠偏 &amp;gt;= 2 且 报告彻底损坏无法解析]&lt;br/&gt;/ 保留客观硬统计草稿并告警维护人" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#b91c1c;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#b91c1c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_verify" target="f_verify_fail"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="-155" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_del_c" value="排版发信&lt;br/&gt;结束" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#c2410c;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#c2410c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_deliver" target="c_deliver"><mxGeometry x="0.0" y="-28" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_del_ok" value="[预警 PDF 渲染与赛博狮鹫发信成功 或 已幂等去重]&lt;br/&gt;/ 完成本周期漏洞预警与报告投递" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_deliver" target="f_done"><mxGeometry x="0.1" y="-30" relative="1" as="geometry"><Array as="points"><mxPoint x="4527" y="825"/><mxPoint x="4177" y="825"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_del_err" value="[else：PDF 异常或发信重试耗尽]&lt;br/&gt;/ 保留已归档报告与本地 PDF 待补发" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#64748b;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_deliver" target="f_deliver_err"><mxGeometry x="0.45" y="0" relative="1" as="geometry"><mxPoint x="-130" as="offset"/></mxGeometry></mxCell>
        <mxCell id="ortho_h" value="" style="line;strokeWidth=2;dashed=1;dashPattern=8 6;strokeColor=#64748b;fillColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="56" y="1212" width="4628" height="4" as="geometry"/></mxCell>
        <mxCell id="ortho_v" value="" style="line;strokeWidth=2;dashed=1;dashPattern=8 6;strokeColor=#94a3b8;fillColor=none;html=1;direction=south;" vertex="1" parent="1"><mxGeometry x="1720" y="1232" width="4" height="650" as="geometry"/></mxCell>
        <mxCell id="reg_b1_lbl" value="正交区域 B1｜定期调度与图形界面触发（每周自动运行 + 图形界面随点随跑）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="64" y="1235" width="1600" height="30" as="geometry"/></mxCell>
        <mxCell id="b1_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="72" y="1418" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="s_sched_wait" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#0f172a;padding:7px 10px 6px 10px;border-bottom:1.5px solid #475569;&quot;&gt;&lt;b&gt;定时与图形界面待命中&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;do / 常驻等待每周五 18:00 定时时钟信号（以当日为锚点滚算月/季/年/长期四维对比）&lt;br/&gt;do / 同时支持在图形工作台（LangGraph Studio）指定任意分析基准日手动点击启动&lt;br/&gt;说明 / 与董事长个人微信助理网页看板彻底解耦，互不阻塞&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="145" y="1300" width="580" height="270" as="geometry"/></mxCell>
        <mxCell id="s_sched_fire" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:7px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;派发周期分析批次&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;entry / 检查是否已有同批次在途任务，避免并发重复执行&lt;br/&gt;do / 锁定本次分析基准日与独立线程存盘编号，拉起正交区域 A 主状态机&lt;br/&gt;exit / 若在图形界面运行，则支持中途单步查看状态白板与检查点重放&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1045" y="1300" width="605" height="270" as="geometry"/></mxCell>
        <mxCell id="e_b1_init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#64748b;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1_init" target="s_sched_wait"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_b1_fire" value="每周五 18:00 或 人工点击启动&lt;br/&gt;[无同周期在途批次]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_sched_wait" target="s_sched_fire"><mxGeometry x="0.0" y="-24" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_b1_back" value="批次拉起完成 / 回归待命等待下周期" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;strokeColor=#64748b;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_sched_fire" target="s_sched_wait"><mxGeometry x="0.0" y="16" relative="1" as="geometry"><Array as="points"><mxPoint x="1347" y="1618"/><mxPoint x="435" y="1618"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="note_b1" value="&lt;b&gt;架构边界声明（对照 07 / 08 / 09 / ADP 规范，经董事长拍板启用方案 B 红队挑刺）&lt;/b&gt;&lt;br/&gt;1. 彻底独立交付：不集成至微信助理网页看板、不向董事长发微信确认卡、严禁改写董事长个人任务主表（仅严格只读比对）。&lt;br/&gt;2. 合规升级 Ch.4 独立红队反思：本项目属低频高价值周度经营审计（每周仅 1 次），经董事长确认引入独立红队漏洞复核官，100% 共享原始桌面与翻查证据（零传话断层），专揪隐性漏洞发 Alert。&lt;br/&gt;3. 双重有界与降级送达：翻查上限死锁 [翻查次数 &amp;lt; 18]（可配置，超限转初稿）；证据纠偏死锁 [纠偏次数 &amp;lt; 2]，次要存疑仅标灰剔除绝不误拦整份预警邮件。&lt;br/&gt;4. 采集严格二分 + 配置外置：首次全量历史拉取与后续增量拉取显式分流；长期/年度/季度/月度四层战略目标统一收口至独立 JSON 配置文件，随时增补细节。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=16;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;spacingRight=14;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="145" y="1668" width="1505" height="198" as="geometry"/></mxCell>
        <mxCell id="reg_b2_lbl" value="正交区域 B2｜全链路可观测性与 LLM 上下文监控大盘（复用现有双栈观测中心 · 完整透视主脑翻查与红队挑刺全量上下文）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1760" y="1235" width="2850" height="30" as="geometry"/></mxCell>
        <mxCell id="b2_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1768" y="1418" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="s_obs_cap" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#064e3b;padding:7px 10px 6px 10px;border-bottom:1.5px solid #047857;&quot;&gt;&lt;b&gt;全链路遥测采集与密钥脱敏&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;entry / 启动敏感凭据脱敏护栏，自动将全部大模型密钥、企微密钥与邮箱授权码掩码替换，确保大盘零泄密&lt;br/&gt;do / 无侵入监听主状态机全过程：捕获主脑每轮研判上下文与翻查工具问答、初稿生成、独立红队挑刺官的完整提示词与犀利思考链、证据核验报错与 Token 消耗&lt;br/&gt;exit / 绑定单次运行唯一追踪编号，单次采集同时双路扇出推送至三大可视化大盘&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1845" y="1295" width="1200" height="285" as="geometry"/></mxCell>
        <mxCell id="s_obs_ui" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#4c1d95;padding:7px 10px 6px 10px;border-bottom:1.5px solid #6d28d9;&quot;&gt;&lt;b&gt;多屏联动实时监控大盘呈现&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;do / 屏幕 1 · 实时拓扑与上下文显微镜（本地 :8765）：左侧实时高亮主脑翻查与红队挑刺节点流转，右侧逐字对比主脑初稿 vs 红队挑刺新增了哪些 Alert 漏洞与思考过程&lt;br/&gt;do / 屏幕 2 · 企业级轨迹分析平台（Langfuse :3000）：完整调用火焰树、十万字上下文检索、历次周报提示词版本对比与 Token 成本趋势&lt;br/&gt;do / 屏幕 3 · 轻量轨迹对照（Phoenix :6006）+ 图形执行工作台（LangGraph Studio）：支持图形化点击执行、逐节点白板快照审阅与历史运行回放&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3310" y="1295" width="1350" height="285" as="geometry"/></mxCell>
        <mxCell id="e_b2_init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2_init" target="s_obs_cap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_b2_push" value="每产生节点或对话事件&lt;br/&gt;/ 脱敏后实时双路推送" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_obs_cap" target="s_obs_ui"><mxGeometry x="0.0" y="-24" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_b2_back" value="本轮运行轨迹归档落盘 / 持续监听下一批次运行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;strokeColor=#64748b;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_obs_ui" target="s_obs_cap"><mxGeometry x="0.0" y="16" relative="1" as="geometry"><Array as="points"><mxPoint x="3985" y="1622"/><mxPoint x="2445" y="1622"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="note_b2" value="&lt;b&gt;为什么这套「主脑翻查 + 独立红队挑刺 + 三屏大盘」组合能把公司隐藏漏洞挖得最透？&lt;/b&gt;&lt;br/&gt;• 主脑负责“全面盘点” + 红队负责“专挑毛病发预警”：主脑通读全量四期数据还原全貌；独立红队复核官带着四层目标与 100% 原始证据专门挑主脑的刺，挖出报喜不报忧、高成本研发稀释、渠道/国产化缺位等隐性漏洞并强制分级出 Alert。&lt;br/&gt;• 全量上下文显微镜（复用现有 agentic_observability_hub）：在本地实时画布（:8765）和 Langfuse（:3000）中，董事长可随时点开看到主脑与红队两轮完整对话上下文，一眼看清红队是怎么把藏在员工日常汇报里的漏洞抓出来的。&lt;br/&gt;• 确定性底盘防误报不误拦：轻量证据核验确保每条 Alert 都有真实员工汇报编号撑腰（绝不冤枉人），遇到次要存疑项自动标灰剔除而不拒发整份预警 PDF，确保每周五关键预警必达董事长邮箱。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=16;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;spacingRight=14;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="1845" y="1668" width="2815" height="198" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
