  <diagram id="wecom-ops-uml25-v2" name="OMG-UML-2.5-状态机架构图">
    <mxGraphModel dx="1600" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3600" pageHeight="1940" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
