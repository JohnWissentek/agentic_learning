        <mxCell id="title" value="维恩科仪周度经营对齐与 AI 提效智能体 — OMG UML 2.5 行为状态机架构图（V2.0 独立 PDF 邮件版）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1800" height="42" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="严格遵循 OMG UML 2.5 状态机标准与大模型优先架构（07/08/09/ADP）：● 初始伪状态  ◉ 终止状态  圆角框=状态（entry/do/exit）  ◇ 动态分流  实线=事件[监护条件]/动作  虚线=正交并发区" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1860" height="30" as="geometry"/></mxCell>
        <mxCell id="lg_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1960" y="36" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="lg_init_t" value="初始伪状态" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=middle;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1988" y="28" width="92" height="38" as="geometry"/></mxCell>
        <mxCell id="lg_fin" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="2092" y="34" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="lg_fin_t" value="终止状态" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=middle;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="2124" y="28" width="82" height="38" as="geometry"/></mxCell>
        <mxCell id="lg_ch" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="2218" y="32" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="lg_ch_t" value="选择伪状态" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=middle;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="2254" y="28" width="92" height="38" as="geometry"/></mxCell>
        <mxCell id="lg_code" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:7px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;确定性底盘状态&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;do / 0模型事实与安全&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2380" y="18" width="165" height="74" as="geometry"/></mxCell>
        <mxCell id="lg_llm" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#4c1d95;padding:7px 10px 6px 10px;border-bottom:1.5px solid #6d28d9;&quot;&gt;&lt;b&gt;唯一旗舰大脑&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;do / 深度推理与收敛&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2560" y="18" width="165" height="74" as="geometry"/></mxCell>
        <mxCell id="lg_tool" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#064e3b;padding:7px 10px 6px 10px;border-bottom:1.5px solid #047857;&quot;&gt;&lt;b&gt;只读查证车间&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;do / 4项只读查证工具&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2740" y="18" width="165" height="74" as="geometry"/></mxCell>
        <mxCell id="lg_ver" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#78350f;padding:7px 10px 6px 10px;border-bottom:1.5px solid #b45309;&quot;&gt;&lt;b&gt;客观验钞门禁&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;do / 100%硬账核验&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#b45309;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2920" y="18" width="165" height="74" as="geometry"/></mxCell>
        <mxCell id="lg_com" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#7c2d12;padding:7px 10px 6px 10px;border-bottom:1.5px solid #c2410c;&quot;&gt;&lt;b&gt;归档与邮件投递&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;do / PDF排版与发信&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3100" y="18" width="175" height="74" as="geometry"/></mxCell>
        <mxCell id="lg_note" value="&lt;b&gt;去看板集成 · 独立闭环&lt;/b&gt;&lt;br/&gt;每周定期或图形界面触发，直出 PDF 附件经赛博狮鹫邮箱投递。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=16;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;spacingRight=14;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="3290" y="18" width="270" height="74" as="geometry"/></mxCell>
        <mxCell id="sys_root" value="维恩科仪周度经营战略对齐与 AI 提效智能体系统 V2.0（独立运行 · 不集成网页看板 · 含两个并发正交区域）" style="swimlane;startSize=40;rounded=1;arcSize=2;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2.5;fontSize=17;fontStyle=1;fontColor=#0f172a;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="3520" height="1790" as="geometry"/></mxCell>
        <mxCell id="reg_a_lbl" value="正交区域 A｜周度经营分析与 PDF 邮件投递主状态机（单脑旗舰 Level 2 + 有界只读查证乒乓球环 ≤6 步 + 确定性客观验钞纠偏环 ≤2 轮 · 每步自动存盘）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="64" y="160" width="2900" height="30" as="geometry"/></mxCell>
        <mxCell id="top_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="66" y="540" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="stg1" value="阶段一：确定性采集与桌面装配底盘（0% 大模型）" style="swimlane;startSize=36;rounded=1;arcSize=3;fillColor=#f8fafc;strokeColor=#2563eb;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#1e3a8a;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="165" y="205" width="920" height="975" as="geometry"/></mxCell>
        <mxCell id="s_sync" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:7px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;增量采集企业微信汇报&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;entry / 校验企业微信只读凭据与 5 类汇报模板清单&lt;br/&gt;do / 按 ≤25 天时间窗切片分页调用官方两步接口，拉取本周期全部 5 类全员汇报并同步最新公司花名册&lt;br/&gt;do / 清洗富文本格式，抽取完整表单字段与附件编号&lt;br/&gt;exit / 按唯一汇报编号幂等写入本地分析库（绝不改写董事长个人任务主表），记录新增篇数与水位&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="190" y="395" width="310" height="320" as="geometry"/></mxCell>
        <mxCell id="c_sync" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="560" y="533" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="s_desktop" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:7px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;核算硬指标与装配桌面&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;entry / 确定性生成日历锚点表（今日星期、本周应交工作日、上期窗口）&lt;br/&gt;do / 纯代码精确统计：按模板份数、全员 15 人提交频次、零汇报名单、去重出差天数与高成本研发频次&lt;br/&gt;do / 只读装配公司花名册、五大战略目标路线图、董事长在途任务快照与上期周报摘要&lt;br/&gt;exit / 为每条汇报分配短编号（R-001起）并包裹不可信外部数据物理围栏，防范汇报正文指令注入&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="730" y="395" width="330" height="320" as="geometry"/></mxCell>
        <mxCell id="f_sync_err" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="340" y="1020" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="f_sync_empty" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="790" y="1020" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="stg2" value="阶段二：旗舰大脑深度推理与有界查证乒乓球环（Model-First + ReAct）" style="swimlane;startSize=36;rounded=1;arcSize=3;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#5b21b6;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1140" y="205" width="820" height="975" as="geometry"/></mxCell>
        <mxCell id="s_brain" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#4c1d95;padding:7px 10px 6px 10px;border-bottom:1.5px solid #6d28d9;&quot;&gt;&lt;b&gt;旗舰大脑深度推理&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;entry / 读取共享白板：桌面权威事实、围栏内本周汇报、工具查证新事实及（若有）客观验钞报错明细&lt;br/&gt;do / 唤醒唯一旗舰推理大模型（开启深度思考）：跨多类汇报还原真实任务、识别战略偏差、穿透审计高成本研发、识别 AI 提效与岗位替代靶点&lt;br/&gt;do / 若需核对上周整改落地或跨周停滞跨度，则开具只读查证点菜单；信息齐备则直接输出结构化经营诊断契约&lt;br/&gt;exit / 查证步数 +1，全量思考链与输入输出推送至监控大盘&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1170" y="395" width="360" height="320" as="geometry"/></mxCell>
        <mxCell id="c_react" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1790" y="533" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="s_tools" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#064e3b;padding:7px 10px 6px 10px;border-bottom:1.5px solid #047857;&quot;&gt;&lt;b&gt;只读查证工具车间（仅 4 项只读工具）&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;entry / 校验工具白名单与严格只读权限（严禁写库或外发消息）&lt;br/&gt;do / 工具 1 · 查历史周报摘要：对比上周整改建议是否落实与评分变化&lt;br/&gt;do / 工具 2 · 回溯历史汇报原文：按员工或客户查近 60 天跨周任务真实跨度&lt;br/&gt;do / 工具 3 · 查关键员工完整明细：拉取重点人员或董事长在途任务完整进展流水&lt;br/&gt;do / 工具 4 · 精确日期与占比计算器：确定性计算天数差与百分比，杜绝心算误差&lt;br/&gt;exit / 将真实查证结果（含外部围栏）贴回共享白板，出错时保留原文不崩溃&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1170" y="835" width="450" height="315" as="geometry"/></mxCell>
        <mxCell id="stg3" value="阶段三：确定性客观验钞门禁（Verification Loop）" style="swimlane;startSize=36;rounded=1;arcSize=3;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#92400e;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="2095" y="205" width="625" height="975" as="geometry"/></mxCell>
        <mxCell id="s_verify" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#78350f;padding:7px 10px 6px 10px;border-bottom:1.5px solid #b45309;&quot;&gt;&lt;b&gt;确定性客观验钞与编号回填&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;entry / 强类型结构契约校验：检查必填字段与枚举范围&lt;br/&gt;do / 硬账 1 · 零幻觉溯源：校验全部汇报短编号（R-xxx）与董事长任务号 100% 真实存在&lt;br/&gt;do / 硬账 2 · 数学与完整性：校验任务起止日期与跨度天数一致、五大战略目标全覆盖、高成本研发精力占比和为 100%&lt;br/&gt;do / 硬账 3 · 展示净化：检查董事长执行摘要零内部代码术语、零重复一级标题&lt;br/&gt;exit / 全部通过则自动把短编号回填为真实汇报唯一编号；否则生成逐条精确报错清单&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#b45309;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2125" y="395" width="360" height="320" as="geometry"/></mxCell>
        <mxCell id="c_verify" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="2610" y="533" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="f_verify_fail" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="2615" y="1020" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="stg4" value="阶段四：归档、PDF 排版与赛博狮鹫邮件投递（0% 大模型）" style="swimlane;startSize=36;rounded=1;arcSize=3;fillColor=#fff7ed;strokeColor=#c2410c;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#9a3412;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="2870" y="205" width="665" height="975" as="geometry"/></mxCell>
        <mxCell id="s_deliver" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#7c2d12;padding:7px 10px 6px 10px;border-bottom:1.5px solid #c2410c;&quot;&gt;&lt;b&gt;归档、PDF 渲染与邮件投递&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;entry / 单事务原子写入周度审计档案库（绝不修改董事长任务主表），检查本周期防重发幂等锁&lt;br/&gt;do / 确定性排版生成高管级 PDF 经营诊断周报（含硬统计表、战略偏差图与一页纸决策摘要），校验页数非空与中文字体正常&lt;br/&gt;do / 经由赛博狮鹫专属发件邮箱发送邮件给董事长，正文附精炼核心结论，完整 PDF 报告作为附件投递（带超时与有界重试）&lt;br/&gt;exit / 留存本地 PDF 归档副本、写入邮件投递回执并闭合本轮监控轨迹&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2900" y="395" width="365" height="320" as="geometry"/></mxCell>
        <mxCell id="c_deliver" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="3365" y="533" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="f_done" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="3020" y="1020" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="f_deliver_err" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="3368" y="1020" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="e_init" value="/ 初始化白板&lt;br/&gt;(步数=0, 纠偏=0)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="top_init" target="s_sync"><mxGeometry x="-0.1" y="-34" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_sync_c" value="采集&lt;br/&gt;结束" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_sync" target="c_sync"><mxGeometry x="0.0" y="-26" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_sync_ok" value="[else：存在有效汇报]&lt;br/&gt;/ 进入指标核算" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_sync" target="s_desktop"><mxGeometry x="0.0" y="-32" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_sync_err" value="[企微接口异常 且 重试耗尽]&lt;br/&gt;/ 记错误日志并邮件告警管理员" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#64748b;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_sync" target="f_sync_err"><mxGeometry x="0.25" y="-28" relative="1" as="geometry"><Array as="points"><mxPoint x="582" y="840"/><mxPoint x="357" y="840"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_sync_empty" value="[周期内无任何汇报记录]&lt;br/&gt;/ 记空跑日志，0 模型调用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#64748b;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_sync" target="f_sync_empty"><mxGeometry x="0.25" y="-28" relative="1" as="geometry"><Array as="points"><mxPoint x="582" y="840"/><mxPoint x="807" y="840"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_desk_brain" value="桌面装配&lt;br/&gt;完成" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6d28d9;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#6d28d9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_desktop" target="s_brain"><mxGeometry x="0.0" y="-28" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_brain_c" value="完成本轮大脑输出" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6d28d9;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#6d28d9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_brain" target="c_react"><mxGeometry x="0.0" y="-18" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_react_tool" value="[含查证点菜单 且 查证步数 &amp;lt; 6]&lt;br/&gt;/ 放行执行只读查证工具" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_react" target="s_tools"><mxGeometry x="-0.25" y="-24" relative="1" as="geometry"><Array as="points"><mxPoint x="1812" y="992"/></Array><mxPoint x="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_tool_brain" value="只读查证完毕 / 贴回围栏事实再次唤醒大脑" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.45;exitY=0.0;exitDx=0;exitDy=0;entryX=0.56;entryY=1.0;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_tools" target="s_brain"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="140" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_react_done" value="[不含点菜单（信息齐备已交卷）]&lt;br/&gt;/ 提交结构化诊断报告" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b45309;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#b45309;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_react" target="s_verify"><mxGeometry x="0.0" y="-32" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_react_cap" value="[else：查证步数 &amp;gt;= 6 触发上限熔断] / 停止查证并按现有证据强制收敛" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.35;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#b91c1c;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#b91c1c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_react" target="s_verify"><mxGeometry x="-0.05" y="-16" relative="1" as="geometry"><Array as="points"><mxPoint x="1812" y="342"/><mxPoint x="2251" y="342"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_ver_c" value="客观验钞&lt;br/&gt;完成" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b45309;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#b45309;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_verify" target="c_verify"><mxGeometry x="0.0" y="-28" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_ver_retry" value="[验钞未通过 且 纠偏次数 &amp;lt; 2] / 纠偏次数 +1 并携带逐条客观报错退回大脑定向修正" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#b91c1c;strokeWidth=2.5;fontSize=12.5;fontStyle=1;fontColor=#b91c1c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_verify" target="s_brain"><mxGeometry x="0.0" y="-16" relative="1" as="geometry"><Array as="points"><mxPoint x="2632" y="284"/><mxPoint x="1350" y="284"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_ver_ok" value="[全部客观硬校验通过]&lt;br/&gt;/ 准予归档与投递" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#c2410c;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#c2410c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_verify" target="s_deliver"><mxGeometry x="0.0" y="-32" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_ver_fail" value="[else：纠偏次数 &amp;gt;= 2 触发质量熔断]&lt;br/&gt;/ 拒发 PDF 邮件，保留硬统计草稿并告警人工" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#b91c1c;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#b91c1c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_verify" target="f_verify_fail"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint x="-145" as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_del_c" value="排版发信&lt;br/&gt;结束" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#c2410c;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#c2410c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_deliver" target="c_deliver"><mxGeometry x="0.0" y="-28" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_del_ok" value="[PDF 渲染与赛博狮鹫发信成功 或 已幂等去重]&lt;br/&gt;/ 完成本周期分析与报告投递" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_deliver" target="f_done"><mxGeometry x="0.1" y="-30" relative="1" as="geometry"><Array as="points"><mxPoint x="3387" y="825"/><mxPoint x="3037" y="825"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_del_err" value="[else：PDF 异常或发信重试耗尽]&lt;br/&gt;/ 保留已归档报告与本地 PDF 待补发" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#64748b;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_deliver" target="f_deliver_err"><mxGeometry x="0.45" y="0" relative="1" as="geometry"><mxPoint x="-130" as="offset"/></mxGeometry></mxCell>
        <mxCell id="ortho_h" value="" style="line;strokeWidth=2;dashed=1;dashPattern=8 6;strokeColor=#64748b;fillColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="56" y="1212" width="3488" height="4" as="geometry"/></mxCell>
        <mxCell id="ortho_v" value="" style="line;strokeWidth=2;dashed=1;dashPattern=8 6;strokeColor=#94a3b8;fillColor=none;html=1;direction=south;" vertex="1" parent="1"><mxGeometry x="1320" y="1232" width="4" height="650" as="geometry"/></mxCell>
        <mxCell id="reg_b1_lbl" value="正交区域 B1｜定期调度与图形界面触发（每周自动运行 + 图形界面随点随跑）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="64" y="1235" width="1220" height="30" as="geometry"/></mxCell>
        <mxCell id="b1_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="72" y="1418" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="s_sched_wait" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#0f172a;padding:7px 10px 6px 10px;border-bottom:1.5px solid #475569;&quot;&gt;&lt;b&gt;定时与图形界面待命中&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;do / 常驻等待每周五 18:00 定时时钟信号（周度分析窗口：近 7 天）&lt;br/&gt;do / 同时支持在图形工作台（LangGraph Studio）自定义任意起止日期手动点击启动&lt;br/&gt;说明 / 与董事长个人微信助理网页看板彻底解耦，互不阻塞&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="145" y="1300" width="430" height="270" as="geometry"/></mxCell>
        <mxCell id="s_sched_fire" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:7px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;派发周期分析批次&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;entry / 检查是否已有同周期在途任务，避免并发重复执行&lt;br/&gt;do / 计算目标周期起止日期、绑定独立线程存盘编号，拉起正交区域 A 主状态机&lt;br/&gt;exit / 若在图形界面运行，则支持中途单步查看状态白板与回放重跑&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="795" y="1300" width="475" height="270" as="geometry"/></mxCell>
        <mxCell id="e_b1_init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#64748b;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1_init" target="s_sched_wait"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_b1_fire" value="每周五 18:00 或 人工点击启动&lt;br/&gt;[无同周期在途批次]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_sched_wait" target="s_sched_fire"><mxGeometry x="0.0" y="-24" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_b1_back" value="批次拉起完成 / 回归待命等待下周期" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;strokeColor=#64748b;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_sched_fire" target="s_sched_wait"><mxGeometry x="0.0" y="16" relative="1" as="geometry"><Array as="points"><mxPoint x="1032" y="1618"/><mxPoint x="360" y="1618"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="note_b1" value="&lt;b&gt;架构边界声明（对照 07 / 08 / 09 与生产级交付宪章）&lt;/b&gt;&lt;br/&gt;1. 彻底独立交付：不集成至微信助理网页看板、不向董事长发微信确认卡、严禁改写董事长个人任务主表（仅严格只读比对）。&lt;br/&gt;2. 单脑克制（够用即止）：0 次小模型路由器、0 次二审打架大模型、0 条解析中文口语的脆弱正则；仅配备 4 项只读查证工具（远低于 12 工具上限）。&lt;br/&gt;3. 双重有界熔断证明：ReAct 查证环死锁 [查证步数 &amp;lt; 6]，客观验钞纠偏环死锁 [纠偏次数 &amp;lt; 2]，每条环路均有明确逃生出口，绝无死循环与费用失控。&lt;br/&gt;4. 配置外置与防重：15 人花名册、五大战略路线图与收件人邮箱统一收口至独立配置文件，无需修改程序代码即可按季度维护。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=16;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;spacingRight=14;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="145" y="1668" width="1125" height="198" as="geometry"/></mxCell>
        <mxCell id="reg_b2_lbl" value="正交区域 B2｜全链路可观测性与 LLM 上下文监控大盘（复用现有双栈观测中心 · 完整透视每轮提示词、上下文与思考链）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1356" y="1235" width="2150" height="30" as="geometry"/></mxCell>
        <mxCell id="b2_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1364" y="1418" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="s_obs_cap" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#064e3b;padding:7px 10px 6px 10px;border-bottom:1.5px solid #047857;&quot;&gt;&lt;b&gt;全链路遥测采集与密钥脱敏&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;entry / 启动敏感凭据脱敏护栏，自动将全部大模型密钥、企微密钥与邮箱授权码掩码替换，确保大盘零泄密&lt;br/&gt;do / 无侵入监听主状态机全过程：捕获每次节点进入/退出、发给大模型的完整系统提示词与桌面上下文、大模型深度思考链、每次只读查证工具的入参与返回原文、客观验钞报错明细与 Token 消耗&lt;br/&gt;exit / 绑定单次运行唯一追踪编号，单次采集同时双路扇出推送至三大可视化大盘&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1440" y="1295" width="820" height="285" as="geometry"/></mxCell>
        <mxCell id="s_obs_ui" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#4c1d95;padding:7px 10px 6px 10px;border-bottom:1.5px solid #6d28d9;&quot;&gt;&lt;b&gt;多屏联动实时监控大盘呈现&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:12.5px;color:#1e293b;padding:8px 11px 8px 11px;line-height:1.48;&quot;&gt;do / 屏幕 1 · 实时拓扑与上下文显微镜（本地 :8765）：左侧实时高亮当前执行节点与循环路径，右侧逐字审阅完整未截断的输入上下文、思考链与回复&lt;br/&gt;do / 屏幕 2 · 企业级轨迹分析平台（Langfuse :3000）：完整调用火焰树、十万字上下文检索、历次周报提示词版本对比与 Token 成本趋势&lt;br/&gt;do / 屏幕 3 · 轻量轨迹对照（Phoenix :6006）+ 图形执行工作台（LangGraph Studio）：支持图形化点击执行、逐节点白板快照审阅与历史运行回放&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2510" y="1295" width="1020" height="285" as="geometry"/></mxCell>
        <mxCell id="e_b2_init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2_init" target="s_obs_cap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_b2_push" value="每产生节点或对话事件&lt;br/&gt;/ 脱敏后实时双路推送" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_obs_cap" target="s_obs_ui"><mxGeometry x="0.0" y="-24" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_b2_back" value="本轮运行轨迹归档落盘 / 持续监听下一批次运行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;strokeColor=#64748b;strokeWidth=2.2;fontSize=12.5;fontStyle=1;fontColor=#64748b;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_obs_ui" target="s_obs_cap"><mxGeometry x="0.0" y="16" relative="1" as="geometry"><Array as="points"><mxPoint x="3020" y="1622"/><mxPoint x="1850" y="1622"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="note_b2" value="&lt;b&gt;为什么这套方案同时满足「图形界面执行」与「完整 LLM 上下文监控」？&lt;/b&gt;&lt;br/&gt;• 图形界面执行与调试（LangGraph Studio）：主状态机基于标准 LangGraph 状态图编译并暴露配置文件，启动后直接在浏览器图形界面看到完整节点拓扑，点击按钮即可触发周度分析，并可查看任意节点的实时共享白板状态。&lt;br/&gt;• 全量上下文显微镜（复用现有 agentic_observability_hub）：运行期间每次与大模型的完整对话（系统指令 + 围栏内员工汇报 + 查证工具问答 + 深度思考链 + 验钞退回重修前后对比）100% 无截断送入本地实时画布（:8765）与 Langfuse（:3000），支持事后随时复盘与零成本回放。&lt;br/&gt;• 生产级确定性护栏：短编号防幻觉回填、日期跨度与研发占比数学对账、展示层去技术黑话检查、PDF 完整性核验、同周期防重发幂等锁，全部由确定性底盘刚性兜底。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=16;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;spacingRight=14;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="1440" y="1668" width="2090" height="198" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
