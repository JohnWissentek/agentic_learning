<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Antigravity-UML25" version="24.7.17">
  <diagram id="uml25-state-machine" name="UML 2.5 状态机架构图">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4960" pageHeight="2720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="董事长个人 AI 项目助理 — UML 2.5 行为状态机架构图（纯 PMO 纳管版）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2200" height="44" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="严格遵循 OMG UML 2.5 状态机图标准：实心黑圆●=入口，双圆◉=本轮终止，圆角框=状态（entry/do/exit），空心菱形◇=动态分流，实线箭头=触发事件 [监护条件] / 动作，虚线分隔=并发正交区域" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="2600" height="30" as="geometry"/></mxCell>
        <mxCell id="lg_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="2920" y="34" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="lg_init_t" value="初始伪状态 ●" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2952" y="26" width="120" height="40" as="geometry"/></mxCell>
        <mxCell id="lg_fin" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="3080" y="32" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="lg_fin_t" value="终止状态 ◉" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3116" y="26" width="130" height="40" as="geometry"/></mxCell>
        <mxCell id="lg_ch" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="3254" y="30" width="32" height="32" as="geometry"/></mxCell>
        <mxCell id="lg_ch_t" value="选择伪状态 ◇" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3294" y="26" width="140" height="40" as="geometry"/></mxCell>
        <mxCell id="lg_code" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:6px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;确定性代码状态&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 0模型确定性执行&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3440" y="14" width="190" height="74" as="geometry"/></mxCell>
        <mxCell id="lg_llm" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#4c1d95;padding:6px 10px 6px 10px;border-bottom:1.5px solid #6d28d9;&quot;&gt;&lt;b&gt;大模型推理状态&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 调用指定档位模型&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3648" y="14" width="190" height="74" as="geometry"/></mxCell>
        <mxCell id="lg_commit" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#7c2d12;padding:6px 10px 6px 10px;border-bottom:1.5px solid #c2410c;&quot;&gt;&lt;b&gt;受控写库状态&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;entry / 校验人类确认令牌&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3856" y="14" width="190" height="74" as="geometry"/></mxCell>
        <mxCell id="lg_note" value="&lt;b&gt;迁移标签语法：触发事件 [监护条件] / 执行动作&lt;/b&gt;&lt;br/&gt;全图唯一回环位于路径④审核处，由 [未通过 且 重写次数 &amp;lt; 2] 严格封顶；本系统为纯项目管理（PMO），绝不代干具体业务活。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=16;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;spacingRight=14;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="4064" y="14" width="856" height="74" as="geometry"/></mxCell>
        <mxCell id="sys_root" value="董事长个人 AI 项目助理系统（7×24 在线 · 含两个并发正交区域）" style="swimlane;startSize=40;rounded=1;arcSize=3;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2.5;fontSize=17;fontStyle=1;fontColor=#0f172a;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="4880" height="2568" as="geometry"/></mxCell>
        <mxCell id="reg_a_lbl" value="正交区域 A｜单次消息处理主状态机（事件驱动：来一条消息走完一遍，随即回到「待机等待中」，不在后台空转）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="64" y="160" width="1400" height="30" as="geometry"/></mxCell>
        <mxCell id="top_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="68" y="435" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="s_idle" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#0f172a;padding:6px 10px 6px 10px;border-bottom:1.5px solid #475569;&quot;&gt;&lt;b&gt;待机等待中&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 持续监听微信消息回调与定时汇总唤醒&lt;br/&gt;说明 / 上一轮的对话历史、待确认卡片与在途待办均已安全保存在本地数据库&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="124" y="340" width="256" height="220" as="geometry"/></mxCell>
        <mxCell id="t_top_init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="top_init" target="s_idle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_turn" value="复合状态：单次处理周期（阶段一 接收预处理 → 阶段二 装配背景 → 阶段三 分诊把关 → 阶段四 五条处理路径 → 阶段五 确认落盘）" style="swimlane;startSize=38;rounded=1;arcSize=3;fillColor=#f8fafc;strokeColor=#2563eb;strokeWidth=2.2;fontSize=16;fontStyle=1;fontColor=#1e3a8a;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="540" y="200" width="4340" height="1940" as="geometry"/></mxCell>
        <mxCell id="t_idle_to_turn" value="收到微信消息
或 邮件汇总触发" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.42;exitDx=0;exitDy=0;entryX=0;entryY=0.12;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_idle" target="s_turn"><mxGeometry x="0.0" y="-24" relative="1" as="geometry"><Array as="points"><mxPoint x="460" y="432"/><mxPoint x="460" y="432"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_turn_to_idle" value="本轮抵达◉ / 回到待机，等待你的下一条回复（如回 1 确认、0 作废或改：…）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.14;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#475569;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_turn" target="s_idle"><mxGeometry x="-0.45" y="-16" relative="1" as="geometry"><Array as="points"><mxPoint x="1148" y="2178"/><mxPoint x="252" y="2178"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="lbl_s1" value="【阶段一｜接收与预处理】" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="570" y="250" width="440" height="26" as="geometry"/></mxCell>
        <mxCell id="turn_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="575" y="425" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="s1_intake" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:6px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;接收与预处理中&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;entry / 微信通道：验签、解密、单人白名单过滤；首条消息0.5秒内回「已收到」（发回执超时不丢消息）&lt;br/&gt;entry / 邮件通道：不回「已收到」，按名单过滤并加不可信隔离边界；解析/处理成功后再标已读防丢信&lt;br/&gt;do / 连续逐条转发停手 2 秒自动合并（发「好了」立即结束等待）&lt;br/&gt;do / 语音消息调用 qwen3-asr-flash 转文字（失败降级占位提示，不中断）&lt;br/&gt;do / 随附文件（PDF/Word/Excel/ZIP 等）前置按页提取入库并备份 OneDrive 收件箱（损坏或加密文件优雅占位）&lt;br/&gt;exit / 汇总为统一文本与已入库附件清单&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="635" y="290" width="430" height="355" as="geometry"/></mxCell>
        <mxCell id="t_turn_init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.42;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="turn_init" target="s1_intake"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="lbl_s2" value="【阶段二｜装配上下文】" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1135" y="250" width="400" height="26" as="geometry"/></mxCell>
        <mxCell id="s2_ctx" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:6px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;装配上下文中&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 纯代码读取本地 SQLite 真值（0 次大模型调用，脏 JSON 自动容错）：&lt;br/&gt;  ① 跨天滚动摘要（只读历史）+ 近 30 轮对话（间隔超 30 分钟插入分割线防串话题）&lt;br/&gt;  ② 桌上的待确认卡片（标注距今分钟数与 60 分钟新鲜度窗口）&lt;br/&gt;  ③ 在途项目与未完待办快照（提到项目名时自动挂载项目卡）&lt;br/&gt;  ④ 历史档案与旧对话全文索引（仅路径③查档与路径④立卡时检索）&lt;br/&gt;exit / 拼出完整上下文背景（严格条数与字数截断，防撑爆模型窗口）&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1135" y="290" width="410" height="355" as="geometry"/></mxCell>
        <mxCell id="t_s1_s2" value="批次就绪" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1_intake" target="s2_ctx"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="lbl_s3" value="【阶段三｜意图分诊与老管家两道把关】" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1615" y="250" width="560" height="26" as="geometry"/></mxCell>
        <mxCell id="s3_router_box" value="复合状态：意图分诊（AI 小秘书先理解 + 老管家两道死规矩把关）" style="swimlane;startSize=34;rounded=1;arcSize=5;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#92400e;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1615" y="290" width="625" height="760" as="geometry"/></mxCell>
        <mxCell id="s3_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1645" y="352" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="s3_pre_ch" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1715" y="344" width="40" height="40" as="geometry"/></mxCell>
        <mxCell id="t_s3_init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3_init" target="s3_pre_ch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s3_ai" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#4c1d95;padding:6px 10px 6px 10px;border-bottom:1.5px solid #6d28d9;&quot;&gt;&lt;b&gt;1. AI 小秘书初步判断意图&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 调用 qwen3.8-flash（主备自动切换，最多重试 4 次）阅读上下文背景&lt;br/&gt;do / 听懂日常口语（「好的按这个办」「刚才那个审完了」）、补全「这个/刚才那事」指代并提炼查档关键词&lt;br/&gt;注 / 万一大模型断网故障，直接跳往下方「老板专属死暗号」保底通道&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1650" y="445" width="555" height="165" as="geometry"/></mxCell>
        <mxCell id="t_s3_pre_ai" value="[else：需理解上下文]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3_pre_ch" target="s3_ai"><mxGeometry x="-0.1" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_s3_pre_hi" value="[纯问候(你好/在吗) 且 无历史无待确认卡] / 直接回复问候" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=#475569;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3_pre_ch" target="s4_record"><mxGeometry x="0.42" y="-14" relative="1" as="geometry"><Array as="points"><mxPoint x="2265" y="364"/><mxPoint x="2265" y="278"/><mxPoint x="3875" y="278"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="s3_guard" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:6px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;2. 铁面老管家两道把关（纯代码，0 次模型）&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 【第一道·防闯祸安全锁（专拦小秘书瞎办事）】&lt;br/&gt;  • 桌上根本没有待确认卡，却判成要签字/存想法/作废 → 拦住改成「参谋聊天」，绝不碰库&lt;br/&gt;  • 小秘书自己把握不到五成半（没听清没听懂）→ 拦住不准瞎立项，改去「先问清楚」&lt;br/&gt;  • 纯 PMO 边界：系统已物理移除联网公网搜索与代算业务报价工具&lt;br/&gt;do / 【第二道·老板专属死暗号（含义唯一，一锤定音，最高优先级）】&lt;br/&gt;  • 整句只发「看板 / 负荷」→ 只看网页或日程，绝不改待办&lt;br/&gt;  • 整句只发「撤销 / 开始 3 / 完成 3」→ 必定改对应状态&lt;br/&gt;  • 桌上有卡时整句发「1 / 2 / 0 / 取消 / 改：…」→ 必定签字、存想法、作废或重排&lt;br/&gt;  （日常口语「好的」「做完了」含义随语境变化，不放死暗号表，仍交由小秘书结合上下文判断）&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1650" y="660" width="555" height="360" as="geometry"/></mxCell>
        <mxCell id="t_s3_ai_guard" value="给出初步判断 或 网关故障" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3_ai" target="s3_guard"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_s2_s3" value="背景就绪" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.23;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2_ctx" target="s3_router_box"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="ch_route" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="2310" y="818" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="t_s3_choice" value="最终裁决" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.72;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6d28d9;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#6d28d9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3_router_box" target="ch_route"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="lbl_s4" value="【阶段四｜五条受控处理路径（仅路径①通往阶段五改库）】" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="2560" y="252" width="760" height="26" as="geometry"/></mxCell>
        <mxCell id="s4_p1" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:6px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;路径①：执行确认、打卡与撤销指令&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 解析确认卡编号、作废指令、单条或一句话批量开始/完成打卡、或 24 小时撤销指令&lt;br/&gt;注 / 凡是「看板 / 负荷」只读查询，直接输出网页链接或近 3 日日程，不改待办&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2580" y="295" width="520" height="155" as="geometry"/></mxCell>
        <mxCell id="s4_p2" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#4c1d95;padding:6px 10px 6px 10px;border-bottom:1.5px solid #6d28d9;&quot;&gt;&lt;b&gt;路径②：参谋单轮对谈&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 调用 qwen3.8-max 结合上下文提供参谋意见（每条消息只回一次，绝不后台自聊死循环）&lt;br/&gt;注 / 绝不新建或修改任何正式待办；聊几轮完全由你决定&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2580" y="500" width="520" height="150" as="geometry"/></mxCell>
        <mxCell id="s4_p3" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#4c1d95;padding:6px 10px 6px 10px;border-bottom:1.5px solid #6d28d9;&quot;&gt;&lt;b&gt;路径③：闭卷查档与进度问答&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 检索本地历史文档（含本轮刚发并前置入库的新附件）、旧对话与在途项目待办&lt;br/&gt;do / 查无依据直接回复「未查到」（0 次模型）；有依据则调 qwen3.8-max 严格带页码出处作答&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2580" y="700" width="520" height="165" as="geometry"/></mxCell>
        <mxCell id="s4_p5" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:6px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;路径⑤：追问澄清与能力边界说明&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 说明本助理只做项目管理（不支持代发外部微信/邮件或订票），或礼貌追问项目名/具体事项&lt;br/&gt;注 / 0 次数据库写入，绝不强行乱建待办&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2580" y="915" width="520" height="145" as="geometry"/></mxCell>
        <mxCell id="s4_record" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:6px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;回复微信并记录本次对话&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;entry / 扫描输出文本，严防任何密钥或令牌泄漏&lt;br/&gt;do / 分片推送回复到你的个人微信（语音消息附带转写原文回显）&lt;br/&gt;do / 将你的原话与助理回复成对写入本地对话记录（供下次阶段二衔接上下文）&lt;br/&gt;exit / 若累计满 8 轮新对话，同步写入保底摘要并唤醒正交区 B 升级语义摘要&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3560" y="580" width="420" height="270" as="geometry"/></mxCell>
        <mxCell id="turn_fin_main" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="4080" y="698" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="t_rec_fin" value="本轮结束" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#475569;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s4_record" target="turn_fin_main"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="lbl_s5" value="【阶段五｜唯一能修改正式待办与看板的受控门禁】" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="4220" y="250" width="620" height="26" as="geometry"/></mxCell>
        <mxCell id="s5_commit" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#7c2d12;padding:6px 10px 6px 10px;border-bottom:1.5px solid #c2410c;&quot;&gt;&lt;b&gt;修改正式待办、项目与云端看板&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;entry / 对 AI 提案卡：现场签发并校验一次性 HMAC 人类确认令牌（无有效令牌物理拒写）&lt;br/&gt;do / 本地 SQLite 单事务原子落盘：写入项目与待办，同时留存 24 小时完整撤销快照&lt;br/&gt;do / 将临时附件正式归档至世纪互联 OneDrive 对应项目目录，并重绘 5 份 .md 清单看板&lt;br/&gt;do / 云端容错：若 OneDrive 瞬时网络波动，绝不回滚本地已落盘待办，如实告知稍后补刷&lt;br/&gt;exit / 脱敏推送执行结果到微信，并写入对话记录（Web 驾驶舱实时共享同一数据库）&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="4220" y="295" width="610" height="340" as="geometry"/></mxCell>
        <mxCell id="turn_fin_s5" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="4508" y="700" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="t_s5_fin" value="落盘并回复完毕" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#c2410c;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#c2410c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s5_commit" target="turn_fin_s5"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_r_p1" value="[确认/作废/打卡/撤销/看板/负荷]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6d28d9;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#6d28d9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ch_route" target="s4_p1"><mxGeometry x="0.18" y="-14" relative="1" as="geometry"><Array as="points"><mxPoint x="2334" y="372"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_r_p2" value="[探讨思路 或 无卡误触确认]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.75;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6d28d9;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#6d28d9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ch_route" target="s4_p2"><mxGeometry x="0.32" y="-14" relative="1" as="geometry"><Array as="points"><mxPoint x="2410" y="830"/><mxPoint x="2410" y="575"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_r_p3" value="[查文档 或 查进度]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6d28d9;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#6d28d9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ch_route" target="s4_p3"><mxGeometry x="0.25" y="-14" relative="1" as="geometry"><Array as="points"><mxPoint x="2470" y="842"/><mxPoint x="2470" y="782"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_r_p5" value="[把握不足五成半
或 超出职责]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.75;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6d28d9;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#6d28d9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ch_route" target="s4_p5"><mxGeometry x="0.55" y="-24" relative="1" as="geometry"><Array as="points"><mxPoint x="2430" y="854"/><mxPoint x="2430" y="987"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="ch_p1_write" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="3220" y="350" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="t_p1_ch" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#c2410c;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#c2410c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s4_p1" target="ch_p1_write"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_p1_s5" value="[确认/作废/打卡/撤销（需改数据）]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.23;entryDx=0;entryDy=0;strokeColor=#c2410c;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#c2410c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ch_p1_write" target="s5_commit"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_p1_ro" value="[else：看板 / 负荷（只读不改库）]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=#475569;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ch_p1_write" target="s4_record"><mxGeometry x="-0.05" y="-14" relative="1" as="geometry"><Array as="points"><mxPoint x="3242" y="480"/><mxPoint x="3665" y="480"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_p2_rec" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;strokeColor=#475569;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s4_p2" target="s4_record"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3340" y="575"/><mxPoint x="3340" y="648"/></Array></mxGeometry></mxCell>
        <mxCell id="t_p3_rec" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;strokeColor=#475569;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s4_p3" target="s4_record"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3340" y="782"/><mxPoint x="3340" y="728"/></Array></mxGeometry></mxCell>
        <mxCell id="t_p5_rec" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;strokeColor=#475569;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s4_p5" target="s4_record"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3340" y="987"/><mxPoint x="3340" y="810"/></Array></mxGeometry></mxCell>
        <mxCell id="s4_p4_box" value="路径④ 复合状态：项目管理立卡与派单排期（纯 PMO 纳管——把具体工作拆成卡片安排人做，绝不代干具体业务活）" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#5b21b6;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1615" y="1170" width="3215" height="920" as="geometry"/></mxCell>
        <mxCell id="t_r_p4" value="[else：具体工作事项、派人、转发、附件或修改卡片]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.223;entryY=0;entryDx=0;entryDy=0;strokeColor=#6d28d9;strokeWidth=3.0;fontSize=13;fontStyle=1;fontColor=#6d28d9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ch_route" target="s4_p4_box"><mxGeometry x="0.45" y="-14" relative="1" as="geometry"><Array as="points"><mxPoint x="2334" y="1170"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="p4_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1650" y="1425" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="p4_s1" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:6px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;1. 前置查证与排期密度体检&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 检索历史档案库与跨时段旧对话，找齐同项目上下文&lt;br/&gt;do / 查询未来 14 天每日已排事项数量与拥挤日期（单日 ≥5 项标为拥挤）&lt;br/&gt;注 / 随附原件已在阶段一完成提取入库与原件备份，此处不再重复&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1715" y="1295" width="420" height="290" as="geometry"/></mxCell>
        <mxCell id="p4_s2" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:6px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;2. 证据压缩整理&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 将检索到的长文档、旧对话与新附件截断浓缩为最多 12 张精简证据卡&lt;br/&gt;do / 附带未来 7 天排期密度摘要，防止长文本淹没主模型注意力&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2205" y="1320" width="350" height="220" as="geometry"/></mxCell>
        <mxCell id="p4_s3" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#4c1d95;padding:6px 10px 6px 10px;border-bottom:1.5px solid #6d28d9;&quot;&gt;&lt;b&gt;3. PMO 立卡与排期起草&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 调用 qwen3.8-max 拆解为标准项目管理动作：&lt;br/&gt;  • 归属项目与六大业务板块&lt;br/&gt;  • 区分本人亲办（责任人=本人）vs 委派同事/外部跟进（责任人=张工/王总等，入委派跟进清单）&lt;br/&gt;  • 调用排期密度与工作日推算工具确定起止验收日（自动避开拥挤日）&lt;br/&gt;do / 铁律：默认不猜个人净工时（0.0h），绝不代写调研报告或代算业务内容&lt;br/&gt;注 / 内部工具调用严格封顶 ≤5 轮，防工具循环&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2635" y="1270" width="500" height="320" as="geometry"/></mxCell>
        <mxCell id="p4_s4" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#4c1d95;padding:6px 10px 6px 10px;border-bottom:1.5px solid #6d28d9;&quot;&gt;&lt;b&gt;4. 双重独立把关审核&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 第一重（硬编码）：核对卡片里每个关键数字是否 100% 出自原文或工具事实；核对外部等待项不误填工时&lt;br/&gt;do / 第二重（异构模型 deepseek-v4-pro）：打破同源盲区，独立挑出漏项、想法混入紧急待办或拥挤排期未提醒等问题&lt;br/&gt;exit / 输出审核结论（是否通过 + 具体整改意见）&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3220" y="1285" width="470" height="290" as="geometry"/></mxCell>
        <mxCell id="p4_ch_ok" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="3775" y="1408" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="p4_s5" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#7c2d12;padding:6px 10px 6px 10px;border-bottom:1.5px solid #c2410c;&quot;&gt;&lt;b&gt;5. 暂存草稿卡并推送微信确认&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;entry / 将提案存入「待确认暂存表」（绝不改动正式待办与看板）&lt;br/&gt;entry / 卡片醒目打印：项目名、事项、责任人（本人/被委派人）、起止周期&lt;br/&gt;entry / 若满 2 轮重写仍有未消解审核疑点，显式印出「⚠️ 审计待人工复核点」提醒董事长裁决&lt;br/&gt;do / 扫描防密钥泄漏 → 推送确认卡到微信 → 记录本轮对话&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="4120" y="1280" width="540" height="300" as="geometry"/></mxCell>
        <mxCell id="p4_fin" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="4735" y="1413" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="t_p4_init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_init" target="p4_s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_p4_12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_s1" target="p4_s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_p4_23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_s2" target="p4_s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_p4_34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_s3" target="p4_s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_p4_4c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_s4" target="p4_ch_ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_p4_retry" value="[审核未通过 且 重写次数 &lt; 2] / 携带整改意见，重写次数+1（全图唯一有界回环）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#b91c1c;strokeWidth=2.6;fontSize=13;fontStyle=1;fontColor=#b91c1c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_ch_ok" target="p4_s3"><mxGeometry x="0.0" y="-16" relative="1" as="geometry"><Array as="points"><mxPoint x="3799" y="1730"/><mxPoint x="2885" y="1730"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_p4_pass" value="[else：审核通过 或 重写次数 &gt;= 2]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_ch_ok" target="p4_s5"><mxGeometry x="0.0" y="-16" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_p4_fin" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#c2410c;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#c2410c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4_s5" target="p4_fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p4_hitl_note" value="&lt;b&gt;人机签字闭环说明（为什么这里先抵达终止状态 ◉？）&lt;/b&gt;&lt;br/&gt;• 发出待确认卡后，本次处理立即结束（回到左侧「待机等待中」），AI 绝不擅自改你的正式待办。&lt;br/&gt;• 当你下一条微信回复「1 / 好的」→ 触发全新一次处理 → 经阶段三进入路径① → 阶段五验签落盘。&lt;br/&gt;• 当你回复「0 / 取消」→ 经路径①作废草稿卡；回复「改：交给李工，下周五截止」→ 携带原卡重走路径④。&lt;br/&gt;• 任何未预期系统异常均会被顶层捕获：先把你的原话记入对话库并主动告知，绝不静默崩溃或乱改数据。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=16;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;spacingRight=14;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="3990" y="1810" width="780" height="225" as="geometry"/></mxCell>
        <mxCell id="ortho_div_ab" value="" style="line;strokeWidth=2;dashed=1;dashPattern=8 6;strokeColor=#64748b;fillColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="42" y="2215" width="4876" height="10" as="geometry"/></mxCell>
        <mxCell id="reg_b_lbl" value="正交区域 B｜阶段六并发伴随机制（与主消息处理并行独立运行，通过虚线正交隔离，各自独立启停、互不阻塞）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="64" y="2236" width="1600" height="30" as="geometry"/></mxCell>
        <mxCell id="lbl_b1" value="并发子区 B1｜长耗时进度心跳监控（防假死焦虑）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="80" y="2280" width="500" height="24" as="geometry"/></mxCell>
        <mxCell id="b1_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="84" y="2425" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="b1_watch" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#064e3b;padding:6px 10px 6px 10px;border-bottom:1.5px solid #047857;&quot;&gt;&lt;b&gt;监控单次处理耗时&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 随单次处理启动异步计时器&lt;br/&gt;注 / 12 秒内处理完直接安静退出，零打扰&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="140" y="2345" width="410" height="185" as="geometry"/></mxCell>
        <mxCell id="b1_beat" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#064e3b;padding:6px 10px 6px 10px;border-bottom:1.5px solid #047857;&quot;&gt;&lt;b&gt;定期播报当前步骤&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 每次超时向微信推送「已用时 Xs：正在执行【当前步骤】」&lt;br/&gt;exit / 主流程结束或异常退出时，finally 强制销毁心跳协程&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="860" y="2345" width="470" height="185" as="geometry"/></mxCell>
        <mxCell id="t_b1_init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1_init" target="b1_watch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_b1_start" value="after(12秒) [仍在处理中] / 首次播报" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1_watch" target="b1_beat"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_b1_loop" value="after(25秒) [仍未结束] / 继续播报" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1_beat" target="b1_beat"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><Array as="points"><mxPoint x="1212" y="2595"/><mxPoint x="978" y="2595"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_b1_stop" value="单次处理结束 / 销毁计时器" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0;exitY=0.72;exitDx=0;exitDy=0;entryX=1;entryY=0.72;entryDx=0;entryDy=0;strokeColor=#475569;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1_beat" target="b1_watch"><mxGeometry x="0.0" y="16" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="ortho_div_b12" value="" style="line;strokeWidth=2;dashed=1;dashPattern=8 6;strokeColor=#94a3b8;fillColor=none;html=1;direction=south;" vertex="1" parent="1"><mxGeometry x="1420" y="2280" width="10" height="360" as="geometry"/></mxCell>
        <mxCell id="lbl_b2" value="并发子区 B2｜工作日定时早晚简报与邮件汇总" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1470" y="2280" width="820" height="24" as="geometry"/></mxCell>
        <mxCell id="b2_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1474" y="2425" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="b2_wait" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#064e3b;padding:6px 10px 6px 10px;border-bottom:1.5px solid #047857;&quot;&gt;&lt;b&gt;按时钟轮询等待唤醒&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 每 30 秒核对本地时钟（仅周一至周五运行）&lt;br/&gt;do / 推送成功后再记同日防重标，失败记日志不静默丢失&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1530" y="2340" width="440" height="200" as="geometry"/></mxCell>
        <mxCell id="b2_digest" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#064e3b;padding:6px 10px 6px 10px;border-bottom:1.5px solid #047857;&quot;&gt;&lt;b&gt;推送早间简报 / 18:00 晚间盘点&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 汇总今日在途、外部委派卡点与进度盘点列表，推送微信并写入对话库&lt;br/&gt;exit / 方便你直接回复「#3 做完了，#5 开始了」批量打卡&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2320" y="2315" width="580" height="130" as="geometry"/></mxCell>
        <mxCell id="b2_mail" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#064e3b;padding:6px 10px 6px 10px;border-bottom:1.5px solid #047857;&quot;&gt;&lt;b&gt;拉取白名单邮件汇总（只读）&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 08:30 补夜间与周末积压；09:00–21:00 每小时一次（夜间与周末不拉）&lt;br/&gt;do / 收件合成一张待确认卡触发正交区 A；发出的信同条列出；成功后再标已读&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2320" y="2475" width="580" height="145" as="geometry"/></mxCell>
        <mxCell id="t_b2_init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2_init" target="b2_wait"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_b2_dig" value="at(工作日 08:30 / 18:00)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2_wait" target="b2_digest"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><Array as="points"><mxPoint x="2120" y="2390"/><mxPoint x="2120" y="2380"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_b2_mail" value="at(工作日 08:30 及 09:00–21:00 整点) [有新邮件]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.78;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2_wait" target="b2_mail"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><Array as="points"><mxPoint x="2120" y="2496"/><mxPoint x="2120" y="2547"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_b2_dig_back" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#475569;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2_digest" target="b2_wait"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2610" y="2292"/><mxPoint x="1750" y="2292"/></Array></mxGeometry></mxCell>
        <mxCell id="t_b2_mail_back" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#475569;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2_mail" target="b2_wait"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2610" y="2642"/><mxPoint x="1750" y="2642"/></Array></mxGeometry></mxCell>
        <mxCell id="ortho_div_b23" value="" style="line;strokeWidth=2;dashed=1;dashPattern=8 6;strokeColor=#94a3b8;fillColor=none;html=1;direction=south;" vertex="1" parent="1"><mxGeometry x="2970" y="2280" width="10" height="360" as="geometry"/></mxCell>
        <mxCell id="lbl_b3" value="并发子区 B3｜跨天滚动会话摘要后台升级（不阻塞主回复）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="3020" y="2280" width="900" height="24" as="geometry"/></mxCell>
        <mxCell id="b3_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="3024" y="2425" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="b3_idle" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#064e3b;padding:6px 10px 6px 10px;border-bottom:1.5px solid #047857;&quot;&gt;&lt;b&gt;空闲等待对话满 8 轮&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 监听新对话入库计数，未满 8 轮不耗模型&lt;br/&gt;note / 满 8 轮瞬间由主流程先同步写关键词保底摘要并推进游标（防并发重入）&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3080" y="2345" width="510" height="185" as="geometry"/></mxCell>
        <mxCell id="b3_run" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#4c1d95;padding:6px 10px 6px 10px;border-bottom:1.5px solid #6d28d9;&quot;&gt;&lt;b&gt;后台线程语义摘要升级&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.45;&quot;&gt;do / 调用 qwen3.8-flash 将上一版摘要与新增 8 轮对话合并为 ≤600 字中文要点&lt;br/&gt;do / 核对乐观锁（无更新版本抢先写入时）覆盖更新至数据库&lt;br/&gt;do / 若模型超时或失败：安全保留关键词保底摘要，绝不影响前台回复速度&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3980" y="2335" width="840" height="205" as="geometry"/></mxCell>
        <mxCell id="t_b3_init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b3_init" target="b3_idle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_b3_go" value="新增对话满 8 轮 / 启守护线程" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b3_idle" target="b3_run"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_b3_done" value="升级完成 或 异常保留保底摘要" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0;exitY=0.72;exitDx=0;exitDy=0;entryX=1;entryY=0.72;entryDx=0;entryDy=0;strokeColor=#475569;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b3_run" target="b3_idle"><mxGeometry x="0.0" y="16" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
