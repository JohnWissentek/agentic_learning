        <mxCell id="e_exec_od" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.775;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#dd6b20;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#dd6b20;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="exec" target="od"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_db_web" value="读取" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.225;entryY=0;entryDx=0;entryDy=0;strokeColor=#2f855a;strokeWidth=2.5;dashed=1;fontSize=13;fontStyle=1;fontColor=#2f855a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="db" target="web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_outer_loop" value="外层循环：你的下一条消息 / 下一次触发 → 回到开始（阶段二会读取上次存下的状态）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=3;dashed=1;fontSize=13;fontStyle=1;fontColor=#777777;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="card_next" target="start"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4350" y="2280"/><mxPoint x="18" y="2280"/><mxPoint x="18" y="230"/></Array></mxGeometry></mxCell>
        <mxCell id="z6" value="阶段六｜每日定时任务（独立运行，到点后从「开始」进入）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=2;dashed=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="2330" width="5020" height="450" as="geometry"/></mxCell>
        <mxCell id="timer" value="&lt;b&gt;定时器&lt;/b&gt;&lt;br/&gt;工作日 08:30 早报&lt;br/&gt;工作日 18:00 晚间复盘" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="120" y="2420" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="digest" value="&lt;b&gt;生成简报（代码）&lt;/b&gt;&lt;br/&gt;早报：今日在途事项、平均完成跨度、优先待办、外部卡点、驾驶舱链接&lt;br/&gt;18:00：额外列出「进行中 / 今日到期 / 已超期」事项，请你确认进度&lt;br/&gt;简报同时写入对话记录，方便你直接回复" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="600" y="2400" width="900" height="180" as="geometry"/></mxCell>
        <mxCell id="digest_out" value="&lt;b&gt;推送到微信&lt;/b&gt;&lt;br/&gt;你回复「#3 做完了，#5 开始了」→ 作为下一条消息走路径①" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.07;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1600" y="2430" width="560" height="120" as="geometry"/></mxCell>
        <mxCell id="mail_job" value="&lt;b&gt;邮件汇总（工作日）&lt;/b&gt;&lt;br/&gt;08:30 推出夜间与周末积压&lt;br/&gt;09:00–21:00 有新邮件才推一条&lt;br/&gt;夜间与周末不拉取、不推送&lt;br/&gt;收件合成一张确认卡；发出的信只记在同一条里&lt;br/&gt;域名：config/mail_domains.json；有邮件才从「开始」进入" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="2280" y="2388" width="1080" height="200" as="geometry"/></mxCell>
        <mxCell id="sum_job" value="&lt;b&gt;滚动摘要（每 8 轮对话，后台运行，qwen3.8-flash）&lt;/b&gt;&lt;br/&gt;把上一版摘要与新对话合并成语义摘要：进行中项目、已定事项、待跟进人和日期&lt;br/&gt;失败时保留关键词摘要，不影响回复速度" style="shape=process;size=0.035;fillColor=#e1d5e7;strokeColor=#6b46c1;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=30;spacingRight=28;" vertex="1" parent="1"><mxGeometry x="3420" y="2418" width="1550" height="140" as="geometry"/></mxCell>
        <mxCell id="e_timer" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="timer" target="digest"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_digest" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#777777;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="digest" target="digest_out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
