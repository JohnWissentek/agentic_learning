        <mxCell id="title" value="董事长个人 AI 项目助理 v3.0 — OMG UML 2.5 行为状态机架构图（单脑旗舰 · Model-First 方案 A）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2200" height="44" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="严格遵循 OMG UML 2.5 状态机标准：实心黑圆●=入口，双圆◉=本轮终止，圆角框=状态（entry/do/exit），空心菱形◇=动态分流，实线箭头=触发事件 [监护条件] / 动作，虚线分隔=并发正交区" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="2500" height="30" as="geometry"/></mxCell>
        <mxCell id="lg_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="2600" y="34" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="lg_init_t" value="初始伪状态 ●" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2632" y="26" width="115" height="40" as="geometry"/></mxCell>
        <mxCell id="lg_fin" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="2755" y="32" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="lg_fin_t" value="终止状态 ◉" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2790" y="26" width="115" height="40" as="geometry"/></mxCell>
        <mxCell id="lg_ch" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="2912" y="30" width="32" height="32" as="geometry"/></mxCell>
        <mxCell id="lg_ch_t" value="选择伪状态 ◇" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2952" y="26" width="125" height="40" as="geometry"/></mxCell>
        <mxCell id="lg_code" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:6px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;确定性底盘状态&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.48;&quot;&gt;do / 0模型事实与安全&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3085" y="14" width="185" height="74" as="geometry"/></mxCell>
        <mxCell id="lg_llm" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#4c1d95;padding:6px 10px 6px 10px;border-bottom:1.5px solid #6d28d9;&quot;&gt;&lt;b&gt;唯一旗舰大脑&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.48;&quot;&gt;do / qwen3.8-max 推理&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3285" y="14" width="195" height="74" as="geometry"/></mxCell>
        <mxCell id="lg_commit" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#7c2d12;padding:6px 10px 6px 10px;border-bottom:1.5px solid #c2410c;&quot;&gt;&lt;b&gt;受控执行与落盘&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.48;&quot;&gt;entry / 校验人类令牌&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3495" y="14" width="185" height="74" as="geometry"/></mxCell>
        <mxCell id="lg_note" value="&lt;b&gt;v3.0 方案 A 核心原则：大脑全给旗舰模型，底盘只留 4 块硬铁板&lt;/b&gt;&lt;br/&gt;0 次小模型路由、0 次二审打架大模型；常规 5~8 秒直出；唯一有界回环受 [自纠次数 &amp;lt; 2] 严格封顶。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=16;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;spacingRight=14;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="3695" y="14" width="745" height="74" as="geometry"/></mxCell>
        <mxCell id="sys_root" value="董事长个人 AI 项目助理系统 v3.0（7×24 在线 · 含两个并发正交区域）" style="swimlane;startSize=40;rounded=1;arcSize=3;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2.5;fontSize=17;fontStyle=1;fontColor=#0f172a;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="4400" height="2090" as="geometry"/></mxCell>
        <mxCell id="reg_a_lbl" value="正交区域 A｜单次消息处理主状态机（极简 3 节点核心：上下文与事实供给 → 旗舰单脑综合决策 → 确定性执行与精简回复）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="64" y="160" width="1800" height="30" as="geometry"/></mxCell>
        <mxCell id="top_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="68" y="525" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="s_idle" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#0f172a;padding:6px 10px 6px 10px;border-bottom:1.5px solid #475569;&quot;&gt;&lt;b&gt;待机等待中&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.48;&quot;&gt;do / 监听个人微信回调与整点邮件汇总触发&lt;br/&gt;说明 / 上轮对话、待确认卡、在途任务与来源标签均安全保存在本地数据库&lt;br/&gt;注 / 本轮抵达◉即回到此处，绝不后台空转&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="124" y="415" width="250" height="250" as="geometry"/></mxCell>
        <mxCell id="t_top_init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="top_init" target="s_idle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_turn" value="复合状态：单次处理周期（3 节点核心流水线 · 兼顾 5~8 秒极速响应与 4 块硬安全底盘）" style="swimlane;startSize=38;rounded=1;arcSize=3;fillColor=#f8fafc;strokeColor=#2563eb;strokeWidth=2.2;fontSize=16;fontStyle=1;fontColor=#1e3a8a;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="520" y="200" width="3880" height="1450" as="geometry"/></mxCell>
        <mxCell id="t_idle_to_turn" value="收到微信消息
或 邮件整点汇总" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.22;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_idle" target="s_turn"><mxGeometry x="0.0" y="-24" relative="1" as="geometry"><Array as="points"><mxPoint x="445" y="528"/><mxPoint x="445" y="519"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_turn_to_idle" value="本轮抵达◉ / 回到待机，等待董事长下一条指令（或继续自然语言追问、一步改卡落盘）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#475569;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s_turn" target="s_idle"><mxGeometry x="-0.42" y="-16" relative="1" as="geometry"><Array as="points"><mxPoint x="1102" y="1682"/><mxPoint x="249" y="1682"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="lbl_n1" value="【节点 1｜接入安全、事实供给与上下文装配（纯确定性底盘）】" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="555" y="252" width="560" height="26" as="geometry"/></mxCell>
        <mxCell id="turn_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="560" y="508" width="28" height="28" as="geometry"/></mxCell>
        <mxCell id="n1_intake" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:6px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;上下文装配与事实供给中&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.48;&quot;&gt;entry / 微信通道：AES验签·单人白名单·0.5秒到达回执·2秒逐条合批·语音转文字&lt;br/&gt;entry / 邮件通道：域名名单过滤·抽取完整正文与发收抄送角色·可信与不可信内容物理分框&lt;br/&gt;do / 随附文件（PDF/Word/Excel/ZIP等）前置按页入库并备份云端收件箱（坏文件优雅占位）&lt;br/&gt;do / 生成显式上海时区《本周/下周日历锚点表》（昨天/今天周几/明天/本周一~日/下周一~日）&lt;br/&gt;do / 从本地真值库装配：跨天滚动摘要·近30轮真实对话（绝不混入原始邮件正文）·完整待确认卡·在途任务快照（1~7栏与来源标签）&lt;br/&gt;exit / 核查是否命中极简 0 模型单字应急按钮（仅限 1/2/0/撤销/看板/负荷，绝无自然语言正则）&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="620" y="295" width="540" height="470" as="geometry"/></mxCell>
        <mxCell id="t_turn_init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.48;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="turn_init" target="n1_intake"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="ch_intake" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1240" y="508" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="t_n1_ch" value="事实齐备" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n1_intake" target="ch_intake"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="lbl_n2" value="【节点 2｜旗舰单脑综合决策与 3 条客观底盘护栏（唯一大模型 · 0 次小模型路由 · 0 次二审大模型）】" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1450" y="252" width="1180" height="26" as="geometry"/></mxCell>
        <mxCell id="n2_brain_box" value="复合状态：旗舰单脑推理与客观护栏（全图唯一有界回环 · 上限 2 轮）" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=2.2;fontSize=15;fontStyle=1;fontColor=#5b21b6;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1450" y="295" width="1340" height="910" as="geometry"/></mxCell>
        <mxCell id="t_ch_brain" value="[else：所有自然语言、
改卡落盘、查档与邮件]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.26;entryDx=0;entryDy=0;strokeColor=#6d28d9;strokeWidth=2.8;fontSize=13;fontStyle=1;fontColor=#6d28d9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ch_intake" target="n2_brain_box"><mxGeometry x="0.0" y="-24" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="b_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1485" y="535" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="n2_llm" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#4c1d95;padding:6px 10px 6px 10px;border-bottom:1.5px solid #6d28d9;&quot;&gt;&lt;b&gt;1. 旗舰大脑思考与原生工具调用&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.48;&quot;&gt;do / 调用唯一旗舰主脑 qwen3.8-max（备选自动切换）一次性通读全部上下文与日历锚点表&lt;br/&gt;do / 按需自主调用 4 个确定性只读工具（上限 ≤4 轮）：&lt;br/&gt;  • 查历史文档与跨天旧对话  • 精确读原件页码&lt;br/&gt;  • 查未来 14 天排期密度    • 精确推算工作日日期&lt;br/&gt;do / 直接产出统一决策：新建/修改待确认卡、1 步改卡并确认落盘、一句复合改多条任务、闭卷带页码问答、或参谋回复&lt;br/&gt;do / 纯项目管理（PMO）定位：不编造数字、不泄露内部技术黑话、不代发外部消息&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1545" y="355" width="560" height="400" as="geometry"/></mxCell>
        <mxCell id="n2_guard" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:6px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;2. 客观底盘三线安检（纯代码，0 模型，仅提案模式）&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.48;&quot;&gt;do / ① 日期合法性：确认全部日期为真实公历且截止不早于开始（绝不误杀昨天/本周五推算）&lt;br/&gt;do / ② 显式邮件抄送通道锁：仅针对外部邮件抄送项，严禁把董事长填为负责人或实施人（绝不误伤微信交办）&lt;br/&gt;do / ③ 客观工时上限：防外部等待跨度误填为个人工时（彻底取消字面子串数字误杀）&lt;br/&gt;exit / 汇总客观报错清单（日常合法决策 0 报错直接一次通过）&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2180" y="385" width="450" height="330" as="geometry"/></mxCell>
        <mxCell id="ch_guard" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="2690" y="526" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="b_fin" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="2697" y="815" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="t_b_init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.48;entryDx=0;entryDy=0;strokeColor=#6d28d9;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#6d28d9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b_init" target="n2_llm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_llm_guard" value="产出统一决策 [仅提案模式]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6d28d9;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#6d28d9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n2_llm" target="n2_guard"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_guard_ch" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6d28d9;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#6d28d9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n2_guard" target="ch_guard"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_guard_retry" value="[触犯客观硬底线 且 自纠次数 &lt; 2] / 携客观报错反馈自纠，自纠次数+1（全图唯一有界回环）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#b91c1c;strokeWidth=2.6;fontSize=13;fontStyle=1;fontColor=#b91c1c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ch_guard" target="n2_llm"><mxGeometry x="0.15" y="-16" relative="1" as="geometry"><Array as="points"><mxPoint x="2766" y="550"/><mxPoint x="2766" y="1085"/><mxPoint x="1825" y="1085"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_guard_pass" value="[else：通过 或 自纠次数 &gt;= 2]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#6d28d9;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#6d28d9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ch_guard" target="b_fin"><mxGeometry x="-0.1" y="-14" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="n2_note" value="&lt;b&gt;为什么彻底删除旧版小模型路由与二审大模型？（方案 A 实证收益）&lt;/b&gt;&lt;br/&gt;• 彻底消灭多节点传话失真：不再出现“您明明补充了本周五，却被二审当成造假抹回待补齐”的内耗事故。&lt;br/&gt;• 支持任意自然中文与复合指令：例如「目标截止暂定本周五，之后确认落盘了」一步完成改卡与落盘；一句话同时改多条任务截止日、加 CEO 评价与打卡。&lt;br/&gt;• 耗时由 25~40 秒压降至 5~8 秒，同时单任务卡片自动隐藏重复长摘要与系统噪点，零英文代码黑话。" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=16;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;spacingRight=14;fontColor=#422006;" vertex="1" parent="1"><mxGeometry x="1545" y="815" width="980" height="175" as="geometry"/></mxCell>
        <mxCell id="lbl_n3" value="【节点 3｜受控执行、原子落盘与精简回复（唯一可改正式数据库与云端看板的受控出口）】" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="2955" y="252" width="1180" height="26" as="geometry"/></mxCell>
        <mxCell id="n3_exec_box" value="复合状态：确定性执行与精简输出（4 块底盘收口：审批验签 · 原子落盘 · 来源打标 · 极简渲染）" style="swimlane;startSize=34;rounded=1;arcSize=4;fillColor=#fff7ed;strokeColor=#c2410c;strokeWidth=2.2;fontSize=15;fontStyle=1;fontColor=#9a3412;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="2955" y="295" width="1410" height="1295" as="geometry"/></mxCell>
        <mxCell id="t_ch_emergency" value="[命中 0 模型单字应急按钮：1 / 2 / 0 / 撤销 / 看板 / 负荷（大模型 503 断网照常秒回）]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;strokeColor=#c2410c;strokeWidth=2.6;fontSize=13;fontStyle=1;fontColor=#c2410c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ch_intake" target="n3_exec_box"><mxGeometry x="-0.12" y="-16" relative="1" as="geometry"><Array as="points"><mxPoint x="1264" y="1396"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_brain_exec" value="决策就绪" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.42;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#c2410c;strokeWidth=2.8;fontSize=13;fontStyle=1;fontColor=#c2410c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n2_brain_box" target="n3_exec_box"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="2988" y="672" width="26" height="26" as="geometry"/></mxCell>
        <mxCell id="ch_exec" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="3060" y="661" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="t_e_init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#c2410c;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#c2410c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e_init" target="ch_exec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_commit" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#7c2d12;padding:6px 10px 6px 10px;border-bottom:1.5px solid #c2410c;&quot;&gt;&lt;b&gt;A. 审批落盘正式任务库与云端看板&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.48;&quot;&gt;entry / 现场签发并校验一次性 HMAC 人类确认令牌（硬错未消解或无令牌物理拒写）&lt;br/&gt;do / 本地 SQLite 单事务原子写入任务/更新与 24 小时撤销快照&lt;br/&gt;do / 自动强打标来源（微信/邮件/驾驶舱）并自动回填 120 位邮件会话编号&lt;br/&gt;do / 同步归档附件并重绘世纪互联 OneDrive 5 份看板（云端波动绝不回滚本地）&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3360" y="355" width="650" height="255" as="geometry"/></mxCell>
        <mxCell id="e_direct" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#7c2d12;padding:6px 10px 6px 10px;border-bottom:1.5px solid #c2410c;&quot;&gt;&lt;b&gt;B. 复合直接更新已有任务或 24h 撤销&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.48;&quot;&gt;do / 单轮一次性执行任意组合：改截止日/实施人/负责人/阶段/卡点、追加 CEO 评价/备注/进展、批量开始/完成打卡、查沟通时间轴、或 24 小时一键撤销&lt;br/&gt;do / 实时同步刷新云端 OneDrive 看板与 Web 驾驶舱（共享同一数据库）&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3360" y="650" width="650" height="225" as="geometry"/></mxCell>
        <mxCell id="e_preview" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:6px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;C. 暂存草稿并推送极简确认卡&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.48;&quot;&gt;entry / 仅存入「待确认暂存表」（绝不改动正式待办与看板）&lt;br/&gt;do / 极简模板排版：单任务卡自动隐藏冗余长摘要、过滤无意义系统出处、零技术黑话&lt;br/&gt;do / 若满 2 轮仍有客观硬错未消解，显式印出「⚠️ 审计待人工复核点」交由董事长裁决&lt;br/&gt;注 / 董事长下一句说「1」或「截止改周五直接落盘」即可进入分支 A&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3360" y="915" width="650" height="255" as="geometry"/></mxCell>
        <mxCell id="e_reply" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:6px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;D. 纯知会、闭卷问答或只读查询回复&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.48;&quot;&gt;do / 纯知会邮件免建阻塞卡片；查档带页码出处；看板/负荷只读不改库&lt;br/&gt;do / 若 1 步落盘触发客观硬错，物理拦截落盘并明确提示修正点&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3360" y="1210" width="650" height="180" as="geometry"/></mxCell>
        <mxCell id="e_out" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#1e3a8a;padding:6px 10px 6px 10px;border-bottom:1.5px solid #1d4ed8;&quot;&gt;&lt;b&gt;脱敏推送并记入对话&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.48;&quot;&gt;entry / 扫描防密钥泄漏&lt;br/&gt;do / 分片推送个人微信&lt;br/&gt;do / 记录本轮真实对话（外部原始邮件正文绝不污染对话流）&lt;br/&gt;exit / 满 8 轮触发正交区 B 滚动摘要&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="4085" y="695" width="250" height="320" as="geometry"/></mxCell>
        <mxCell id="turn_fin" value="" style="ellipse;html=1;shape=endState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="4193" y="1085" width="34" height="34" as="geometry"/></mxCell>
        <mxCell id="t_ex_a" value="[确认待确认卡 或
1步改卡并落盘(0硬错)]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#c2410c;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#c2410c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ch_exec" target="e_commit"><mxGeometry x="0.22" y="-24" relative="1" as="geometry"><Array as="points"><mxPoint x="3084" y="482"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_ex_b" value="[复合改已有任务/
追评/打卡/撤销]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;strokeColor=#c2410c;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#c2410c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ch_exec" target="e_direct"><mxGeometry x="0.25" y="-24" relative="1" as="geometry"><Array as="points"><mxPoint x="3215" y="685"/><mxPoint x="3215" y="751"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_ex_c" value="[需确认的新建/改卡
待确认提案]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.75;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ch_exec" target="e_preview"><mxGeometry x="0.45" y="-24" relative="1" as="geometry"><Array as="points"><mxPoint x="3155" y="697"/><mxPoint x="3155" y="1042"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_ex_d" value="[else：纯知会/问答/
看板负荷/硬错拦截]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#475569;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ch_exec" target="e_reply"><mxGeometry x="0.42" y="-24" relative="1" as="geometry"><Array as="points"><mxPoint x="3084" y="1300"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_a_out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#c2410c;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#c2410c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e_commit" target="e_out"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4210" y="482"/></Array></mxGeometry></mxCell>
        <mxCell id="t_b_out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;strokeColor=#c2410c;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#c2410c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e_direct" target="e_out"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4045" y="762"/><mxPoint x="4045" y="775"/></Array></mxGeometry></mxCell>
        <mxCell id="t_c_out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#1e40af;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e_preview" target="e_out"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4045" y="1042"/><mxPoint x="4045" y="935"/></Array></mxGeometry></mxCell>
        <mxCell id="t_d_out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;strokeColor=#475569;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e_reply" target="e_out"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4148" y="1300"/></Array></mxGeometry></mxCell>
        <mxCell id="t_out_fin" value="本轮结束" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#475569;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e_out" target="turn_fin"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="ortho_div_ab" value="" style="line;strokeWidth=2;dashed=1;dashPattern=8 6;strokeColor=#64748b;fillColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="42" y="1720" width="4396" height="10" as="geometry"/></mxCell>
        <mxCell id="reg_b_lbl" value="正交区域 B｜后台并发伴随机制（与主消息处理并行独立运行，通过虚线正交隔离，互不阻塞）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="64" y="1742" width="1900" height="30" as="geometry"/></mxCell>
        <mxCell id="lbl_b1" value="并发子区 B1｜长耗时进度心跳监控（防假死）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="80" y="1785" width="520" height="24" as="geometry"/></mxCell>
        <mxCell id="b1_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="84" y="1930" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="b1_watch" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#064e3b;padding:6px 10px 6px 10px;border-bottom:1.5px solid #047857;&quot;&gt;&lt;b&gt;监控单次处理耗时&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.48;&quot;&gt;do / 随单次处理启动异步计时器&lt;br/&gt;注 / v3.0 常规 5~8 秒直出，12 秒内安静退出零打扰&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="136" y="1848" width="370" height="185" as="geometry"/></mxCell>
        <mxCell id="b1_beat" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#064e3b;padding:6px 10px 6px 10px;border-bottom:1.5px solid #047857;&quot;&gt;&lt;b&gt;定期播报当前进度&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.48;&quot;&gt;do / 每次超时向微信播报「已用时 Xs：正在执行【1~3 阶段】」&lt;br/&gt;exit / 主流程结束或异常退出时立即销毁计时器&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="1848" width="460" height="185" as="geometry"/></mxCell>
        <mxCell id="t_b1_init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1_init" target="b1_watch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_b1_start" value="after(12秒) [仍处理中]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1_watch" target="b1_beat"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_b1_loop" value="after(25秒) [仍未结束]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1_beat" target="b1_beat"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><Array as="points"><mxPoint x="1135" y="2105"/><mxPoint x="905" y="2105"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_b1_stop" value="单次处理结束 / 销毁" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0;exitY=0.72;exitDx=0;exitDy=0;entryX=1;entryY=0.72;entryDx=0;entryDy=0;strokeColor=#475569;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b1_beat" target="b1_watch"><mxGeometry x="0.0" y="16" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
