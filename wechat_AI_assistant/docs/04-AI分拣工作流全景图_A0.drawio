<mxfile host="app.diagrams.net" modified="2026-11-18T17:05:00.000Z" agent="Antigravity" version="24.7.17">
  <diagram id="agent-workflow-a0" name="AI工作助理完整工作流全景图_超宽无遮挡版">
    <mxGraphModel dx="2800" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5600" pageHeight="3600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="董事长 AI 私人幕僚 — 智能体五阶段全链路工作流、硬编码 vs 大模型边界与上下文装配（超宽无遮挡全景图）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="24" width="2400" height="44" as="geometry"/></mxCell>
        <mxCell id="leg1" value="&lt;b&gt;节点色：硬编码确定性机制&lt;/b&gt;&lt;br/&gt;纯 Python/正则/SQL/API，0 次大模型" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="2540" y="16" width="360" height="78" as="geometry"/></mxCell>
        <mxCell id="leg2" value="&lt;b&gt;节点色：大语言模型（LLM）&lt;/b&gt;&lt;br/&gt;标明模型档位、Prompt 与 Pydantic 契约" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#6b46c1;strokeWidth=2.5;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="2930" y="16" width="360" height="78" as="geometry"/></mxCell>
        <mxCell id="leg3" value="&lt;b&gt;节点色：上下文 &amp;amp; 存储底座&lt;/b&gt;&lt;br/&gt;SQLite 记忆 / FTS5 / 21Vianet" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2f855a;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="3320" y="16" width="360" height="78" as="geometry"/></mxCell>
        <mxCell id="leg4" value="&lt;b&gt;节点色：护栏 / 确认 / 审计&lt;/b&gt;&lt;br/&gt;白名单 / 令牌门禁 / HITL / Critic" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#dd6b20;strokeWidth=2.5;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="3710" y="16" width="360" height="78" as="geometry"/></mxCell>
        <mxCell id="leg_edges" value="&lt;b&gt;连线颜色图例（所有连线走专用空白走廊，绝不穿过卡片）&lt;/b&gt;&lt;br/&gt;蓝实线=主业务与数据流 ｜ 绿虚线=上下文装配/真值读取流 ｜ 紫实线=LLM路由与草案流 ｜ 红虚线=Critic驳回反思 ｜ 橙实线/虚线=确认放行 &amp;amp; 18:00盘点回流" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c757d;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=8;spacingTop=12;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="4100" y="16" width="1400" height="78" as="geometry"/></mxCell>
        <mxCell id="z1" value="阶段一｜多入口接入、附件解析与快捷指令前哨（硬编码通道）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=2;dashed=1;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacing=12;spacingTop=14;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="880" height="2940" as="geometry"/></mxCell>
        <mxCell id="n_wx_app" value="&lt;b&gt;1A. 个人微信主力入口（个人幕僚室 → AI工作助理）&lt;/b&gt;&lt;br/&gt;• 接口：FastAPI POST /api/wecom/app/callback（wecom_gateway.py）&lt;br/&gt;• 硬编码机制：AES-256-CBC 验签解密 → XML 解析 → &amp;lt;0.5s 异步到达回执&lt;br/&gt;• 自动合并多条转发：停手等 2 秒即自动打包为同一件事处理（不必输「好了」，想跳过等待时可选发「好了」）&lt;br/&gt;• 语音处理：拉取 AMR/SILK 临时媒体 → 调用 qwen3-asr-flash 转写原文" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="180" y="220" width="660" height="240" as="geometry"/></mxCell>
        <mxCell id="n_wx_kf" value="&lt;b&gt;1B. 备用客服通道（接收微信原生「合并转发」卡片）&lt;/b&gt;&lt;br/&gt;• 接口：POST /api/wecom/kf/callback → sync_msg() 增量拉取&lt;br/&gt;• 硬编码门禁：owner_external_userid 单人白名单校验（非本人直接丢弃）&lt;br/&gt;• 硬编码解析：递归展开 merged_msg 聊天记录合并为结构化文本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="180" y="520" width="660" height="200" as="geometry"/></mxCell>
        <mxCell id="n_mail" value="&lt;b&gt;1C. 香港/国际版 Office 365 Outlook 只读增量器（mail_poller.py）&lt;/b&gt;&lt;br/&gt;• 端点：login.microsoftonline.com + graph.microsoft.com/v1.0（Mail.Read 只读）&lt;br/&gt;• 硬编码白名单：matches_mail_allowlist() 仅放行 V&amp;amp;F / Tera / B&amp;amp;D 往来邮件&lt;br/&gt;• 硬编码防注入：跳过退订/验证码噪音，正文包裹 [UNTRUSTED_EXTERNAL_DATA]&lt;br/&gt;• 去重：按 internetMessageId 写入 seen_external_ids 表，同一封邮件只分析一次（MSAL 令牌缓存，不阻塞事件循环）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="180" y="780" width="660" height="250" as="geometry"/></mxCell>
        <mxCell id="n_att" value="&lt;b&gt;1D. 多格式附件提取、兜底机制与原件备份（ingest_inputs）&lt;/b&gt;&lt;br/&gt;• 已支持硬编码解析：PDF（pypdf 按页）、Word（.docx）、Excel（.xlsx/.xlsm）、CSV/TSV/纯文本、以及 .zip 安全递归解压（防路径穿越/限30文件/50MB）&lt;br/&gt;• 硬编码处理不了的格式（.dwg CAD/加密PDF或加密包/扫描件/未知二进制）：&lt;br/&gt;  1) 拦截二进制乱码入库，仅存 [未解析附件+文件名+大小] 元信息占位；&lt;br/&gt;  2) 100% 保留原件传至 21Vianet OneDrive 00_原件收件箱/（永不丢原件）；&lt;br/&gt;  3) 靠你的附言/语音说明关联项目与待办，并在确认卡诚实提示未解析" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="180" y="1110" width="660" height="270" as="geometry"/></mxCell>
        <mxCell id="n_fast_guard" value="&lt;b&gt;1E. 零大模型快捷指令前哨（handle_incoming_turn）&lt;/b&gt;&lt;br/&gt;• 亚毫秒快捷指令（全部 0 次 LLM 调用，直连数据库或返回链接）：&lt;br/&gt;  - 看板 / 驾驶舱 → 返回固定驾驶舱链接（长期有效，首次微信 6 位码验证后本机 180 天免密直开）&lt;br/&gt;  - 负荷 / 待办 → 查询近 3 日日程排期分布与 Top 待办&lt;br/&gt;  - 撤销 → 24h 内 undo_last_commit() 原子回滚并重绘 OneDrive&lt;br/&gt;  - 开始 #N / 完成 #N [耗时] → 更新状态与 actual_span_days 并重绘&lt;br/&gt;• 整轮持有可重入锁（同一时刻只处理一条，心跳标签不串扰）；工作流异常时先写入原话再如实告知「未生成待办」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#dd6b20;strokeWidth=2.5;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="180" y="1460" width="660" height="340" as="geometry"/></mxCell>
        <mxCell id="z2" value="阶段二｜4 层多时段上下文装配引擎 ContextAssembler（硬编码确定性组装）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=2;dashed=1;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacing=12;spacingTop=14;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="1100" y="140" width="980" height="2940" as="geometry"/></mxCell>
        <mxCell id="ctx_l1" value="&lt;b&gt;Layer 1：跨天滚动摘要 + 近期对话流（episode_summaries + conversation_turns）&lt;/b&gt;&lt;br/&gt;• 滚动会话摘要（episode_summaries）：每 8 轮先写抽取式摘要（不阻塞回复），再由 qwen3.8-flash 后台合并为语义摘要（失败保留抽取式），&lt;br/&gt;  即使隔了多天或超出 30 轮原文窗口，依然自动置顶注入上下文&lt;br/&gt;• 近期对话流：按 thread_id=&amp;#x27;owner&amp;#x27; 取最近 30 轮（&amp;lt;=600字/轮）&lt;br/&gt;• 硬编码时间边界：间隔 &amp;gt; 30 分钟插跨时段分割线与谨慎区分警告；&lt;br/&gt;  从 &amp;lt;=60 分钟连续窗口提取最多 6 个 anchor_entities" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2f855a;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1200" y="220" width="780" height="330" as="geometry"/></mxCell>
        <mxCell id="ctx_l2" value="&lt;b&gt;Layer 2：待确认提案暂存卡（pending_proposals，防盲目入库）&lt;/b&gt;&lt;br/&gt;• 含义：AI 生成方案发到微信后，在你回复「1 确认」或「0 取消」前暂存的草案卡&lt;br/&gt;• 作用：让你在微信里不用死记编号，直接回「按这个办」「改成下周五」「为什么排明天」&lt;br/&gt;  时，AI 能看懂你针对的是哪张尚未落盘的卡片&lt;br/&gt;• 新鲜度判定：&amp;lt;=60 分钟视为当前连续讨论，&amp;gt;60 分钟防止误改昨天的旧卡片" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2f855a;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1200" y="600" width="780" height="310" as="geometry"/></mxCell>
        <mxCell id="ctx_l3" value="&lt;b&gt;Layer 3：工作区快照 + 跨项目自动挂载卡（projects + list_items + memory_rules）&lt;/b&gt;&lt;br/&gt;• 跨项目自动挂载（借鉴 IDE 工作区感知）：当输入或近期锚点提及项目名/别名时，&lt;br/&gt;  自动挂载最多 3 张【相关项目上下文卡】（板块、周期、最新进展与关联待办）&lt;br/&gt;• 高容量真值快照：projects(30) + 未完成 list_items(60) + memory_rules(20)&lt;br/&gt;• 原则：直接从数据库实时读取真值，严禁大模型凭记忆猜测项目编号与状态" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2f855a;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1200" y="960" width="780" height="320" as="geometry"/></mxCell>
        <mxCell id="ctx_l4" value="&lt;b&gt;Layer 4：FTS5 全文检索文档与历史对话（retrieve_long_horizon_evidence）&lt;/b&gt;&lt;br/&gt;• 触发对象：quick_qa_responder 与 react_investigator 节点&lt;br/&gt;• 检索词拼装（硬编码去重）：search_queries + anchor_entities + 中文3-4字滑窗词&lt;br/&gt;• 双路 FTS5 trigram 召回：&lt;br/&gt;  1) raw_sources / sources_fts 文档按页切片；&lt;br/&gt;  2) conversation_turns_fts 全文索引历史对话（自动回填存量 + LIKE 短词兜底）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2f855a;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1200" y="1340" width="780" height="320" as="geometry"/></mxCell>
        <mxCell id="ctx_render" value="&lt;b&gt;上下文拼装渲染与防幻觉原则（render_for_router &amp;amp; 节点拼装模板）&lt;/b&gt;&lt;br/&gt;• 路由器输入拼装顺序：[当前时间戳] → [跨天滚动会话摘要] → [相关项目上下文卡] → [近期对话流与时间间隔] → [待确认卡片] → [在途快照] → [用户输入]&lt;br/&gt;• 提案起草输入拼装：今天日期 → 跨天滚动摘要 → 相关项目卡 → 近期对话 → 在途快照 → 补全意图 → EvidenceCard[] → 工具事实 → 纠偏/整改要求&lt;br/&gt;• 四大核心原则：&lt;br/&gt;  1) 上下文预算隔离（适配 128K 大模型）：文档 &amp;lt;=1000字/条(top10)、历史对话 &amp;lt;=600字/条(top8)、附件 &amp;lt;=6000字，兼顾信息完整与防注意力稀释&lt;br/&gt;  2) 闭卷真值约束：所有数字、日期、页码与 #ID 只能引用拼装上下文或确定性工具返回，未查到必须坦诚拒绝&lt;br/&gt;  3) 跨天跨项目连续性：滚动摘要 + 30/60分钟窗口 + 项目上下文自动挂载 + FTS5 历史对话召回，确保隔天切换项目依然连贯&lt;br/&gt;  4) 安全隔离：外部邮件正文始终带 [UNTRUSTED_EXTERNAL_DATA] 标签包裹，不与系统规则混淆" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2f855a;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1200" y="1740" width="780" height="440" as="geometry"/></mxCell>
        <mxCell id="z3" value="阶段三｜智能意图路由与三条轻交互分支（checkpoints.db 断点持久化）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=2;dashed=1;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacing=12;spacingTop=14;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="2220" y="140" width="1140" height="2940" as="geometry"/></mxCell>
        <mxCell id="n_router" value="&lt;b&gt;2. guardrail_router（上下文感知路由：LLM #1 + 硬编码后置护栏）&lt;/b&gt;&lt;br/&gt;• 【调用 LLM（qwen3.8-flash，Prompt: FAST_ROUTER_PROMPT）干什么】：&lt;br/&gt;  结合 4 层装配上下文，识别用户意图分类、把「他/这个/刚才那事」补全为完整表述、提炼检索关键词、识别目标待办 #ID&lt;br/&gt;• 【输出什么（IntentRoute）】：intent（11选1，含第11类兜底 clarify_or_unsupported）+ resolved_intent_text + search_queries[] + target_item_id + needs_deep_research&lt;br/&gt;• 【硬编码处理什么 → 输出什么】：&lt;br/&gt;  1) 若无待确认卡片却判 confirm/discard，降级为 conversational_chat 防误操作；&lt;br/&gt;  2) 仅「工作交办」类且置信度 &amp;lt; 0.55 时转 clarify_or_unsupported 礼貌澄清（查询/打卡不受影响）；chitchat 交给 3B 回复；&lt;br/&gt;  3) 除非原文显式含「查一下/上网查/联网搜」，否则强置 needs_deep_research=False（禁止代做外部调研）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#6b46c1;strokeWidth=2.5;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="2360" y="220" width="860" height="350" as="geometry"/></mxCell>
        <mxCell id="n_shortcut" value="&lt;b&gt;3A. action_shortcut（纯硬编码执行，0 次 LLM 调用）&lt;/b&gt;&lt;br/&gt;• 【硬编码处理什么】：&lt;br/&gt;  1) confirm_pending / ideas_only_pending：调用 commit_pending_proposal() 签发令牌、写 SQLite 并上传 OneDrive；&lt;br/&gt;  2) discard_pending：作废 pending_proposals 最新草稿卡；undo：24h 内 undo_last_commit() 事务回滚；&lt;br/&gt;  3) mutate_existing_item：正则解析单个或多个 #ID（如「#1 做完了，#2 开始了」），分别调用 complete_item()（算跨度天数）或 start_item() 并重绘 5 份 .md 看板&lt;br/&gt;• 【输出什么】：直接返回微信结构化执行回执文本（如「✅ #1 已完成（跨度 3 天）」）+ 刷新后的云端看板" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="2360" y="640" width="860" height="370" as="geometry"/></mxCell>
        <mxCell id="n_chat" value="&lt;b&gt;3B. conversational_responder（多轮参谋对话，LLM #2）&lt;/b&gt;&lt;br/&gt;• 【调用 LLM（qwen3.8-flash，Prompt: CONVERSATIONAL_ADVISOR_PROMPT）干什么】：&lt;br/&gt;  接收跨天摘要、相关项目卡、近期对话流、待确认卡与工作区快照，围绕董事长当前思路做参谋分析或澄清讨论（不建新待办）&lt;br/&gt;• 【输出什么（ConversationalReply）】：连贯的中文参谋回复 reply；若还有悬而未决的待确认卡片，结尾顺带轻声提醒确认" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#6b46c1;strokeWidth=2.5;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="2360" y="1080" width="860" height="310" as="geometry"/></mxCell>
        <mxCell id="n_qa" value="&lt;b&gt;3C. quick_qa_responder（Ch.14 闭卷档案问答：硬编码检索 + LLM #3）&lt;/b&gt;&lt;br/&gt;• 【硬编码处理什么】：调用 retrieve_long_horizon_evidence() + 扫描 30 轮近期对话，捞出匹配的 FTS5 文档页、历史对话、待办与待确认卡拼成证据块（ev_blocks）；若无任何证据直接拦截返回“未查到”&lt;br/&gt;• 【调用 LLM（qwen3.8-flash，Prompt: QA_GROUNDED_PROMPT）干什么】：严格闭卷阅读上述证据块作答，禁止凭记忆编造数字或人名&lt;br/&gt;• 【输出什么（GroundedAnswer）】：带准确来源与页码的回答（如《Spec.pdf》第 4 页）+ citations[] + found_in_sources 布尔标记" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#6b46c1;strokeWidth=2.5;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="2360" y="1460" width="860" height="370" as="geometry"/></mxCell>
        <mxCell id="z4" value="阶段四｜work_triage 主干分拣、精算查证与异构反思闭环（核心大脑）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=2;dashed=1;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacing=12;spacingTop=14;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="3500" y="140" width="1020" height="2940" as="geometry"/></mxCell>
        <mxCell id="n_inv" value="&lt;b&gt;4. react_investigator（确定性工具前置查证，纯硬编码执行）&lt;/b&gt;&lt;br/&gt;• 调用 1：ingest_inputs() 落盘附件原文并按页提取文本&lt;br/&gt;• 调用 2：retrieve_long_horizon_evidence() 跨时段召回历史文件与旧对话（hybrid_search）&lt;br/&gt;• 调用 3：check_workload_and_schedule() 统计未来 14 天每日已排期事项数、P0 数与是否拥挤（&amp;gt;=5 项为拥挤），给出推荐起始日（不估工时）&lt;br/&gt;• 调用 4：若存在 &amp;gt;=2 张 Excel 报价表，自动执行 analyze_excel_quote()（openpyxl 逐行 Diff 与含税精算）&lt;br/&gt;• 调用 5（默认关闭）：仅当 needs_deep_research=True（用户显式要求上网查）时，执行脱敏 search_public_tech_intel()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="3590" y="220" width="820" height="340" as="geometry"/></mxCell>
        <mxCell id="n_comp" value="&lt;b&gt;5. context_compactor（Level 2 上下文工程压缩，纯硬编码）&lt;/b&gt;&lt;br/&gt;• 将原始文档命中列表、历史对话命中与本次附件浓缩为结构化 EvidenceCard[]（文档 &amp;lt;=1000字/条，对话 &amp;lt;=600字/条，附件 &amp;lt;=6000字，最多 12 张）&lt;br/&gt;• 将日程负载、Excel Diff、外部检索简报拼装为紧凑的 tool_outputs_text&lt;br/&gt;• 目的：避免超长原始 JSON 塞满主推理模型上下文导致指令遗忘或数字幻觉" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="3590" y="620" width="820" height="220" as="geometry"/></mxCell>
        <mxCell id="n_prod" value="&lt;b&gt;6. producer_drafter（董秘提案起草，LLM #4 + ReAct 工具调用）&lt;/b&gt;&lt;br/&gt;• LLM 调用：producer 档旗舰模型 qwen3.8-max（fallback: qwen-max），Prompt: PRODUCER_TRIAGE_PROMPT&lt;br/&gt;• 绑定沙箱工具（模型可自主调用）：check_workload_and_schedule、calc_business_date&lt;br/&gt;• 接收输入：当前日期 + 跨天摘要 + 相关项目卡 + 3层工作区上下文 + EvidenceCard[] + tool_outputs_text + 纠偏/整改要求&lt;br/&gt;• 输出 Pydantic 契约：TriageProposal(headline, executive_summary, actions[], overload_warning, citations[], referenced_numbers[])&lt;br/&gt;• 业务铁律：不代做外部市场调研，只拆解行动/会议/干系人/待查资料；estimated_hours 默认 0.0，专注规划日历起止周期" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#6b46c1;strokeWidth=2.5;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="3590" y="900" width="820" height="390" as="geometry"/></mxCell>
        <mxCell id="n_crit" value="&lt;b&gt;7. heterogeneous_critic（双重审计门禁：硬编码规则核验 + 异构 LLM #5）&lt;/b&gt;&lt;br/&gt;• 第一重（硬编码确定性检查 deterministic_critic_check）：&lt;br/&gt;  - 数字保真检查：核验 proposal.referenced_numbers 是否真实存在于原文/证据/工具输出中&lt;br/&gt;  - 逻辑红线：若填了非零工时须有原话依据且不能把多天等待换算成几十小时；拦截把纯脑暴放进 P0 今日待办&lt;br/&gt;• 第二重（异构模型审计）：critic 档模型 deepseek-v4-pro（fallback: qwen3.8-max），Prompt: CRITIC_AUDIT_PROMPT&lt;br/&gt;• 输出契约：CriticVerdict(passed, numeric_fidelity_ok, schedule_reasonable, issues, fix_instructions)&lt;br/&gt;• 有界反思循环（Ch.4）：若 passed=False 且 loop_count &amp;lt; 2，回退 producer_drafter 带整改指示重做；达上限则带标注放行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#c53030;strokeWidth=2.5;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="3590" y="1360" width="820" height="420" as="geometry"/></mxCell>
        <mxCell id="n_gate" value="&lt;b&gt;8. hitl_preview_gate（Ch.13 人在回路人工确认挂起点，硬编码）&lt;/b&gt;&lt;br/&gt;• 生成待确认卡片：save_pending_proposal() 写入 SQLite pending_proposals 表（状态 pending）&lt;br/&gt;• 渲染高密度微信决策卡：format_decision_card() 展示 #卡片号、动作列表、P0/P1/P2、日历周期与跨度天数、证据出处&lt;br/&gt;• 附带固定驾驶舱链接并挂起等待董事长回复：&lt;br/&gt;  - 回复「1 / 好的 / 确认」→ 放行落盘 ｜ 回复「2」→ 仅存想法 ｜ 回复「改：...」→ 携带纠偏重走工作流" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#dd6b20;strokeWidth=2.5;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="3590" y="1850" width="820" height="330" as="geometry"/></mxCell>
        <mxCell id="z5" value="阶段五｜原子落盘、双云同步、Web 驾驶舱与每日主动闭环" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=2;dashed=1;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacing=12;spacingTop=14;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="4660" y="140" width="860" height="2940" as="geometry"/></mxCell>
        <mxCell id="n_exec" value="&lt;b&gt;9. atomic_executor（Ch.18 令牌门禁 + 原子持久化，纯硬编码）&lt;/b&gt;&lt;br/&gt;• 门禁校验：mint_approval_token() + before_tool_callback() HMAC 校验，无确认令牌物理拒绝任何写入&lt;br/&gt;• SQLite 事务：apply_proposal_atomic() 原子写入 list_items、projects、记录 24h undo_snapshot_json，并将卡片标为 confirmed&lt;br/&gt;• 21Vianet OneDrive 同步（microsoftgraph.chinacloudapi.cn）：&lt;br/&gt;  - 按 YYYYMMDD_&amp;lt;项目&amp;gt;_&amp;lt;文件名&amp;gt; 上传分类目录（&amp;gt;=4MB 分片断点续传）并清理 ECS 本地临时文件&lt;br/&gt;  - 追加 00_项目沟通与纪要.md&lt;br/&gt;  - 调用 render_lists_markdown() 自动重绘 5 份 .md 看板&lt;br/&gt;    (00_个人规则库 / 01_今日待办 / 02_项目总览 / 03_想法池 / 04_等待他人)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="4710" y="220" width="760" height="470" as="geometry"/></mxCell>
        <mxCell id="n_db" value="&lt;b&gt;10. 本地持久化与 21Vianet 私有云存储底座&lt;/b&gt;&lt;br/&gt;• data/checkpoints.db：LangGraph SqliteSaver 状态断点库（重启不丢上下文）&lt;br/&gt;• data/app.db（SQLite WAL + FTS5）：&lt;br/&gt;  - raw_sources + sources_fts（按页文本索引）&lt;br/&gt;  - conversation_turns + conversation_turns_fts + episode_summaries（全量对话与跨天滚动摘要）&lt;br/&gt;  - projects + list_items（planned_span_days / actual_span_days）&lt;br/&gt;  - memory_rules（episodic_case / procedural_rule / span_baseline）&lt;br/&gt;  - pending_proposals + model_calls + auth_tokens&lt;br/&gt;• Wissentek 世纪互联 OneDrive（Sites.Selected 锁定 chairman-vault 私有库）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2f855a;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="4710" y="760" width="760" height="470" as="geometry"/></mxCell>
        <mxCell id="n_web" value="&lt;b&gt;11. 同进程内嵌 Web 驾驶舱（Executive Work OS）&lt;/b&gt;&lt;br/&gt;• 挂载：FastAPI 127.0.0.1:8090 ← Nginx 443 HTTPS (assistant.fire-matrix.com)&lt;br/&gt;• 鉴权：固定访问链接 + 微信 6 位 OTP 验证后 180 天 HttpOnly Secure Cookie 长效免密&lt;br/&gt;• 实时进度心跳（run_turn_with_heartbeat）：处理超过 12 秒首次推送当前节点进度，此后每 25 秒汇报一次，防长任务静默假死&lt;br/&gt;• 四大视图（直连同一 app.db）：&lt;br/&gt;  1) Main Table（状态/优先级/起止日期/Span 跨度/一键转立项）&lt;br/&gt;  2) Gantt &amp;amp; Timeline（21 天滚动拖拽改期）&lt;br/&gt;  3) Schedule Load（7 天每日排期密度）&lt;br/&gt;  4) Analytics（平均完成跨度 Avg Span + 业务板块事项占比/完成进度）&lt;br/&gt;• 网页端任意修改实时写库并同步重绘 OneDrive 看板" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="4710" y="1300" width="760" height="420" as="geometry"/></mxCell>
        <mxCell id="n_digest" value="&lt;b&gt;12. 早晚简报与 18:00 主动进度盘点闭环（硬编码定时调度）&lt;/b&gt;&lt;br/&gt;• 早 08:30 简报（build_daily_digest_message）：推送今日在途事项、平均完成跨度、P0/P1/P2 优先待办、外部卡点与固定驾驶舱链接&lt;br/&gt;• 晚 18:00 主动盘点追问（解决“忘记打卡导致跨度失真”）：&lt;br/&gt;  - 自动筛出「进行中 / 今日到期 / 已超期」未完成事项生成【📝 今日进度盘点】清单&lt;br/&gt;  - 主动发微信请董事长一句话确认进度（如「#3 做完了，#5 开始了」）&lt;br/&gt;  - 自动写入 conversation_turns，确保后续自然语言回复无缝衔接&lt;br/&gt;• 闭环结果：complete_item() 自动计算 actual_span_days 并沉淀 span_baseline 至 memory_rules" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;spacingTop=14;spacingLeft=16;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="4710" y="1800" width="760" height="520" as="geometry"/></mxCell>
        <mxCell id="e1" value="语音转写/附件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.2;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_wx_app" target="n_att"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="340"/><mxPoint x="910" y="1164"/></Array></mxGeometry></mxCell>
        <mxCell id="e2" value="合并转发文本" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_wx_kf" target="n_att"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="620"/><mxPoint x="880" y="1245"/></Array></mxGeometry></mxCell>
        <mxCell id="e3" value="白名单命中邮件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_mail" target="n_att"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="预处理完成" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_att" target="n_fast_guard"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5" value="触发上下文装配" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1.0;exitY=0.65;exitDx=0;exitDy=0;entryX=0.0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_fast_guard" target="ctx_render"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="1681"/><mxPoint x="1020" y="1872"/></Array></mxGeometry></mxCell>
        <mxCell id="e5_top" value="进入路由主流程" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1.0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_fast_guard" target="n_router"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="1545"/><mxPoint x="1020" y="115"/><mxPoint x="2150" y="115"/><mxPoint x="2150" y="319"/></Array></mxGeometry></mxCell>
        <mxCell id="e_ctx1" value="滚动摘要+30轮对话" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.15;entryDx=0;entryDy=0;strokeColor=#2f855a;strokeWidth=2.5;dashed=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ctx_l1" target="ctx_render"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1135" y="385"/><mxPoint x="1135" y="1806"/></Array></mxGeometry></mxCell>
        <mxCell id="e_ctx2" value="待确认卡片" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.15;entryDx=0;entryDy=0;strokeColor=#2f855a;strokeWidth=2.5;dashed=1;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ctx_l2" target="ctx_render"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2035" y="755"/><mxPoint x="2035" y="1806"/></Array></mxGeometry></mxCell>
