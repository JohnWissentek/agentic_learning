        <mxCell id="lbl_b2" value="并发子区 B2｜工作日早晚简报与整点 Outlook 只读汇总" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1370" y="1785" width="920" height="24" as="geometry"/></mxCell>
        <mxCell id="b2_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1374" y="1930" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="b2_wait" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#064e3b;padding:6px 10px 6px 10px;border-bottom:1.5px solid #047857;&quot;&gt;&lt;b&gt;按时钟轮询等待唤醒&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.48;&quot;&gt;do / 每 30 秒核对本地时钟（仅周一至周五运行）&lt;br/&gt;do / 夜间与周末完全静默不打扰；推送成功后再记防重水位&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1425" y="1845" width="415" height="195" as="geometry"/></mxCell>
        <mxCell id="b2_digest" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#064e3b;padding:6px 10px 6px 10px;border-bottom:1.5px solid #047857;&quot;&gt;&lt;b&gt;推送早间简报 / 18:00 晚间盘点&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.48;&quot;&gt;do / 汇总今日在途（附微信/邮件/驾驶舱来源标）、临期与卡点，推送微信并记对话&lt;br/&gt;exit / 支持直接自然语言批量打卡或修改排期&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2180" y="1820" width="620" height="130" as="geometry"/></mxCell>
        <mxCell id="b2_mail" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#064e3b;padding:6px 10px 6px 10px;border-bottom:1.5px solid #047857;&quot;&gt;&lt;b&gt;拉取白名单邮件整点汇总（物理只读）&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.48;&quot;&gt;do / 08:30 补夜间周末积压；09:00–21:00 每小时一次；强制标来源=邮件&lt;br/&gt;do / 老会话自动绑定已有任务追加时间轴，新事合批触发正交区 A；上卡未回则延后不覆盖&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2180" y="1980" width="620" height="150" as="geometry"/></mxCell>
        <mxCell id="t_b2_init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2_init" target="b2_wait"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_b2_dig" value="at(工作日 08:30 / 18:00)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2_wait" target="b2_digest"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><Array as="points"><mxPoint x="2005" y="1893"/><mxPoint x="2005" y="1885"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_b2_mail" value="at(工作日 08:30 及 09–21 整点) [有新信]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.78;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2_wait" target="b2_mail"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><Array as="points"><mxPoint x="2005" y="1997"/><mxPoint x="2005" y="2055"/></Array><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_b2_dig_back" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#475569;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2_digest" target="b2_wait"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2490" y="1812"/><mxPoint x="1632" y="1812"/></Array></mxGeometry></mxCell>
        <mxCell id="t_b2_mail_back" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#475569;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b2_mail" target="b2_wait"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2490" y="2154"/><mxPoint x="1632" y="2154"/></Array></mxGeometry></mxCell>
        <mxCell id="ortho_div_b23" value="" style="line;strokeWidth=2;dashed=1;dashPattern=8 6;strokeColor=#94a3b8;fillColor=none;html=1;direction=south;" vertex="1" parent="1"><mxGeometry x="2870" y="1785" width="10" height="380" as="geometry"/></mxCell>
        <mxCell id="lbl_b3" value="并发子区 B3｜跨天滚动会话摘要后台升级（不阻塞主回复）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="2915" y="1785" width="920" height="24" as="geometry"/></mxCell>
        <mxCell id="b3_init" value="" style="ellipse;html=1;shape=startState;fillColor=#0f172a;strokeColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="2920" y="1930" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="b3_idle" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#064e3b;padding:6px 10px 6px 10px;border-bottom:1.5px solid #047857;&quot;&gt;&lt;b&gt;空闲等待对话满 8 轮&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.48;&quot;&gt;do / 监听真实对话入库计数，未满 8 轮不耗模型&lt;br/&gt;note / 满 8 轮瞬间由主流程先同步写保底摘要并推进游标&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#047857;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2972" y="1848" width="460" height="185" as="geometry"/></mxCell>
        <mxCell id="b3_run" value="&lt;div style=&quot;text-align:center;font-size:15px;color:#4c1d95;padding:6px 10px 6px 10px;border-bottom:1.5px solid #6d28d9;&quot;&gt;&lt;b&gt;后台线程语义摘要升级&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font-size:13px;color:#1e293b;padding:8px 12px 8px 12px;line-height:1.48;&quot;&gt;do / 调用轻量模型 qwen3.8-flash 合并为 ≤600 字中文要点（仅在后台运行，绝不参与主决策）&lt;br/&gt;do / 核对乐观锁覆盖更新至数据库；超时或失败安全保留关键词保底摘要&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#6d28d9;strokeWidth=2;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="3740" y="1838" width="650" height="205" as="geometry"/></mxCell>
        <mxCell id="t_b3_init" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b3_init" target="b3_idle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_b3_go" value="新增对话满 8 轮 / 启守护线程" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;strokeColor=#047857;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b3_idle" target="b3_run"><mxGeometry x="0.0" y="-14" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_b3_done" value="摘要升级完毕或降级保留" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;endSize=10;exitX=0;exitY=0.72;exitDx=0;exitDy=0;entryX=1;entryY=0.72;entryDx=0;entryDy=0;strokeColor=#475569;strokeWidth=2.2;fontSize=13;fontStyle=1;fontColor=#475569;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b3_run" target="b3_idle"><mxGeometry x="0.0" y="16" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
