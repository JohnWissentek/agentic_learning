<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Antigravity" version="24.7.17">
  <diagram id="six-stage-workflow" name="六阶段工作流全景图">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5100" pageHeight="2820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="董事长 AI 工作助理 — 六阶段工作流全景图" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="2300" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="每次处理从「开始」单向走到「本次结束」，每条路径都会记录对话；只有阶段五能改待办和看板（必须经你确认）；底部灰色虚线是外层循环" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="2300" height="30" as="geometry"/></mxCell>
        <mxCell id="lg_term" value="&lt;b&gt;开始&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2d3748;strokeColor=#1a202c;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2360" y="26" width="140" height="56" as="geometry"/></mxCell>
        <mxCell id="lg_code" value="&lt;b&gt;代码步骤&lt;/b&gt;&lt;br/&gt;确定性执行，不调用大模型" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="2520" y="18" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="lg_llm" value="&lt;b&gt;调用大模型&lt;/b&gt;&lt;br/&gt;标明模型与作用" style="shape=process;size=0.035;fillColor=#e1d5e7;strokeColor=#6b46c1;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=30;spacingRight=28;" vertex="1" parent="1"><mxGeometry x="2820" y="18" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="lg_dec" value="&lt;b&gt;判断&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b7950b;strokeWidth=2.5;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3120" y="14" width="190" height="78" as="geometry"/></mxCell>
        <mxCell id="lg_db" value="&lt;b&gt;数据存储&lt;/b&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2f855a;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3330" y="18" width="190" height="72" as="geometry"/></mxCell>
        <mxCell id="lg_io" value="&lt;b&gt;微信 / 邮件 收发&lt;/b&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.07;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3540" y="18" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="lg_lines" value="连线：蓝=主流程　紫=按意图分流　橙=执行落盘　红虚线=审核不通过重写　绿虚线=读取数据　灰虚线=回到微信 / 外层循环" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="3790" y="18" width="1270" height="72" as="geometry"/></mxCell>
        <mxCell id="z1" value="阶段一｜接收与预处理（硬编码；仅语音调用模型）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=2;dashed=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="690" height="2060" as="geometry"/></mxCell>
        <mxCell id="start" value="&lt;b&gt;开始：收到消息 / 到点触发&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2d3748;strokeColor=#1a202c;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="205" y="195" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="in_wx" value="&lt;b&gt;微信消息&lt;/b&gt;&lt;br/&gt;主入口 / 备用客服通道&lt;br/&gt;（含你对确认卡的回复）" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.07;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="in_mail" value="&lt;b&gt;邮件&lt;/b&gt;&lt;br/&gt;工作日 08:30 补夜间与周末&lt;br/&gt;09:00–21:00 每小时一次&lt;br/&gt;夜间与周末不拉" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.07;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="300" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="intake" value="&lt;b&gt;接入与预处理&lt;/b&gt;&lt;br/&gt;硬编码（不调用模型）：&lt;br/&gt;• 微信：验签、解密，0.5 秒回「已收到」&lt;br/&gt;• 连续转发停手 2 秒，合并成一件事&lt;br/&gt;• 邮件不回「已收到」；按 JSON 域名去重，正文加不可信标记&lt;br/&gt;• 收件合成一张确认卡；发出的信只记在同一条里&lt;br/&gt;• 附件按页提取文字；原件先备份到 OneDrive&lt;br/&gt;调用模型（只有这一处）：&lt;br/&gt;• 语音转文字：qwen3-asr-flash&lt;br/&gt;输出：一段统一的文本 + 附件" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="70" y="460" width="620" height="360" as="geometry"/></mxCell>
        <mxCell id="e_start_wx" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="start" target="in_wx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_start_mail" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="start" target="in_mail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_wx" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.24;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="in_wx" target="intake"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_mail" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.76;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="in_mail" target="intake"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_intake_ctx" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.12;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="intake" target="ctx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="z2" value="阶段二｜装配上下文（全部硬编码）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=2;dashed=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="790" y="130" width="540" height="2060" as="geometry"/></mxCell>
        <mxCell id="ctx_db" value="&lt;b&gt;SQLite 数据库&lt;/b&gt;&lt;br/&gt;对话记录 · 待确认卡 · 项目待办 · 文档索引" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2f855a;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="330" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="ctx" value="&lt;b&gt;装配 4 层上下文（全部硬编码）&lt;/b&gt;&lt;br/&gt;不调用模型。只读取数据库里已经写好的内容。&lt;br/&gt;滚动摘要是以前生成的，这里不重新生成。&lt;br/&gt;&lt;br/&gt;按固定顺序拼成提示词：&lt;br/&gt;&lt;br/&gt;1. 跨天滚动摘要 + 最近 30 轮对话&lt;br/&gt;　（间隔超 30 分钟会标注，防止串话题）&lt;br/&gt;&lt;br/&gt;2. 待确认卡片&lt;br/&gt;　（你还没回复确认的方案）&lt;br/&gt;&lt;br/&gt;3. 在途项目、待办快照&lt;br/&gt;　（提到项目名时自动附上项目卡）&lt;br/&gt;&lt;br/&gt;4. 历史文档与旧对话检索（数据库检索）&lt;br/&gt;　（查资料和工作交办时才检索）&lt;br/&gt;&lt;br/&gt;输出：一份完整的上下文提示词" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="820" y="600" width="480" height="620" as="geometry"/></mxCell>
        <mxCell id="e_ctx_read" value="读取" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2f855a;strokeWidth=2.5;dashed=1;fontSize=13;fontStyle=1;fontColor=#2f855a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ctx_db" target="ctx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="z3" value="阶段三｜判断意图（模型前、模型后都有硬编码）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=2;dashed=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="1390" y="130" width="600" height="2060" as="geometry"/></mxCell>
        <mxCell id="pre_router" value="&lt;b&gt;模型之前：两处硬编码&lt;/b&gt;&lt;br/&gt;不调用路由模型。&lt;br/&gt;• 整句是「你好 / 在吗 / hi / hello」&lt;br/&gt;　且没有历史、没有待确认卡&lt;br/&gt;　→ 直接回复问候&lt;br/&gt;• 状态里已经写好修改意见&lt;br/&gt;　→ 直接走路径④&lt;br/&gt;　你新发的「改：…」不走这里" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1410" y="190" width="400" height="250" as="geometry"/></mxCell>
        <mxCell id="router" value="&lt;b&gt;调用模型：判断意图&lt;/b&gt;&lt;br/&gt;qwen3.8-flash&lt;br/&gt;读阶段二拼好的上下文&lt;br/&gt;判断走哪条路&lt;br/&gt;补全「这个 / 刚才那事」" style="shape=process;size=0.035;fillColor=#e1d5e7;strokeColor=#6b46c1;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=30;spacingRight=28;" vertex="1" parent="1"><mxGeometry x="1410" y="800" width="280" height="190" as="geometry"/></mxCell>
        <mxCell id="which" value="&lt;b&gt;走哪条路？&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b7950b;strokeWidth=2.5;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1720" y="800" width="240" height="200" as="geometry"/></mxCell>
        <mxCell id="e_ctx_router" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ctx" target="router"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_router_which" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="router" target="which"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="brake_note" value="&lt;b&gt;模型之后①：三条刹车&lt;/b&gt;&lt;br/&gt;与整句词表无关。提示词写了同样的话，&lt;br/&gt;这里用代码拦住，不再调用模型。&lt;br/&gt;• 没有待确认卡，却要确认、&lt;br/&gt;　只存想法或作废 → 改成闲聊，不写库&lt;br/&gt;• 判成工作交办，置信度 &amp;lt; 0.55&lt;br/&gt;　→ 路径⑤，先问清楚，不建卡&lt;br/&gt;• 想联网，原话没有&lt;br/&gt;　「查一下 / 上网查 / 联网搜」→ 不联网" style="rounded=0;dashed=1;fillColor=#fffbe6;strokeColor=#b7950b;strokeWidth=1.5;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1410" y="1020" width="400" height="280" as="geometry"/></mxCell>
        <mxCell id="lexicon_note" value="&lt;b&gt;模型之后②：整句词表（最后执行）&lt;/b&gt;&lt;br/&gt;只锁整句完全一致的话，表不再加长。&lt;br/&gt;命中后改掉模型（以及刹车）的判断。&lt;br/&gt;「好的」「做完了」「改成下周五」&lt;br/&gt;不在表里，仍只听模型。&lt;br/&gt;会改数据，认错就改回：&lt;br/&gt;• 撤销&lt;br/&gt;• 开始 3 / 完成 3 / 完成 #3 2h&lt;br/&gt;• 有待确认卡时：1 / 确认&lt;br/&gt;• 2 / 仅存想法&lt;br/&gt;• 改：…&lt;br/&gt;只改回复，不改数据：&lt;br/&gt;• 看板 / 驾驶舱 / 页面 / dashboard&lt;br/&gt;• 负荷 / 待办 / 今日待办 / todo" style="rounded=0;dashed=1;fillColor=#fffbe6;strokeColor=#b7950b;strokeWidth=1.5;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1410" y="1320" width="400" height="520" as="geometry"/></mxCell>
        <mxCell id="z4" value="阶段四｜五条处理路径" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=2;dashed=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="2050" y="130" width="2480" height="2060" as="geometry"/></mxCell>
        <mxCell id="p1" value="&lt;b&gt;① 直接执行（代码）&lt;/b&gt;&lt;br/&gt;阶段三认定之后才执行：&lt;br/&gt;确认、作废、开始/完成、撤销 → 阶段五&lt;br/&gt;看板、负荷 → 只回复，不改待办" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="2120" y="245" width="600" height="170" as="geometry"/></mxCell>
        <mxCell id="p2" value="&lt;b&gt;② 参谋回复（qwen3.8-flash）&lt;/b&gt;&lt;br/&gt;每条消息回复一次，不建待办&lt;br/&gt;聊几轮由你决定" style="shape=process;size=0.035;fillColor=#e1d5e7;strokeColor=#6b46c1;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=30;spacingRight=28;" vertex="1" parent="1"><mxGeometry x="2120" y="535" width="600" height="170" as="geometry"/></mxCell>
        <mxCell id="p3" value="&lt;b&gt;③ 查档问答（代码检索 + qwen3.8-flash）&lt;/b&gt;&lt;br/&gt;先查文档和旧对话，再只依据查到的内容回答&lt;br/&gt;必须带出处页码；查不到就说查不到" style="shape=process;size=0.035;fillColor=#e1d5e7;strokeColor=#6b46c1;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=30;spacingRight=28;" vertex="1" parent="1"><mxGeometry x="2120" y="825" width="600" height="170" as="geometry"/></mxCell>
        <mxCell id="p5" value="&lt;b&gt;⑤ 请你澄清（代码）&lt;/b&gt;&lt;br/&gt;说明能力边界，或追问一个关键细节&lt;br/&gt;不建待办" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="2120" y="1115" width="600" height="170" as="geometry"/></mxCell>
        <mxCell id="p2_out" value="&lt;b&gt;回复发到微信&lt;/b&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.07;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2800" y="570" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="e_p2_out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#777777;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="p2_out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p3_out" value="&lt;b&gt;回复发到微信&lt;/b&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.07;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2800" y="860" width="250" height="100" as="geometry"/></mxCell>
