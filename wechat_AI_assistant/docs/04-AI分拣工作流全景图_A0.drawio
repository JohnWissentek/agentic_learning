        <mxCell id="e_r1" value="确认/作废卡片 · 打卡 · 撤销" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6b46c1;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#6b46c1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="which" target="p1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1840" y="330"/></Array></mxGeometry></mxCell>
        <mxCell id="e_r2" value="闲聊 · 讨论 · 问建议" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.75;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6b46c1;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#6b46c1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="which" target="p2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2010" y="860"/><mxPoint x="2010" y="620"/></Array></mxGeometry></mxCell>
        <mxCell id="e_r3" value="查文档 · 查进度" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6b46c1;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#6b46c1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="which" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_r5" value="太模糊 · 做不了" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.75;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6b46c1;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#6b46c1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="which" target="p5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2020" y="960"/><mxPoint x="2020" y="1200"/></Array></mxGeometry></mxCell>
        <mxCell id="e_r4" value="交办工作 · 转发 · 附件 · 改卡片" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6b46c1;strokeWidth=3;fontSize=13;fontStyle=1;fontColor=#6b46c1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="which" target="t1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1840" y="1590"/></Array></mxGeometry></mxCell>
        <mxCell id="hb_note" value="&lt;b&gt;进度心跳&lt;/b&gt;&lt;br/&gt;任何一条路径处理超过 12 秒，就向微信推送当前在做哪一步，此后每 25 秒一次，直到出结果" style="rounded=0;dashed=1;fillColor=#fffbe6;strokeColor=#b7950b;strokeWidth=1.5;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="3220" y="560" width="1240" height="120" as="geometry"/></mxCell>
        <mxCell id="p4_label" value="④ 工作交办（最长的一条路径，按顺序执行）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#6b46c1;" vertex="1" parent="1"><mxGeometry x="2120" y="1420" width="1500" height="40" as="geometry"/></mxCell>
        <mxCell id="t1" value="&lt;b&gt;1 查证（代码）&lt;/b&gt;&lt;br/&gt;查历史文档和旧对话&lt;br/&gt;查未来 14 天每日排期密度&lt;br/&gt;两版 Excel 报价自动逐行比对" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="2120" y="1490" width="400" height="200" as="geometry"/></mxCell>
        <mxCell id="t2" value="&lt;b&gt;2 压缩（代码）&lt;/b&gt;&lt;br/&gt;把查到的长材料截成精简证据卡，避免模型被长文本淹没" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="2590" y="1490" width="330" height="200" as="geometry"/></mxCell>
        <mxCell id="t3" value="&lt;b&gt;3 起草方案（qwen3.8-max）&lt;/b&gt;&lt;br/&gt;拆出做什么、谁负责、起止日期、所属项目&lt;br/&gt;可自己调用排期和工作日推算工具&lt;br/&gt;不估工时，不代做外部调研" style="shape=process;size=0.035;fillColor=#e1d5e7;strokeColor=#6b46c1;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=30;spacingRight=28;" vertex="1" parent="1"><mxGeometry x="2990" y="1490" width="420" height="200" as="geometry"/></mxCell>
        <mxCell id="t4" value="&lt;b&gt;4 审核（代码 + deepseek-v4-pro）&lt;/b&gt;&lt;br/&gt;代码核对数字是否都有出处&lt;br/&gt;另一个模型挑漏项和逻辑错误" style="shape=process;size=0.035;fillColor=#e1d5e7;strokeColor=#6b46c1;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=30;spacingRight=28;" vertex="1" parent="1"><mxGeometry x="3480" y="1490" width="400" height="200" as="geometry"/></mxCell>
        <mxCell id="t4_ok" value="&lt;b&gt;通过？&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b7950b;strokeWidth=2.5;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3940" y="1500" width="200" height="180" as="geometry"/></mxCell>
        <mxCell id="card" value="&lt;b&gt;5 出卡：存待确认卡，发到微信&lt;/b&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.07;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#dd6b20;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="4200" y="1540" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="card_next" value="&lt;b&gt;本次结束：等你回复&lt;/b&gt;&lt;br/&gt;回「1 / 好的」→ 路径① 执行&lt;br/&gt;回「改：…」→ 回到本路径重新起草" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.07;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="4200" y="1800" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="e_t12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_t23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_t34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t3" target="t4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_t4ok" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t4" target="t4_ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_fail" value="否：带修改意见重写（最多 2 次）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#c53030;strokeWidth=2.5;dashed=1;fontSize=13;fontStyle=1;fontColor=#c53030;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t4_ok" target="t3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4040" y="1780"/><mxPoint x="3200" y="1780"/></Array></mxGeometry></mxCell>
        <mxCell id="e_pass" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t4_ok" target="card"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_card_next" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=2.5;dashed=1;fontSize=13;fontStyle=1;fontColor=#777777;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="card" target="card_next"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="z5" value="阶段五｜你确认后执行落盘" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=2;dashed=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="4590" y="130" width="470" height="2060" as="geometry"/></mxCell>
        <mxCell id="exec" value="&lt;b&gt;执行落盘（代码）&lt;/b&gt;&lt;br/&gt;• 先校验确认令牌，没有令牌拒绝写入&lt;br/&gt;• 一次性写入待办与项目，留 24 小时撤销快照&lt;br/&gt;• 附件归档到 OneDrive 对应项目目录&lt;br/&gt;• 重绘 5 份 .md 看板&lt;br/&gt;• 回复执行结果到微信（本次结束）" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="4630" y="250" width="400" height="330" as="geometry"/></mxCell>
        <mxCell id="db" value="&lt;b&gt;SQLite&lt;/b&gt;&lt;br/&gt;待办 · 项目 · 对话" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2f855a;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="4630" y="680" width="180" height="170" as="geometry"/></mxCell>
        <mxCell id="od" value="&lt;b&gt;OneDrive&lt;/b&gt;&lt;br/&gt;原件 · 归档 · 5 份看板" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2f855a;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="4850" y="680" width="180" height="170" as="geometry"/></mxCell>
        <mxCell id="web" value="&lt;b&gt;Web 驾驶舱&lt;/b&gt;&lt;br/&gt;直接读同一个数据库&lt;br/&gt;表格 · 甘特图 · 排期密度 · 统计&lt;br/&gt;网页上的修改同样写库并重绘看板" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="4630" y="950" width="400" height="230" as="geometry"/></mxCell>
        <mxCell id="e_p1_exec" value="执行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.242;entryDx=0;entryDy=0;strokeColor=#dd6b20;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#dd6b20;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1" target="exec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_exec_db" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.225;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#dd6b20;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#dd6b20;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="exec" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_exec_od" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.775;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#dd6b20;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#dd6b20;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="exec" target="od"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_db_web" value="读取" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.225;entryY=0;entryDx=0;entryDy=0;strokeColor=#2f855a;strokeWidth=2.5;dashed=1;fontSize=13;fontStyle=1;fontColor=#2f855a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="db" target="web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_sc_exec" value="快捷指令：1/2、开始、完成、撤销" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;strokeColor=#dd6b20;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#dd6b20;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="shortcut" target="exec"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="2250"/><mxPoint x="4610" y="2250"/><mxPoint x="4610" y="530"/></Array></mxGeometry></mxCell>
        <mxCell id="e_outer_loop" value="外层循环：你的下一条消息 / 下一次触发 → 回到开始（阶段二会读取上次存下的状态）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=3;dashed=1;fontSize=13;fontStyle=1;fontColor=#777777;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="card_next" target="start"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5080" y="1875"/><mxPoint x="5080" y="112"/><mxPoint x="385" y="112"/></Array></mxGeometry></mxCell>
        <mxCell id="z6" value="阶段六｜每日定时任务（独立运行，到点或拉到邮件后从「开始」进入）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=2;dashed=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="2330" width="5020" height="450" as="geometry"/></mxCell>
        <mxCell id="timer" value="&lt;b&gt;定时器&lt;/b&gt;&lt;br/&gt;工作日 08:30 早报&lt;br/&gt;工作日 18:00 晚间复盘" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="120" y="2420" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="digest" value="&lt;b&gt;生成简报（代码）&lt;/b&gt;&lt;br/&gt;早报：今日在途事项、平均完成跨度、优先待办、外部卡点、驾驶舱链接&lt;br/&gt;18:00：额外列出「进行中 / 今日到期 / 已超期」事项，请你确认进度&lt;br/&gt;简报同时写入对话记录，方便你直接回复" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="600" y="2400" width="900" height="180" as="geometry"/></mxCell>
        <mxCell id="digest_out" value="&lt;b&gt;推送到微信&lt;/b&gt;&lt;br/&gt;你回复「#3 做完了，#5 开始了」→ 作为下一条消息走路径①" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.07;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1600" y="2430" width="560" height="120" as="geometry"/></mxCell>
        <mxCell id="mail_job" value="&lt;b&gt;邮件拉取（每 2 分钟）&lt;/b&gt;&lt;br/&gt;只拉白名单公司邮件，同一封只处理一次&lt;br/&gt;拉到后从「开始」进入，走一遍阶段一到五" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="2400" y="2420" width="900" height="140" as="geometry"/></mxCell>
        <mxCell id="sum_job" value="&lt;b&gt;滚动摘要（每 8 轮对话，后台运行，qwen3.8-flash）&lt;/b&gt;&lt;br/&gt;把上一版摘要与新对话合并成语义摘要：进行中项目、已定事项、待跟进人和日期&lt;br/&gt;失败时保留关键词摘要，不影响回复速度" style="shape=process;size=0.035;fillColor=#e1d5e7;strokeColor=#6b46c1;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=30;spacingRight=28;" vertex="1" parent="1"><mxGeometry x="3420" y="2420" width="1550" height="140" as="geometry"/></mxCell>
