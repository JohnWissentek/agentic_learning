<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Antigravity" version="24.7.17">
  <diagram id="six-stage-workflow" name="六阶段工作流全景图">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5100" pageHeight="2820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="董事长 AI 工作助理 — 六阶段工作流全景图" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="2300" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="每次处理从「开始」单向走到「本次结束」；外圈灰色虚线是靠数据库串起来的外层循环；阶段五只在你确认后（下一条消息）才发生" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="2300" height="30" as="geometry"/></mxCell>
        <mxCell id="lg_term" value="&lt;b&gt;开始&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2d3748;strokeColor=#1a202c;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2360" y="26" width="140" height="56" as="geometry"/></mxCell>
        <mxCell id="lg_code" value="&lt;b&gt;代码步骤&lt;/b&gt;&lt;br/&gt;确定性执行，不调用大模型" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="2520" y="18" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="lg_llm" value="&lt;b&gt;调用大模型&lt;/b&gt;&lt;br/&gt;标明模型与作用" style="shape=process;size=0.035;fillColor=#e1d5e7;strokeColor=#6b46c1;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=30;spacingRight=28;" vertex="1" parent="1"><mxGeometry x="2820" y="18" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="lg_dec" value="&lt;b&gt;判断&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b7950b;strokeWidth=2.5;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3120" y="14" width="190" height="78" as="geometry"/></mxCell>
        <mxCell id="lg_db" value="&lt;b&gt;数据存储&lt;/b&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2f855a;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3330" y="18" width="190" height="72" as="geometry"/></mxCell>
        <mxCell id="lg_io" value="&lt;b&gt;微信 / 邮件 收发&lt;/b&gt;" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.07;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3540" y="18" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="lg_lines" value="连线：蓝=主流程　紫=按意图分流　橙=执行落盘　红虚线=审核不通过重写　绿虚线=读取数据　灰虚线=回到微信 / 外层循环（下一条消息回到开始）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="3790" y="18" width="1270" height="72" as="geometry"/></mxCell>
        <mxCell id="z1" value="阶段一｜接收与预处理" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=2;dashed=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="690" height="2060" as="geometry"/></mxCell>
        <mxCell id="start" value="&lt;b&gt;开始：收到消息 / 到点触发&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2d3748;strokeColor=#1a202c;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="205" y="195" width="360" height="70" as="geometry"/></mxCell>
        <mxCell id="in_wx" value="&lt;b&gt;微信消息&lt;/b&gt;&lt;br/&gt;主入口 / 备用客服通道（含你对确认卡的回复）" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.07;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="320" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="in_mail" value="&lt;b&gt;邮件&lt;/b&gt;&lt;br/&gt;国际版 O365，每 2 分钟拉取" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.07;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="320" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="intake" value="&lt;b&gt;接入与预处理（代码）&lt;/b&gt;&lt;br/&gt;• 验签解密，0.5 秒内回「已收到」&lt;br/&gt;• 连续转发停手 2 秒自动合并成一件事&lt;br/&gt;• 语音转文字（qwen3-asr-flash）&lt;br/&gt;• 邮件只放行 V&amp;amp;F / Tera / B&amp;amp;D，同一封只处理一次，正文加不可信标记&lt;br/&gt;• 附件按页提取文字；原件先备份到 OneDrive；无法解析的格式只记文件名，不丢原件&lt;br/&gt;输出：一段统一的文本 + 附件" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="80" y="480" width="610" height="330" as="geometry"/></mxCell>
        <mxCell id="is_shortcut" value="&lt;b&gt;是快捷指令吗？&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b7950b;strokeWidth=2.5;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="235" y="880" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="shortcut" value="&lt;b&gt;快捷指令直接处理（代码，0 次模型）&lt;/b&gt;&lt;br/&gt;不需要上下文，立即处理：&lt;br/&gt;• 看板 / 负荷 → 直接回复（本次结束）&lt;br/&gt;• 1 / 2、开始 #N、完成 #N、撤销 → 交阶段五执行&lt;br/&gt;• 改：&amp;lt;意见&amp;gt; → 带着修改意见进入路径④重新起草" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="80" y="1160" width="610" height="270" as="geometry"/></mxCell>
        <mxCell id="e_start_wx" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="start" target="in_wx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_start_mail" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="start" target="in_mail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_wx" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.24;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="in_wx" target="intake"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_mail" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.76;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="in_mail" target="intake"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_intake" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="intake" target="is_shortcut"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_sc_yes" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="is_shortcut" target="shortcut"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="z2" value="阶段二｜装配上下文" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=2;dashed=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="790" y="130" width="540" height="2060" as="geometry"/></mxCell>
        <mxCell id="ctx_db" value="&lt;b&gt;SQLite 数据库&lt;/b&gt;&lt;br/&gt;对话记录 · 待确认卡 · 项目待办 · 文档索引" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2f855a;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="330" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="ctx" value="&lt;b&gt;装配 4 层上下文（代码）&lt;/b&gt;&lt;br/&gt;按固定顺序读取真实数据，拼成提示词：&lt;br/&gt;&lt;br/&gt;1. 跨天滚动摘要 + 最近 30 轮对话&lt;br/&gt;　（间隔超 30 分钟会标注，防止串话题）&lt;br/&gt;&lt;br/&gt;2. 待确认卡片&lt;br/&gt;　（你还没回复确认的方案）&lt;br/&gt;&lt;br/&gt;3. 在途项目、待办快照&lt;br/&gt;　（提到项目名时自动附上项目卡）&lt;br/&gt;&lt;br/&gt;4. 历史文档与旧对话检索&lt;br/&gt;　（查资料和工作交办时才检索）&lt;br/&gt;&lt;br/&gt;输出：一份完整的上下文提示词" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="820" y="600" width="480" height="620" as="geometry"/></mxCell>
        <mxCell id="e_ctx_read" value="读取" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2f855a;strokeWidth=2.5;dashed=1;fontSize=13;fontStyle=1;fontColor=#2f855a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ctx_db" target="ctx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_sc_no" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.605;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="is_shortcut" target="ctx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="z3" value="阶段三｜判断意图并分流" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=2;dashed=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="1390" y="130" width="600" height="2060" as="geometry"/></mxCell>
        <mxCell id="router" value="&lt;b&gt;路由模型判断意图&lt;/b&gt;&lt;br/&gt;qwen3.8-flash&lt;br/&gt;读上下文，判断你想做什么，补全「这个/刚才那事」" style="shape=process;size=0.035;fillColor=#e1d5e7;strokeColor=#6b46c1;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=30;spacingRight=28;" vertex="1" parent="1"><mxGeometry x="1410" y="830" width="270" height="160" as="geometry"/></mxCell>
        <mxCell id="which" value="&lt;b&gt;走哪条路？&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b7950b;strokeWidth=2.5;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1720" y="810" width="240" height="200" as="geometry"/></mxCell>
        <mxCell id="e_ctx_router" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ctx" target="router"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_router_which" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2b6cb0;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#2b6cb0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="router" target="which"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="router_note" value="&lt;b&gt;代码兜底规则&lt;/b&gt;&lt;br/&gt;• 没有待确认卡却说「确认」&lt;br/&gt;　→ 当闲聊处理&lt;br/&gt;• 交办内容太模糊（置信度 &amp;lt; 0.55）&lt;br/&gt;　→ 路径⑤&lt;br/&gt;• 没明确说「查一下/上网查」&lt;br/&gt;　→ 不联网搜索" style="rounded=0;dashed=1;fillColor=#fffbe6;strokeColor=#b7950b;strokeWidth=1.5;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1410" y="1110" width="390" height="250" as="geometry"/></mxCell>
        <mxCell id="z4" value="阶段四｜五条处理路径" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#adb5bd;strokeWidth=2;dashed=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="2050" y="130" width="2480" height="2060" as="geometry"/></mxCell>
        <mxCell id="p1" value="&lt;b&gt;① 直接执行（代码）&lt;/b&gt;&lt;br/&gt;确认或作废卡片、开始/完成打卡（可一句话多条）、撤销&lt;br/&gt;→ 交阶段五执行" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="2120" y="245" width="600" height="170" as="geometry"/></mxCell>
        <mxCell id="p2" value="&lt;b&gt;② 参谋回复（qwen3.8-flash）&lt;/b&gt;&lt;br/&gt;每条消息回复一次，不建待办&lt;br/&gt;聊几轮由你决定" style="shape=process;size=0.035;fillColor=#e1d5e7;strokeColor=#6b46c1;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=30;spacingRight=28;" vertex="1" parent="1"><mxGeometry x="2120" y="535" width="600" height="170" as="geometry"/></mxCell>
        <mxCell id="p3" value="&lt;b&gt;③ 查档问答（代码检索 + qwen3.8-flash）&lt;/b&gt;&lt;br/&gt;先查文档和旧对话，再只依据查到的内容回答&lt;br/&gt;必须带出处页码；查不到就说查不到" style="shape=process;size=0.035;fillColor=#e1d5e7;strokeColor=#6b46c1;strokeWidth=2.5;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=30;spacingRight=28;" vertex="1" parent="1"><mxGeometry x="2120" y="825" width="600" height="170" as="geometry"/></mxCell>
        <mxCell id="p5" value="&lt;b&gt;⑤ 请你澄清（代码）&lt;/b&gt;&lt;br/&gt;说明能力边界，或追问一个关键细节&lt;br/&gt;不建待办" style="rounded=0;fillColor=#dae8fc;strokeColor=#2b6cb0;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="2120" y="1115" width="600" height="170" as="geometry"/></mxCell>
        <mxCell id="p2_out" value="&lt;b&gt;回复发到微信&lt;/b&gt;&lt;br/&gt;本次结束" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.07;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2800" y="570" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="e_p2_out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#777777;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="p2_out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p3_out" value="&lt;b&gt;回复发到微信&lt;/b&gt;&lt;br/&gt;本次结束" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.07;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2800" y="860" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="e_p3_out" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=2.5;fontSize=13;fontStyle=1;fontColor=#777777;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="p3_out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p5_out" value="&lt;b&gt;回复发到微信&lt;/b&gt;&lt;br/&gt;本次结束" style="shape=parallelogram;perimeter=parallelogramPerimeter;size=0.07;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2800" y="1150" width="250" height="100" as="geometry"/></mxCell>
