<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="vf-ccus-uml25-v2" name="VF-CCUS-UML25-StateMachine-v2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1660" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title_11" value="V&amp;F IMR-MS 中国 CCS/CCUS 市场调研与双轨 GTM 工作流 v2.0 — OMG UML 2.5 行为状态机图&#10;架构宪章：全旗舰大脑 + 确定性底盘（4 阶段主干 / 原生混合编排优先 / 双版本同步交付：5 卷原始详版 + 5 卷高密度高管版 / 全文零截断真审计）" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=16;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="2320" height="74" as="geometry" /></mxCell><mxCell id="comp_stage0" value="阶段一：确定性底座与全局规划" style="swimlane;startSize=36;rounded=1;arcSize=4;fillColor=#EFF6FF;strokeColor=#1E3A8A;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontStyle=1;align=left;spacingLeft=14;collapsible=0;html=0;" vertex="1" parent="1"><mxGeometry x="220" y="128" width="620" height="270" as="geometry" /></mxCell><mxCell id="comp_stage1" value="阶段二：分赛道并发深挖与证据核验" style="swimlane;startSize=36;rounded=1;arcSize=4;fillColor=#F5F3FF;strokeColor=#5B21B6;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontStyle=1;align=left;spacingLeft=14;collapsible=0;html=0;" vertex="1" parent="1"><mxGeometry x="920" y="128" width="700" height="270" as="geometry" /></mxCell><mxCell id="comp_stage2" value="阶段三：确定性测算与全局商业裁决" style="swimlane;startSize=36;rounded=1;arcSize=4;fillColor=#ECFDF5;strokeColor=#065F46;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontStyle=1;align=left;spacingLeft=14;collapsible=0;html=0;" vertex="1" parent="1"><mxGeometry x="1700" y="128" width="660" height="270" as="geometry" /></mxCell><mxCell id="comp_stage3" value="阶段四：双版本撰写与全量真审计门禁（有界闭环 ≤ 2 轮）" style="swimlane;startSize=36;rounded=1;arcSize=4;fillColor=#FFF1F2;strokeColor=#9F1239;strokeWidth=2;fontColor=#0F172A;fontSize=15;fontStyle=1;align=left;spacingLeft=14;collapsible=0;html=0;" vertex="1" parent="1"><mxGeometry x="220" y="468" width="2140" height="890" as="geometry" /></mxCell><mxCell id="init_start" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="72" y="262" width="32" height="32" as="geometry" /></mxCell><mxCell id="state_s0_plan" value="事实装载与正交规划中" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=34;collapsible=0;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#1E40AF;strokeWidth=2;fontColor=#0F172A;fontSize=14;html=0;" vertex="1" parent="1"><mxGeometry x="246" y="180" width="568" height="196" as="geometry" /></mxCell><mxCell id="state_s0_plan_body" value="entry / 解析奥地利原厂一手技术资料并分配唯一证据编号&#10;entry / 执行中英文宏观联网侦察并去重归档至本地证据库&#10;do / 调用旗舰大脑纵览一手资料，划分 5 条正交业务赛道与 1 条独立竞品及防爆小屋生态任务&#10;exit / 导出单源结构化契约并固化调研计划" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;whiteSpace=wrap;html=0;fontColor=#1E293B;fontSize=13;" vertex="1" parent="state_s0_plan"><mxGeometry x="0" y="34" width="568" height="162" as="geometry" /></mxCell><mxCell id="state_s1_mine" value="并发检索与全旗舰提纯中" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=34;collapsible=0;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2;fontColor=#0F172A;fontSize=14;html=0;" vertex="1" parent="1"><mxGeometry x="946" y="180" width="648" height="196" as="geometry" /></mxCell><mxCell id="state_s1_mine_body" value="entry / 并发执行中英文双引擎检索及核心网页全文抓取入库&#10;do / 全旗舰大脑按业务赛道提纯项目、细分规模参数与原始四项收益结构（严守 0–100 标尺）&#10;do / 独立竞品生态任务专门提纯竞品战卡、本土防爆小屋集成商与设计院准入壁垒&#10;exit / 确定性核验全部引用编号，剔除无依据条目并记录剔除台账（禁止静默假挂靠）" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;whiteSpace=wrap;html=0;fontColor=#1E293B;fontSize=13;" vertex="1" parent="state_s1_mine"><mxGeometry x="0" y="34" width="648" height="162" as="geometry" /></mxCell><mxCell id="state_s2_arbitrate" value="双核测算与全局裁决中" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=34;collapsible=0;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=2;fontColor=#0F172A;fontSize=14;html=0;" vertex="1" parent="1"><mxGeometry x="1726" y="180" width="608" height="196" as="geometry" /></mxCell><mxCell id="state_s2_arbitrate_body" value="entry / 确定性引擎按细分赛道与三轨交付分别累加测算 2026–2036 市场规模（读取配置乘数）&#10;entry / 确定性引擎保留原始收益比例测算三情景回收期并淘汰伪需求（防幸存者偏差）&#10;do / 单次旗舰大脑纵览全池：合并同义重复场景、统一标尺全局排序并产出四类买方阻力矩阵&#10;exit / 锁定全卷唯一只读事实锚点总表，并按五卷主题精准路由证据包" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;whiteSpace=wrap;html=0;fontColor=#1E293B;fontSize=13;" vertex="1" parent="state_s2_arbitrate"><mxGeometry x="0" y="34" width="608" height="162" as="geometry" /></mxCell><mxCell id="state_s3_full_synth" value="原始详版五卷并发撰写中" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=34;collapsible=0;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2;fontColor=#0F172A;fontSize=14;html=0;" vertex="1" parent="1"><mxGeometry x="260" y="536" width="640" height="204" as="geometry" /></mxCell><mxCell id="state_s3_full_synth_body" value="entry / 向每卷精准注入专属主题证据包（高序号引用优先召回，零按序盲截）与只读事实锚点总表&#10;do / 旗舰大脑并发撰写第 00–04 卷原始详版报告（严格锁定市场规模与回收期数值，保留伪需求淘汰表）&#10;exit / 暂存五卷原始详版初稿" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;whiteSpace=wrap;html=0;fontColor=#1E293B;fontSize=13;" vertex="1" parent="state_s3_full_synth"><mxGeometry x="0" y="34" width="640" height="170" as="geometry" /></mxCell><mxCell id="state_s3_critic" value="全量硬审计与分卷全文复核中" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=34;collapsible=0;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#BE123C;strokeWidth=2;fontColor=#0F172A;fontSize=14;html=0;" vertex="1" parent="1"><mxGeometry x="1040" y="536" width="640" height="204" as="geometry" /></mxCell><mxCell id="state_s3_critic_body" value="entry / 确定性程序全量扫描五卷正文：提取全部单条与组合引用编号并核对入库真值&#10;do / 独立复核大脑分卷并发审阅（每卷传入 100% 完整正文，严禁截断），核对跨卷数字与竞品真实性&#10;exit / 汇总硬核错误清单、待修订卷宗及外部缺口补检词" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;whiteSpace=wrap;html=0;fontColor=#1E293B;fontSize=13;" vertex="1" parent="state_s3_critic"><mxGeometry x="0" y="34" width="640" height="170" as="geometry" /></mxCell><mxCell id="choice_audit_choice" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2.4;" vertex="1" parent="1"><mxGeometry x="1337" y="822" width="46" height="46" as="geometry" /></mxCell><mxCell id="state_s3_rewrite" value="定向补检与完整修订中" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=34;collapsible=0;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=2;fontColor=#0F172A;fontSize=14;html=0;" vertex="1" parent="1"><mxGeometry x="1760" y="742" width="560" height="206" as="geometry" /></mxCell><mxCell id="state_s3_rewrite_body" value="entry / 若复核标记外部证据缺口，执行最多 4 条精准联网补检并追加归档至证据库&#10;do / 仅针对被点名卷宗传入 100% 完整原稿、具体错误清单与新证据执行定向修订（严禁腰斩原稿）&#10;exit / 回填修订后完整卷宗并准备复检" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;whiteSpace=wrap;html=0;fontColor=#1E293B;fontSize=13;" vertex="1" parent="state_s3_rewrite"><mxGeometry x="0" y="34" width="560" height="172" as="geometry" /></mxCell><mxCell id="state_s3_exec_distill" value="高密度高管版五卷提纯中" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=34;collapsible=0;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#0369A1;strokeWidth=2;fontColor=#0F172A;fontSize=14;html=0;" vertex="1" parent="1"><mxGeometry x="260" y="1060" width="780" height="220" as="geometry" /></mxCell><mxCell id="state_s3_exec_distill_body" value="entry / 锁定经审定通过的五卷原始详版全文与全局只读事实锚点总表&#10;do / 旗舰大脑并发提纯第 00–04 卷高密度高管版（每卷 2,500–5,500 字，结论先行、表格驱动、零注水）&#10;do / 100% 保持市场规模、回收期、三轨架构、淘汰伪需求结论及合法证据编号与详版完全一致&#10;exit / 形成与原始详版 1:1 对应的五卷高密度高管版" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;whiteSpace=wrap;html=0;fontColor=#1E293B;fontSize=13;" vertex="1" parent="state_s3_exec_distill"><mxGeometry x="0" y="34" width="780" height="186" as="geometry" /></mxCell><mxCell id="state_s3_finalize" value="确定性双版本审计门禁与落盘中" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=34;collapsible=0;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=2;fontColor=#0F172A;fontSize=14;html=0;" vertex="1" parent="1"><mxGeometry x="1180" y="1060" width="820" height="220" as="geometry" /></mxCell><mxCell id="state_s3_finalize_body" value="entry / 确定性程序全量审计十卷成品（5 卷原始详版 + 5 卷高管版）：核验引用 100% 合法、十年市场规模与回收期数值一致、伪需求已披露&#10;entry / 确定性程序零改写渲染第 05 卷全量证据溯源索引表，并对全套产物执行密钥防泄露扫描&#10;do / 落盘原始详版五卷、高管版五卷（独立子目录）、证据索引表及客观核验遥测报告&#10;exit / 签发确定性门禁结果与交付文件清单" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;whiteSpace=wrap;html=0;fontColor=#1E293B;fontSize=13;" vertex="1" parent="state_s3_finalize"><mxGeometry x="0" y="34" width="820" height="186" as="geometry" /></mxCell><mxCell id="final_end" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="2160" y="1152" width="36" height="36" as="geometry" /></mxCell><mxCell id="note_legend_note" value="【OMG UML 2.5 图元图例与 v2.0 架构治理要点说明（纯注释区，不参与状态迁移）】&#10;1. 符号规范：● 初始伪状态（唯一无条件入口） ｜ ◉ 终止状态（零出边） ｜ ◇ 选择伪状态（出边全部具备互斥 [监护条件] 及显式 [else] 保底出口） ｜ 圆角两栏框 = 状态节点（内部标注 entry/do/exit，不混用数据库圆柱体或流程图菱形）。&#10;2. 关键瘦身与止血：取消 v1.0 中 10 次小模型买方质询 + 10 场小模型两两锦标赛 + 盲打 100 分的终审裁判，合并为 1 次全旗舰全局裁决；总大模型调用量从 34 次压减至 ~11–13 次（另加 5 次高管版提纯），全链路直上旗舰大脑。&#10;3. 确定性底盘升级：修复陆上管网与出口船运规模覆盖漏洞（细分累加保留三轨）、保留原始四项收益比例（取消固定比例覆写）、全量提取多编号组合引用、剔除无据条目零假挂靠、分卷复核与修订均 100% 全文输入零截断。&#10;4. 双套报告交付：原始详版 5 卷落盘于输出根目录，高密度高管版 5 卷落盘于 executive_edition/ 子目录，两套报告共用同一证据索引表并同步通过 100% 确定性审计门禁。" style="shape=note;whiteSpace=wrap;html=0;size=16;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.6;fontColor=#451A03;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="220" y="1400" width="2140" height="220" as="geometry" /></mxCell><mxCell id="trans_12" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#0F172A;strokeWidth=2.2;endArrow=open;endFill=0;endSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="104" y="278" as="sourcePoint" /><mxPoint x="246" y="278" as="targetPoint" /></mxGeometry></mxCell><mxCell id="lbl_13" value="/ 初始化运行任务" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=1;fontColor=#0F172A;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="104" y="232" width="130" height="28" as="geometry" /></mxCell><mxCell id="trans_14" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#1E40AF;strokeWidth=2.2;endArrow=open;endFill=0;endSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="814" y="278" as="sourcePoint" /><mxPoint x="946" y="278" as="targetPoint" /></mxGeometry></mxCell><mxCell id="lbl_15" value="调研计划已固化" style="rounded=1;arcSize=16;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#1E40AF;strokeWidth=1;fontColor=#1E40AF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometr