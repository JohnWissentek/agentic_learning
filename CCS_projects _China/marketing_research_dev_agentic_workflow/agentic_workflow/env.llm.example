# LLM Gateway Configuration (DashScope OpenAI-Compatible API)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model tiers (fast / producer / critic)
VF_FAST_MODEL=qwen3.8-flash
VF_FAST_FALLBACK_MODEL=qwen-plus
VF_PRODUCER_MODEL=qwen3.8-max
VF_PRODUCER_FALLBACK_MODEL=qwen-max
VF_CRITIC_MODEL=deepseek-v4-pro
VF_CRITIC_FALLBACK_MODEL=qwen3.8-max
VF_MAX_REFLECTION_LOOPS=2
VF_CONCURRENCY=6
