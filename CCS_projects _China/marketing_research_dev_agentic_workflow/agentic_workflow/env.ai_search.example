# Search Providers Configuration (Do NOT commit populated keys)
# Chinese search primary: Metaso AI Search
METASO_API_KEY=your_metaso_api_key_here
METASO_API_BASE=https://metaso.cn/api/v1

# Global search primary: Serper (Google Search JSON API)
SERPER_API_KEY=your_serper_api_key_here
SERPER_TIME_RANGE=qdr:y

# Optional Jina Reader API key for fulltext fallback
# JINA_API_KEY=
