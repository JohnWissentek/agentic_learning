 x="470" y="1540" as="targetPoint" /><Array as="points"><mxPoint x="1360" y="1565" /><mxPoint x="470" y="1565" /></Array></mxGeometry></mxCell><mxCell id="edge_39" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#16A34A;strokeWidth=2.6;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="1540" as="sourcePoint" /><mxPoint x="350" y="1645" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_40" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#1E3A8A;strokeWidth=2.6;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="1737" as="sourcePoint" /><mxPoint x="660" y="1737" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_41" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#059669;strokeWidth=2.6;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200" y="1737" as="sourcePoint" /><mxPoint x="1240" y="1737" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>