<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="vf-ccus-clean" name="VF-CCUS-Workflow-Topology"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="2860" pageHeight="2120" background="#F8FAFC"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="band_11" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="1780" height="1900" as="geometry" /></mxCell><mxCell id="ribbon_12" value="控制流主干区：Stage 0a → Stage 7 因果协同工作流与有界反思闭环" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#1E293B;strokeColor=#1E293B;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="52" y="188" width="1756" height="32" as="geometry" /></mxCell><mxCell id="band_13" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="75" y="455" width="1710" height="260" as="geometry" /></mxCell><mxCell id="ribbon_14" value="Stage 1：Parallelization 多赛道并发深挖与防幻觉入库（Ch 3 Parallel Fan-Out）" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#4338CA;strokeColor=#4338CA;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="87" y="463" width="1686" height="32" as="geometry" /></mxCell><mxCell id="band_15" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="75" y="1265" width="1710" height="320" as="geometry" /></mxCell><mxCell id="ribbon_16" value="Stage 6：异构 Critic 有界反思闭环 + Corrective RAG 缺口补检（Ch 4 + Ch 14，Max Loops = 2）" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#9F1239;strokeColor=#9F1239;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="87" y="1273" width="1686" height="32" as="geometry" /></mxCell><mxCell id="band_17" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1855" y="180" width="965" height="1900" as="geometry" /></mxCell><mxCell id="ribbon_18" value="右区解耦边栏：上下文组装契约 (Context Assembly) 与核心工程不变式" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#B45309;strokeColor=#B45309;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1867" y="188" width="941" height="32" as="geometry" /></mxCell><mxCell id="node_hdr_banner" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="2780" height="125" as="geometry" /></mxCell><mxCell id="node_hdr_banner_hdr" value="奥地利 V&amp;F IMR-MS 中国 CCS/CCUS 市场调研与双轨 GTM 多智能体协同拓扑图 (VF-CCUS-CHINA-2026-V1)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=16;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="2780" height="40" as="geometry" /></mxCell><mxCell id="node_hdr_banner_body" value="遵循《Agentic Design Patterns》全书范式（Ch 1-21）| 左区：Stage 0a → Stage 7 清晰控制流主干与 Critic 有界闭环；右区：Context Assembly &amp; 防幻觉审计契约边栏。&#10;图例：[深蓝]=确定性Python工具与计算 | [紫色]=多智能体认知节点 | [绿色]=Siggi语料与SQLite证据库 | [琥珀]=Context组装 | [玫红]=门禁/有界循环" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#0F172A;fontSize=14;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="2780" height="85" as="geometry" /></mxCell><mxCell id="node_s0a_siggi" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="235" width="520" height="165" as="geometry" /></mxCell><mxCell id="node_s0a_siggi_hdr" value="Stage 0a-1：Siggi 一手资料 MCP 解析器 [确定性]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#065F46;strokeColor=#065F46;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="80" y="235" width="520" height="38" as="geometry" /></mxCell><mxCell id="node_s0a_siggi_body" value="• 全量解析 information_from_siggi/ 下 MD 与 PDF&#10;• 生成 [EV-SIGGI-001..048]：CO2Sense / QAS 架构、Thermo MAX-iR/MAX-Bev、Shell/IFE 2024 点蚀机理&#10;• 存入 data/vf_ccus_evidence_vault.db (WAL去重)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#064E3B;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="80" y="273" width="520" height="127" as="geometry" /></mxCell><mxCell id="node_s0a_recon" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="650" y="235" width="520" height="165" as="geometry" /></mxCell><mxCell id="node_s0a_recon_hdr" value="Stage 0a-2：中国 &amp; 全球宏观侦察 [确定性检索]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="650" y="235" width="520" height="38" as="geometry" /></mxCell><mxCell id="node_s0a_recon_body" value="• 双引擎路由：Metaso CN 优先 / Serper GLOBAL 优先&#10;• 实时检索十五五 CCUS 枢纽、绿色甲醇、LCO2 船运及国标动态&#10;• 铸造初始 [EV-CN-*] 与 [EV-GL-*] 并记入 query_log" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#0F172A;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="650" y="273" width="520" height="127" as="geometry" /></mxCell><mxCell id="node_s0b_plan" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1220" y="235" width="560" height="165" as="geometry" /></mxCell><mxCell id="node_s0b_plan_hdr" value="Stage 0b：Step-Back 发现规划官 [智能体]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#5B21B6;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1220" y="235" width="560" height="38" as="geometry" /></mxCell><mxCell id="node_s0b_plan_body" value="• 零预设静态赛道，综合 EV-SIGGI + 宏观扫描结果&#10;• 动态聚类 5–6 条新兴赛道（S1 EOR/管道/船运、S2 绿醇、S3 捕集中试、S4 食品负向对照、竞品与PAC）&#10;• 锁定 DiscoveryPlan 检索词契约" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#1E1B4B;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1220" y="273" width="560" height="127" as="geometry" /></mxCell><mxCell id="node_t1" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="95" y="508" width="262" height="182" as="geometry" /></mxCell><mxCell id="node_t1_hdr" value="T1 EOR/管道" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#5B21B6;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="95" y="508" width="262" height="36" as="geometry" /></mxCell><mxCell id="node_t1_body" value="• CN/GLOBAL 并发&#10;• 全文抓取与抽取&#10;• 长输管道腐蚀&#10;&amp; 三桶油示范&#10;• Clean IDs入库" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#1E1B4B;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="95" y="544" width="262" height="146" as="geometry" /></mxCell><mxCell id="node_t2" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="375" y="508" width="262" height="182" as="geometry" /></mxCell><mxCell id="node_t2_hdr" value="T2 LCO2船运" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#5B21B6;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="375" y="508" width="262" height="36" as="geometry" /></mxCell><mxCell id="node_t2_body" value="• CN/GLOBAL 并发&#10;• 全文抓取与抽取&#10;• 中国船厂LCO2&#10;&amp; 沿海接收枢纽&#10;• Clean IDs入库" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#1E1B4B;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="375" y="544" width="262" height="146" as="geometry" /></mxCell><mxCell id="node_t3" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="655" y="508" width="262" height="182" as="geometry" /></mxCell><mxCell id="node_t3_hdr" value="T3 绿醇/e-SAF" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#5B21B6;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="655" y="508" width="262" height="36" as="geometry" /></mxCell><mxCell id="node_t3_body" value="• CN/GLOBAL 并发&#10;• 全文抓取与抽取&#10;• Cu基催化剂防毒&#10;&amp; 合成气监测&#10;• Clean IDs入库" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#1E1B4B;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="655" y="544" width="262" height="146" as="geometry" /></mxCell><mxCell id="node_t4" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="935" y="508" width="262" height="182" as="geometry" /></mxCell><mxCell id="node_t4_hdr" value="T4 胺法/中试" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#5B21B6;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="935" y="508" width="262" height="36" as="geometry" /></mxCell><mxCell id="node_t4_body" value="• CN/GLOBAL 并发&#10;• 全文抓取与抽取&#10;• 设计院中试/水泥&#10;Track A 科研切入&#10;• Clean IDs入库" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#1E1B4B;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="935" y="544" width="262" height="146" as="geometry" /></mxCell><mxCell id="node_t5" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1215" y="508" width="262" height="182" as="geometry" /></mxCell><mxCell id="node_t5_hdr" value="T5 竞品/PAC" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#5B21B6;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1215" y="508" width="262" height="36" as="geometry" /></mxCell><mxCell id="node_t5_body" value="• CN/GLOBAL 并发&#10;• 全文抓取与抽取&#10;• FTIR/GC/国产MS&#10;&amp; GB/T3836小屋&#10;• Clean IDs入库" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#1E1B4B;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1215" y="544" width="262" height="146" as="geometry" /></mxCell><mxCell id="node_t6" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1495" y="508" width="262" height="182" as="geometry" /></mxCell><mxCell id="node_t6_hdr" value="T6 食品对照" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#5B21B6;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1495" y="508" width="262" height="36" as="geometry" /></mxCell><mxCell id="node_t6_body" value="• CN/GLOBAL 并发&#10;• 全文抓取与抽取&#10;• 饮料级低支付意愿&#10;伪需求对照检验&#10;• Clean IDs入库" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#1E1B4B;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1495" y="544" width="262" height="146" as="geometry" /></mxCell><mxCell id="node_s2_calc" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="775" width="1120" height="195" as="geometry" /></mxCell><mxCell id="node_s2_calc_hdr" value="Stage 2：Python 确定性双核引擎 [MKT-CALC] TAM/SAM/SOM + [ROI-CALC] 漏斗筛查（严禁 LLM 心算）" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="80" y="775" width="1120" height="38" as="geometry" /></mxCell><mxCell id="node_s2_calc_body" value="1. [MKT-CALC] 自底向上汇总 2026–2030（十五五）与 2031–2036（十六五）低/中/高三情景台套数与万元规模；按 Track A(¥180万)/B(¥420万)/C(¥720万) 单价精准锚定。&#10;2. [ROI-CALC] 三情景计算客户 CAPEX、防酸蚀/防催化剂中毒/省人耗净现金流、回收期(月)、3Y ROI%、5Y IRR% 与 NPV。&#10;3. 反幸存者偏差门禁：显式淘汰保守回收期 &gt; 42 个月或低支付意愿伪需求（如常规饮料级CO2抽检）进入 EliminatedWedge 保留清单。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#0F172A;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="80" y="813" width="1120" height="157" as="geometry" /></mxCell><mxCell id="node_s3_storm" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1240" y="775" width="540" height="195" as="geometry" /></mxCell><mxCell id="node_s3_storm_hdr" value="Stage 3：中国买方 4 角色 STORM 压力测试 [智能体]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#5B21B6;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1240" y="775" width="540" height="38" as="geometry" /></mxCell><mxCell id="node_s3_storm_body" value="• 三桶油/央企压缩防腐总工（H2SO4/HNO3 点蚀门禁）&#10;• 设计院(SEI/HQC/CPECC/天辰)分析室与EPC采购经理&#10;• 煤化工/水泥/绿醇项目业主 EHS 与财务 ROI 决策人&#10;• 大型分析小屋集成商（VF-QAS-CN 毛利与SLA）" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#1E1B4B;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1240" y="813" width="540" height="157" as="geometry" /></mxCell><mxCell id="node_s4_elo" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="1030" width="540" height="175" as="geometry" /></mxCell><mxCell id="node_s4_elo_hdr" value="Stage 4：瑞士轮配对 Elo 锦标赛 [Ch 20/21]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#5B21B6;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="80" y="1030" width="540" height="38" as="geometry" /></mxCell><mxCell id="node_s4_elo_body" value="• 依据 IMR-MS 物理不可替代性、[ROI-CALC] 保守韧性、近中期签约确定性进行 2 轮配对裁决&#10;• 55% 加权得分 + 45% 归一化 Elo 输出商业切入总榜" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#1E1B4B;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="80" y="1068" width="540" height="137" as="geometry" /></mxCell><mxCell id="node_s5_synth" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="660" y="1030" width="1120" height="175" as="geometry" /></mxCell><mxCell id="node_s5_synth_hdr" value="Stage 5：5 卷旗舰交付报告并发撰写 [Ch 3 Parallel Fan-Out]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#5B21B6;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="660" y="1030" width="1120" height="38" as="geometry" /></mxCell><mxCell id="node_s5_synth_body" value="• Vol 00：决策备忘录（直接回答机会/规模/竞品/GTM四大问题）  • Vol 01：市场规模测算、重点项目清单与化学腐败痛点&#10;• Vol 02：国内外竞品与一线 Battlecards（不含编造型号）        • Vol 03：Track A/B/C 双轨定价、PAC合作与设计院 Spec-in&#10;• Vol 04：30-60-90 天与 12-24 个月可审计商业落地路线图（严格原样锁定 [MKT-CALC] 与 [ROI-CALC] 数字）" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#1E1B4B;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="660" y="1068" width="1120" height="137" as="geometry" /></mxCell><mxCell id="node_s6_critic" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="1320" width="740" height="220" as="geometry" /></mxCell><mxCell id="node_s6_critic_hdr" value="Stage 6a：程序化引用核验 + 异构 Critic 深度审计 [门禁]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#9F1239;strokeColor=#9F1239;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="100" y="1320" width="740" height="38" as="geometry" /></mxCell><mxCell id="node_s6_critic_body" value="• Python 确定性正则核查所有 [EV-SIGGI/CN/GL-*] 是否全部真实存在于 SQLite 证据库&#10;• 异构推理模型核查跨卷宗数字一致性、竞品无编造、Track A/B/C 财务与BOM闭环&#10;• 产出 CritiqueAuditOutput（Passed 放行 OR 指定待重写卷宗 + CRAG 补检词）" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#4C0519;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="100" y="1358" width="740" height="182" as="geometry" /></mxCell><mxCell id="node_s6_crag" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="960" y="1320" width="800" height="220" as="geometry" /></mxCell><mxCell id="node_s6_crag_hdr" value="Stage 6b：CRAG 缺口再检索 + 定向单卷重写 [有界 &lt;= 2轮]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="960" y="1320" width="800" height="38" as="geometry" /></mxCell><mxCell id="node_s6_crag_body" value="• 若 Critic 标记证据缺失，自动调用 Metaso/Serper 执行最多 4 条精准补检并写入 Vault&#10;• 仅重生成被 Critic 点名的瑕疵卷宗（节省 &gt;60% Token，不重新扰动已过关章节）&#10;• 重生成后强制回流 Stage 6a 复检，达到 max_loops=2 强制退出至 Stage 7" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#0F172A;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="960" y="1358" width="800" height="182" as="geometry" /></mxCell><mxCell id="node_s7_vol5" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="1645" width="540" height="185" as="geometry" /></mxCell><mxCell id="node_s7_vol5_hdr" value="Stage 7a：Zero-LLM 全量证据索引 [确定性]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="80" y="1645" width="540" height="38" as="geometry" /></mxCell><mxCell id="node_s7_vol5_body" value="• 直接读取 SQLite Vault 全量表，零 LLM 改写&#10;• 生成 Vol 05 可审计引用溯源索引表&#10;• 运行 SecretLeakGuard 扫描确保无密钥泄露" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#0F172A;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="80" y="1683" width="540" height="147" as="geometry" /></mxCell><mxCell id="node_s7_judge" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="660" y="1645" width="540" height="185" as="geometry" /></mxCell><mxCell id="node_s7_judge_hdr" value="Stage 7b：100 分制 Stage-Gate 终审门禁" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#9F1239;strokeColor=#9F1239;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="660" y="1645" width="540" height="38" as="geometry" /></mxCell><mxCell id="node_s7_judge_body" value="• 5 维度 × 20 分（中国项目落地/规模机理 rigour/竞品战卡/双轨GTM/引用完备性）&#10;• ≥ 85.0 分方可通过门禁并签发终稿" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#4C0519;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="660" y="1683" width="540" height="147" as="geometry" /></mxCell><mxCell id="node_s7_out" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1240" y="1645" width="540" height="185" as="geometry" /></mxCell><mxCell id="node_s7_out_hdr" value="最终交付产物集合 (research_outputs/)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#065F46;strokeColor=#065F46;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1240" y="1645" width="540" height="38" as="geometry" /></mxCell><mxCell id="node_s7_out_body" value="• 00–04 战略报告主卷 + 05 证据索引表&#10;• 06_EVALUATION_SCORECARD_AND_COST_TELEMETRY.json&#10;• 07_WORKFLOW_EXECUTION_TOPOLOGY.{drawio,svg,pdf}" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#064E3B;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1240" y="1683" width="540" height="147" as="geometry" /></mxCell><mxCell id="node_footer_mode" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="1885" width="1700" height="160" as="geometry" /></mxCell><mxCell id="node_footer_mode_hdr" value="双运行模式完全等价性保障（Standalone LangGraph CLI 与 Antigravity Native Hybrid 共用同一 Python 脊柱）" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="80" y="1885" width="1700" height="38" as="geometry" /></mxCell><mxCell id="node_footer_mode_body" value="• Standalone 模式：`uv run vf-ccus-research run --profile flagship` 由 LangGraph StateGraph 调度 DashScope (qwen3.8-flash / qwen3.8-max / deepseek-v4-pro)。&#10;• Native Hybrid 模式：`run_workflow` 执行 `ide_workflows/antigravity_run_workflow.py`，原生 Pro/Critics 智能体经由 `vf-ccus-research` CLI 共享同一 SQLite Vault 与 [MKT-CALC]/[ROI-CALC] 计算引擎。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#0F172A;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="80" y="1923" width="1700" height="122" as="geometry" /></mxCell><mxCell id="node_ctx_dual" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1885" y="235" width="905" height="295" as="geometry" /></mxCell><mxCell id="node_ctx_dual_hdr" value="契约 1：双轨混合交付与定价护栏 (discovery_scope.yaml)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#B45309;strokeColor=#B45309;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1885" y="235" width="905" height="38" as="geometry" /></mxCell><mxCell id="node_ctx_dual_body" value="• Track A (奥地利原装核心主机 CO2Sense/AirSense)：¥140万–220万（基准 ¥180万），主攻科研院所/高校/催化剂与膜中试平台。&#10;• Track B (VF-QAS-CN 双轨本土化防爆小屋)：¥320万–550万（基准 ¥420万），进口 CO2Sense + 中国 PAC 集成商（GB/T 3836 防爆、电伴热采样、恒流切换阀、辅助 GC/NDIR/FID/P2O5/AFS汞），主攻三桶油管道/EOR、绿醇催化、国内新建装置。&#10;• Track C (奥地利原装 PremierGuard CCUS QAS)：¥580万–950万（基准 ¥720万），主攻外资合资沿海枢纽与国际 LCO2 船舶出口。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#451A03;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1885" y="273" width="905" height="257" as="geometry" /></mxCell><mxCell id="node_ctx_physics" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1885" y="565" width="905" height="345" as="geometry" /></mxCell><mxCell id="node_ctx_physics_hdr" value="契约 2：V&amp;F IMR-MS 物理不可替代性与一手基线 ([EV-SIGGI-*])" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#B45309;strokeColor=#B45309;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1885" y="565" width="905" height="38" as="geometry" /></mxCell><mxCell id="node_ctx_physics_body" value="• 核心对比：29 种 CCS 关键杂质表中 IMR-MS 软电离 (~1s 响应) 直测 21/29 种；Thermo MAX-iR/MAX-Bev FTIR 无法直测 H2/N2/Ar，且综合排硫/纯度周期 ~10分钟（[EV-SIGGI-*]）。&#10;• Shell/IFE 2024 机理：高压 CO2 管道内 NOx (2.5ppm) + H2S (5ppm) + SOx (10ppm) + O2 (10ppm) + H2O (50ppm) 诱发自由基链式反应生成硫酸/硝酸，致碳钢点蚀 &gt;25–1000 mm/yr（5Mtpa管道 1ppm 析出即 5,000 kg/年强酸）。&#10;• 欧洲已验证灯塔：Northern Lights Ph2 (&gt;5Mtpa)、Brevik 水泥 (400ktpa, ~30s周期)、Stockholm Exergi (900ktpa, 3套QAS)、丹麦 ASV/AVV、中国厦门造 LCO2 船。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#451A03;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1885" y="603" width="905" height="307" as="geometry" /></mxCell><mxCell id="node_ctx_math" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1885" y="945" width="905" height="335" as="geometry" /></mxCell><mxCell id="node_ctx_math_hdr" value="契约 3：[MKT-CALC] 与 [ROI-CALC] 确定性数学审计锁" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#B45309;strokeColor=#B45309;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1885" y="945" width="905" height="38" as="geometry" /></mxCell><mxCell id="node_ctx_math_body" value="• 所有 TAM/SAM/SOM 台套数与营收规模均由 `compute_china_tam_sam_som` 按低/中/高三情景在 Python 内算出，跨越 `2026-2030` 与 `2031-2036` 双周期。&#10;• 所有客户回报由 `compute_roi_metrics` 按 8% 折现率计算 5 年 NPV/IRR、3 年 ROI 与回收期月数。&#10;• 任何大模型节点禁止篡改数字；Critic 阶段自动比对第 00/01/03 卷与 JSON 基准数值，不一致即退回重写。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#451A03;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1885" y="983" width="905" height="297" as="geometry" /></mxCell><mxCell id="node_ctx_guard" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1885" y="1315" width="905" height="340" as="geometry" /></mxCell><mxCell id="node_ctx_guard_hdr" value="契约 4：反伪需求与合规安全三重防线" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#B45309;strokeColor=#B45309;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1885" y="1315" width="905" height="38" as="geometry" /></mxCell><mxCell id="node_ctx_guard_body" value="• 反幸存者偏差：保留第 2 阶段被淘汰的常规食品饮料级 CO2 离线抽检场景（S4 负向对照），向管理层诚实披露“有技术优势但客户无支付意愿”的陷阱。&#10;• 反型号编造：`clean_track_dossier` 在入库后立即校验证据 ID，凡证据库未出现的国产或进口设备型号一律剔除。&#10;• 防密钥泄露：`assert_no_secrets_leaked` 在 Stage 7 写盘前及 `pytest` 全程扫描所有文本与 JSON。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#451A03;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1885" y="1353" width="905" height="302" as="geometry" /></mxCell><mxCell id="node_ctx_kpi" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1885" y="1690" width="905" height="355" as="geometry" /></mxCell><mxCell id="node_ctx_kpi_hdr" value="契约 5：Stage-Gate 量化准出基准 (100 分制 &gt;= 85 通过)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#065F46;strokeColor=#065F46;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1885" y="1690" width="905" height="38" as="geometry" /></mxCell><mxCell id="node_ctx_kpi_body" value="1. 中国项目与政策颗粒度 (20分)：是否具名落地三大油、煤化工、绿醇与国内船厂项目。&#10;2. 规模测算与化学机理深度 (20分)：[MKT-CALC] 逻辑透明性 + 腐蚀/防毒定量论证。&#10;3. 竞品战卡精准度 (20分)：过程质谱 vs FTIR vs 光学/GC vs 国产质谱真实优劣拆解。&#10;4. 双轨 GTM 与设计院可执行性 (20分)：Track A/B/C 售价/毛利/PAC伙伴/Spec-in路径。&#10;5. 全量证据追溯与正反客观性 (20分)：Zero-LLM 第05卷索引、无编造ID、明确标注已淘汰伪需求。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#064E3B;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1885" y="1728" width="905" height="317" as="geometry" /></mxCell><mxCell id="pill_p_reject" value="不通过 / 补检 (≤2轮)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=0;fillColor=#FFE4E6;strokeColor=#E11D48;strokeWidth=1.5;fontColor=#881337;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="845" y="1392" width="112" height="34" as="geometry" /></mxCell><mxCell id="pill_p_pass" value="Critic PASS / 达上限" style="rounded=1;arcSize=50;whiteSpace=wrap;html=0;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontColor=#14532D;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="215" y="1598" width="170" height="32" as="geometry" /></mxCell><mxCell id="edge_19" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#059669;strokeWidth=2.6;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="317" as="sourcePoint" /><mxPoint x="650" y="317" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_20" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#2563EB;strokeWidth=2.6;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170" y="317" as="sourcePoint" /><mxPoint x="1220" y="317" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_21" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#5B21B6;strokeWidth=2.6;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="400" as="sourcePoint" /><mxPoint x="226" y="508" as="targetPoint" /><Array as="points"><mxPoint x="1500" y="428" /><mxPoint x="226" y="428" /></Array></mxGeometry></mxCell><mxCell id="edge_22" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#5B21B6;strokeWidth=2.6;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="400" as="sourcePoint" /><mxPoint x="506" y="508" as="targetPoint" /><Array as="points"><mxPoint x="1500" y="428" /><mxPoint x="506" y="428" /></Array></mxGeometry></mxCell><mxCell id="edge_23" value="" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#5B21B6;strokeWidth=2.6;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="400" as="sourcePoint" /><mxPoint x="786" y="508" as="targetPoint" /><Array as="points"><mxPoint x="1500" y="428" /><mxPoint x="786" y="428" /></Array></mxGeometry></mxCell><mxCell id="edge_24" value="" style="edgeStyle=none;rounded=0;o