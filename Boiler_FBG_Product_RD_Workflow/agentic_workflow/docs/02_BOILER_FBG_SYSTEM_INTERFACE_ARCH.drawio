<mxfile host="app.diagrams.net" modified="2026-11-16" version="24.7.17"><diagram id="bfbg_ipd_topology" name="BoilerSense-AI Multi-Agent IPD Topology"><mxGraphModel dx="1420" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1980" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="bg_canvas" value="" style="rounded=0;fillColor=#F8FAFC;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2800" height="1980" as="geometry" /></mxCell><mxCell id="band_13" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="760" height="1780" as="geometry" /></mxCell><mxCell id="bh_14" value="Zone 1 · 锅炉炉膛水冷壁现场端 (350°C–600°C 强振防爆区)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#B45309;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="760" height="36" as="geometry" /></mxCell><mxCell id="band_15" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="830" y="145" width="1140" height="1780" as="geometry" /></mxCell><mxCell id="bh_16" value="Zone 2 · 解调机柜硬件集成层 (外购成品模块，免自研模拟PCB)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1E3A8A;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="830" y="145" width="1140" height="36" as="geometry" /></mxCell><mxCell id="band_17" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2000" y="145" width="760" height="1780" as="geometry" /></mxCell><mxCell id="bh_18" value="Zone 3 · 自研软件、物理隔离DCS与两阶段锅炉AI层" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#065F46;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="2000" y="145" width="760" height="36" as="geometry" /></mxCell><mxCell id="edge_51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#B45309;strokeWidth=2.6;endArrow=block;endFill=1;" edge="1" parent="1" source="grp_19" target="grp_21"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="380" as="sourcePoint" /><mxPoint x="420" y="430" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#059669;strokeWidth=2.6;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;" edge="1" parent="1" source="grp_21" target="grp_23"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="605" as="sourcePoint" /><mxPoint x="420" y="655" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#1E3A8A;strokeWidth=2.6;endArrow=block;endFill=1;" edge="1" parent="1" source="grp_23" target="grp_25"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="830" as="sourcePoint" /><mxPoint x="420" y="880" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#9F1239;strokeWidth=2.6;endArrow=block;endFill=1;" edge="1" parent="1" source="grp_25" target="grp_27"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="1055" as="sourcePoint" /><mxPoint x="420" y="1110" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#2563EB;strokeWidth=3.2;endArrow=block;endFill=1;" edge="1" parent="1" source="grp_25" target="grp_29"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="967" as="sourcePoint" /><mxPoint x="865" y="302" as="targetPoint" /><Array as="points"><mxPoint x="810" y="967" /><mxPoint x="810" y="302" /></Array></mxGeometry></mxCell><mxCell id="edge_56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#5B21B6;strokeWidth=2.6;endArrow=block;endFill=1;" edge="1" parent="1" source="grp_29" target="grp_31"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="395" as="sourcePoint" /><mxPoint x="1122" y="445" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#5B21B6;strokeWidth=2.6;endArrow=block;endFill=1;" edge="1" parent="1" source="grp_29" target="grp_33"><mxGeometry relative="1" as="geometry"><mxPoint x="1660" y="395" as="sourcePoint" /><mxPoint x="1675" y="445" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#1E3A8A;strokeWidth=2.6;endArrow=block;endFill=1;" edge="1" parent="1" source="grp_31" target="grp_35"><mxGeometry relative="1" as="geometry"><mxPoint x="1122" y="775" as="sourcePoint" /><mxPoint x="1150" y="835" as="targetPoint" /><Array as="points"><mxPoint x="1122" y="810" /><mxPoint x="1150" y="810" /></Array></mxGeometry></mxCell><mxCell id="edge_59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#1E3A8A;strokeWidth=2.6;endArrow=block;endFill=1;" edge="1" parent="1" source="grp_33" target="grp_35"><mxGeometry relative="1" as="geometry"><mxPoint x="1675" y="775" as="sourcePoint" /><mxPoint x="1650" y="835" as="targetPoint" /><Array as="points"><mxPoint x="1675" y="810" /><mxPoint x="1650" y="810" /></Array></mxGeometry></mxCell><mxCell id="edge_60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#1E3A8A;strokeWidth=2.6;endArrow=block;endFill=1;" edge="1" parent="1" source="grp_35" target="grp_37"><mxGeometry relative="1" as="geometry"><mxPoint x="1400" y="1040" as="sourcePoint" /><mxPoint x="1400" y="1095" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#059669;strokeWidth=2.6;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;" edge="1" parent="1" source="grp_37" target="grp_39"><mxGeometry relative="1" as="geometry"><mxPoint x="1400" y="1265" as="sourcePoint" /><mxPoint x="1400" y="1320" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#5B21B6;strokeWidth=3.0;endArrow=block;endFill=1;" edge="1" parent="1" source="grp_35" target="grp_41"><mxGeometry relative="1" as="geometry"><mxPoint x="1935" y="937" as="sourcePoint" /><mxPoint x="2035" y="335" as="targetPoint" /><Array as="points"><mxPoint x="1985" y="937" /><mxPoint x="1985" y="335" /></Array></mxGeometry></mxCell><mxCell id="edge_63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#D97706;strokeWidth=3.0;endArrow=block;endFill=1;" edge="1" parent="1" source="grp_37" target="grp_49"><mxGeometry relative="1" as="geometry"><mxPoint x="1935" y="1180" as="sourcePoint" /><mxPoint x="2035" y="1427" as="targetPoint" /><Array as="points"><mxPoint x="1985" y="1180" /><mxPoint x="1985" y="1427" /></Array></mxGeometry></mxCell><mxCell id="edge_64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#059669;strokeWidth=2.6;endArrow=block;endFill=1;" edge="1" parent="1" source="grp_41" target="grp_43"><mxGeometry relative="1" as="geometry"><mxPoint x="2380" y="460" as="sourcePoint" /><mxPoint x="2380" y="510" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#5B21B6;strokeWidth=2.6;endArrow=block;endFill=1;" edge="1" parent="1" source="grp_43" target="grp_45"><mxGeometry relative="1" as="geometry"><mxPoint x="2380" y="700" as="sourcePoint" /><mxPoint x="2380" y="755" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#9F1239;strokeWidth=2.6;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;" edge="1" parent="1" source="grp_45" target="grp_47"><mxGeometry relative="1" as="geometry"><mxPoint x="2380" y="995" as="sourcePoint" /><mxPoint x="2380" y="1050" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge_67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#D97706;strokeWidth=2.6;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;" edge="1" parent="1" source="grp_49" target="grp_45"><mxGeometry relative="1" as="geometry"><mxPoint x="2035" y="1427" as="sourcePoint" /><mxPoint x="2035" y="875" as="targetPoint" /><Array as="points"><mxPoint x="2015" y="1427" /><mxPoint x="2015" y="875" /></Array></mxGeometry></mxCell><mxCell id="grp_11" value="左侧: 锅炉水冷壁耐高温传感阵列 (Track A 全进口 / Track B 混合高性价比)  →  中部: 标准版 BS-STD-600 / 旗舰版 BS-PRO-2000 机柜光学与电信号链  →  右侧: 工业上位机、单向网闸 DCS 与两阶段 AI 平台" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=13;align=left;verticalAlign=top;spacingTop=46;spacingLeft=12;spacingRight=12;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="2720" height="80" as="geometry" /></mxCell><mxCell id="hdr_12" value="BoilerSense-AI™ 双档模块化集成系统物理与信号接口全图 (全外购国际现货硬件 + 自研软件/旁路AI)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="2720" height="40" as="geometry" /></mxCell><mxCell id="grp_19" value="• TIG 满焊于膜式水冷壁向火侧/背火侧鳍片或管冠&#10;• 内置 Φ1.5mm 松套通孔，热传递路径 10mm (ΔT≈-3.2°C @350kW/m²)&#10;• 配合防磨耐火护瓦与炉墙膨胀补偿密封套管" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#451A03;fontSize=12;align=left;verticalAlign=top;spacingTop=44;spacingLeft=12;spacingRight=12;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="75" y="210" width="690" height="170" as="geometry" /></mxCell><mxCell id="hdr_20" value="1.1 水冷壁焊接导热块 (15CrMoG / 12Cr1MoVG)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#B45309;strokeColor=#B45309;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="75" y="210" width="690" height="38" as="geometry" /></mxCell><mxCell id="grp_21" value="• 德国 FBGS FSG-A01 飞秒穿透涂覆层直写 (免剥皮 &gt;200 kpsi)&#10;• 美国 OFS PyroCoat® / 英国 Fibercore SM1500SC 纯石英芯光纤&#10;• 瑞士/瑞典 Sandvik Φ1.2mm 316L / Inconel 600 松套毛细管铠装" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontColor=#064E3B;fontSize=12;align=left;verticalAlign=top;spacingTop=44;spacingLeft=12;spacingRight=12;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="75" y="430" width="690" height="175" as="geometry" /></mxCell><mxCell id="hdr_22" value="1.2 Track A 全进口高温光栅串 (标杆配置)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#065F46;strokeColor=#065F46;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="75" y="430" width="690" height="38" as="geometry" /></mxCell><mxCell id="grp_23" value="• 长飞/OFS 200 kpsi 抗氢损碳-聚酰亚胺特种单模纤&#10;• 严选认证飞秒直写(25-40点/纤) 或 拉丝塔 DTG/UWFBG(80-125点)&#10;• 激光连续焊接不锈钢微细铠装光缆 + 现场防拉脱接续盒" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontColor=#064E3B;fontSize=12;align=left;verticalAlign=top;spacingTop=44;spacingLeft=12;spacingRight=12;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="75" y="655" width="690" height="175" as="geometry" /></mxCell><mxCell id="hdr_24" value="1.3 Track B 高性价比量产光栅串 (招标主打)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#065F46;strokeColor=#065F46;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="75" y="655" width="690" height="38" as="geometry" /></mxCell><mxCell id="grp_25" value="• 单通道 1510-1595nm 间隔 3.2nm (25点) 或 2.8nm (32点)&#10;• 耐高温阻燃金属软管穿桥架引至电子间 (总长 80–200m)&#10;• 统一 FC/APC (8°斜面低回反 RL&gt;55dB) 防尘接头接入机柜后板" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontSize=12;align=left;verticalAlign=top;spacingTop=44;spacingLeft=12;spacingRight=12;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="75" y="880" width="690" height="175" as="geometry" /></mxCell><mxCell id="hdr_26" value="1.4 铠装尾缆与炉前汇接箱 (OTDR 验收红线)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="75" y="880" width="690" height="38" as="geometry" /></mxCell><mxCell id="grp_27" value="• 严禁胶水粘死光栅区：光栅必须悬空松套于毛细管内完全去应力&#10;• 弯曲半径 ≥30mm (盘纤盒 ≥40mm)，熔接单点损耗 ≤0.08 dB&#10;• 冷态焊后 + 热态升温全通道 OTDR &amp; 光谱 SNR ≥18 dB 签字验收" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#4C0519;fontSize=12;align=left;verticalAlign=top;spacingTop=44;spacingLeft=12;spacingRight=12;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="75" y="1110" width="690" height="180" as="geometry" /></mxCell><mxCell id="hdr_28" value="1.5 现场安装三大绝对工程红线" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#9F1239;strokeColor=#9F1239;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="75" y="1110" width="690" height="38" as="geometry" /></mxCell><mxCell id="grp_29" value="• 瑞士 Sercalo SW1x16 / SW1x32 / SW1x48 军工级 MEMS 光开关 (IL≈1.0dB, &lt;1ms切换, &gt;10^10次寿命)&#10;• 控制接口: RS-232 (115200bps) / USB / 5V TTL I/O 帧同步触发，FC/APC 单模端口直出&#10;• 三端口高功率光学环形器 (Port1光源进 → Port2接MEMS公共端 → Port3回波至探测器)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontSize=12;align=left;verticalAlign=top;spacingTop=44;spacingLeft=12;spacingRight=12;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="865" y="210" width="1070" height="185" as="geometry" /></mxCell><mxCell id="hdr_30" value="2.1 公共多路光学切换与环形隔离前端 (Shared Optical Front-End)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="865" y="210" width="1070" height="38" as="geometry" /></mxCell><mxCell id="grp_31" value="• 光源: 香港/美 Amonics ALS-CL-15-M-FA&#10;  (1510-1595nm C+L ASE, +15dBm, +5V/12V供电)&#10;• 解调盒: 丹麦 Ibsen I-MON 512 USB&#10;  (体光栅 + 滨松 G11620 512像元 + 16位ADC)&#10;• 数据接口: USB 2.0 / SPI 3000帧/秒直接吐出&#10;  512点原始光谱数组 (免采集卡、35天出样)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#1E1B4B;fontSize=12;align=left;verticalAlign=top;spacingTop=44;spacingLeft=12;spacingRight=12;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="865" y="445" width="515" height="330" as="geometry" /></mxCell><mxCell id="hdr_32" value="2.2A 标准版 BS-STD-600 核心光引擎" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#5B21B6;strokeColor=#5B21B6;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="865" y="445" width="515" height="38" as="geometry" /></mxCell><mxCell id="grp_33" value="• 光源: 日本 Santec WSL-110/TSL-570 或 Lumentum&#10;  (+13dBm, 50-100Hz扫频, 输出 TTL Trigger 脉冲)&#10;• 参考校准: 美国 Wavelength Ref HCN-13 气室&#10;  + 50GHz 无热 F-P 标准具 (10%分光监测)&#10;• 光电盒: 德国 FEMTO HCA-S-200M-IN (×2 主+参)&#10;  (±15V供电, FC输入 → SMA 50Ω 0~2V 电压输出)&#10;• 采集卡: 德国 Spectrum M2p.5922-x4 PCIe 16位卡" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#1E1B4B;fontSize=12;align=left;verticalAlign=top;spacingTop=44;spacingLeft=12;spacingRight=12;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1415" y="445" width="520" height="330" as="geometry" /></mxCell><mxCell id="hdr_34" value="2.2B 旗舰版 BS-PRO-2000 扫频引擎" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#5B21B6;strokeColor=#5B21B6;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1415" y="445" width="520" height="38" as="geometry" /></mxCell><mxCell id="grp_35" value="• 工业主控: 研华 Advantech ARK-2250L / 德国控创 Kontron 4U 工业服务器 (双千兆电口 + PCIe x4 扩展槽 + 看门狗)&#10;• 配电树: 台湾明纬 MeanWell NDR-240-24 (主24VDC) + 隔离 DC-DC (±15V供FEMTO, +12V/+5V供ASE与MEMS光开关)&#10;• EMC与防浪涌: 机箱单点保护接地 (&lt;1Ω)，IEC 61000-4-4/5 电厂级 4kV 浪涌与群脉冲防护" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontSize=12;align=left;verticalAlign=top;spacingTop=44;spacingLeft=12;spacingRight=12;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="865" y="835" width="1070" height="205" as="geometry" /></mxCell><mxCell id="hdr_36" value="2.3 工业边缘主控计算单元 &amp; 工业电源配电树" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="865" y="835" width="1070" height="38" as="geometry" /></mxCell><mxCell id="grp_37" value="• 协议转换网关: 台湾摩莎 Moxa MGate MB3180 / 工业 OPC UA Server，支持 Modbus TCP / OPC UA / 硬接线 4-20mA 报警继电器&#10;• 一期安全边界: 通过正/反向工业物理单向隔离网闸 (只读采集 DCS 负荷/煤量/风门/吹灰信号，物理阻断反向写操作)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontSize=12;align=left;verticalAlign=top;spacingTop=44;spacingLeft=12;spacingRight=12;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="865" y="1095" width="1070" height="170" as="geometry" /></mxCell><mxCell id="hdr_38" value="2.4 电厂工业通讯与物理隔离安全接口" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1E3A8A;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="865" y="1095" width="1070" height="38" as="geometry" /></mxCell><mxCell id="grp_39" value="• 标定接口: AMETEK Jofra CTC-660 / 三温区 650°C 精密管式标定炉 + 一等铂电阻参考表 (RS-485 闭环控温)&#10;• 老化验收: 高低温湿热箱 (-10°C~+60°C 72h 拷机) + OTDR 光衰减校准台 → 自动生成每根光栅串三阶系数 JSON 表" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontColor=#064E3B;fontSize=12;align=left;verticalAlign=top;spacingTop=44;spacingLeft=12;spacingRight=12;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="865" y="1320" width="1070" height="175" as="geometry" /></mxCell><mxCell id="hdr_40" value="2.5 工厂标定与量产 NPI 测试工装接口" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#065F46;strokeColor=#065F46;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="865" y="1320" width="1070" height="38" as="geometry" /></mxCell><mxCell id="grp_41" value="• 驱动层: Ibsen USB DLL / Spectrum DMA 零拷贝环形队列&#10;• 算法链: 暗电流扣除 → SG滤波 → HCN/F-P 样条非线性校正&#10;  → 加权对数高斯 / LM 亚像素寻峰 (&lt;0.5 pm) → 导热块逆向补偿&#10;• 自诊断: 光强突变断纤定位、通道插损告警、自动重映射" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#1E1B4B;fontSize=12;align=left;verticalAlign=top;spacingTop=44;spacingLeft=12;spacingRight=12;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="2035" y="210" width="690" height="250" as="geometry" /></mxCell><mxCell id="hdr_42" value="3.1 自研高速解调与标定软件栈 (C++ / Python)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#5B21B6;strokeColor=#5B21B6;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2035" y="210" width="690" height="38" as="geometry" /></mxCell><mxCell id="grp_43" value="• 水冷壁四面展开热力云图 (克里金空间插值 + 1Hz实时刷新)&#10;• 时序历史曲线、超温阈值三级告警与单点寿命台账&#10;• 断网本地 SQLite/TimescaleDB 连续缓存 ≥1 年" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontColor=#064E3B;fontSize=12;align=left;verticalAlign=top;spacingTop=44;spacingLeft=12;spacingRight=12;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="2035" y="510" width="690" height="190" as="geometry" /></mxCell><mxCell id="hdr_44" value="3.2 水冷壁三维温度场数字孪生上位机" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#065F46;strokeColor=#065F46;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2035" y="510" width="690" height="38" as="geometry" /></mxCell><mxCell id="grp_45" value="• 结焦洁净因子反演: 热阻增长识别积灰，输出按需吹灰最佳区域与时序&#10;• 爆管寿命预警: 结合 15%–30% 深调峰热交变 + Larson-Miller 蠕变模型&#10;• 燃烧偏斜诊断: 识别切圆火焰刷墙与高温还原性气氛腐蚀高危区" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#1E1B4B;fontSize=12;align=left;verticalAlign=top;spacingTop=44;spacingLeft=12;spacingRight=12;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="2035" y="755" width="690" height="240" as="geometry" /></mxCell><mxCell id="hdr_46" value="3.3 锅炉 AI 一期：旁路只读智慧运行 (零涉网阻力)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#5B21B6;strokeColor=#5B21B6;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2035" y="755" width="690" height="38" as="geometry" /></mxCell><mxCell id="grp_47" value="• 通过发电集团等保三级与电力监控安防合规评估后开放双向接口&#10;• 基于 PINN 物理约束软测量与强化学习，向 DCS 输出吹灰程控触发&#10;  与二次风门偏置建议，目标稳定降低供电煤耗 0.8–1.5 g/kWh" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#4C0519;fontSize=12;align=left;verticalAlign=top;spacingTop=44;spacingLeft=12;spacingRight=12;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="2035" y="1050" width="690" height="225" as="geometry" /></mxCell><mxCell id="hdr_48" value="3.4 锅炉 AI 二期：闭环优化与等保三级升级" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#9F1239;strokeColor=#9F1239;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2035" y="1050" width="690" height="38" as="geometry" /></mxCell><mxCell id="grp_49" value="• OPC UA / Modbus TCP 只读点表 (机组负荷MW、主汽压/温、给煤量、风量)&#10;• 一期硬接线干接点 (24V/2A 无源常开)：全系统严重超温/断纤硬件告警&#10;• 二期 SIS/MIS Web 大屏与集团集中诊断中心远传 API" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontColor=#451A03;fontSize=12;align=left;verticalAlign=top;spacingTop=44;spacingLeft=12;spacingRight=12;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="2035" y="1330" width="690" height="195" as="geometry" /></mxCell><mxCell id="hdr_50" value="3.5 外部电厂 DCS / SIS 交互接口" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#B45309;strokeColor=#B45309;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2035" y="1330" width="690" height="38" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>