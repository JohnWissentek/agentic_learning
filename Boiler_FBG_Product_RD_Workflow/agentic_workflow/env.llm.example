# LLM Gateway Configuration (DashScope OpenAI-Compatible API)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model tiers (fast / producer / critic)
BFBG_FAST_MODEL=qwen3.8-flash
BFBG_FAST_FALLBACK_MODEL=qwen-plus
BFBG_PRODUCER_MODEL=qwen3.8-max
BFBG_PRODUCER_FALLBACK_MODEL=qwen-max
BFBG_CRITIC_MODEL=deepseek-v4-pro
BFBG_CRITIC_FALLBACK_MODEL=qwen3.8-max
BFBG_MAX_REFLECTION_LOOPS=2
BFBG_CONCURRENCY=6
