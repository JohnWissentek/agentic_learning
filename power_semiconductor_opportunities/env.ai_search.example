# ==============================================================================
# AI Search Engine API Keys Template (复制到 .env.ai_search 后填入真实密钥)
# 注意: 真实密钥文件必须命名为 .env.ai_search（已加入 .gitignore，严禁提交）
# ==============================================================================

# 1. 秘塔 AI 搜索 (Metaso AI Search) — 中国境内电力/半导体中文网页、政策、学术与招标研报主力通道
METASO_API_BASE=https://metaso.cn/api/v1
METASO_API_KEY=mk-your-metaso-api-key-here

# 2. Serper.dev (Google Search / Scholar / Patents API) — 全球英文网页、SEMI/IEEE标准、学术与专利主力通道
SERPER_API_KEY=your-serper-api-key-here
SERPER_TIME_RANGE=qdr:y

# 3. 可选扩展 AI 搜索与网页抽取通道（按需填入即自动启用备用/增强路由）
TAVILY_API_KEY=
EXA_API_KEY=
PERPLEXITY_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=
