        <mxCell id="node_s5_vol05_hdr" value="[Stage 5-A · 硬编码] Vol 05 核验证据总索引导出" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1E3A8A;strokeColor=#1E3A8A;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1">
