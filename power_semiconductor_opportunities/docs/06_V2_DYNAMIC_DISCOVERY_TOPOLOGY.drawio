        <mxCell id="node_s7_judge_hdr" value="[Stage 7-A · LLM Judge] Ch 19 五维独立质量终审打分 (0–100 · 及格 &gt;= 85)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#5B21B6;strokeColor=#5B21B6;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1">
