        <mxCell id="node_s0_hitl_hdr" value="[可选人工门禁 · HITL] 审阅 Stage 0 动态涌现赛道清单" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#9F1239;strokeColor=#9F1239;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1">
