        <mxCell id="node_s7_compile_hdr" value="[Stage 7-B · 硬编码] finalize-v2 -&gt; 确定性校验、重算总分与全量落盘" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1E3A8A;strokeColor=#1E3A8A;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1">
