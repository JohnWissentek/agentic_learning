        <mxCell id="node_s7_outputs_hdr" value="[Stage 7-C · V2 交付物] outputs/v2_dynamic_discovery_2026_2036/ + evidence_vault_v2.db" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#065F46;strokeColor=#065F46;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1">
