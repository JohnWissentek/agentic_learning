        <mxCell id="node_s5_join_hdr" value="[Stage 5 Join · 合并] 汇总 00–05 书稿并核验正则硬门禁 (det_checks)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1E3A8A;strokeColor=#1E3A8A;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1">
