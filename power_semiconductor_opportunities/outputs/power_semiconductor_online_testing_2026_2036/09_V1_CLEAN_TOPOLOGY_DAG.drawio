        </mxCell>
        <mxCell id="node_v0_hdr" value="[V0 · 预设静态输入] 研究契约 + 写死 8 赛道与 16 种子" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#065F46;strokeColor=#065F46;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="460" y="184" width="920" height="38" as="geometry" />
        </mxCell>
        <mxCell id="node_v0_body" value="• config/research_contract.yaml (中国信源&gt;=45%, &gt;=85分, 四大支柱权重 35/25/20/20)。&#10;• config/domain_taxonomy.yaml (写死 P1–P4 / S1–S4 赛道名、固定检索词及 16 项 roi_baseline 种子)。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#064E3B;fontSize=14;align=left;verticalAlign=top;spacingLeft=13;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="460" y="222" width="920" height="74" as="geometry" />
        </mxCell>
        <mxCell id="pill_v1_limit" value="V1.0 核心方法论局限：&#10;上来预设 8 赛道与 16 种子，偏“验证找证据”，难自下而上发现未知增量" style="rounded=1;arcSize=50;whiteSpace=wrap;html=0;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="1408" y="205" width="450" height="70" as="geometry" />
