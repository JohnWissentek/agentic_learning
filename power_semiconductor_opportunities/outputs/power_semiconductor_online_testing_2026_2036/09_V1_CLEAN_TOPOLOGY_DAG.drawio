        </mxCell>
        <mxCell id="node_v5b_llm_body" value="5 路严格分域隔离合成 (Context #4)，共写 231 KB 正文；&#10;去重精确引用 81 个 [EV-...] 与 80 处 [ROI-CALC]。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#1E1B4B;fontSize=14;align=left;verticalAlign=top;spacingLeft=13;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1">
