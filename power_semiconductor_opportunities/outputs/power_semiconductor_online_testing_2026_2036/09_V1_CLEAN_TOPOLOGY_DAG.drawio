        <mxCell id="node_v6_rewrite_body" value="按问题分卷定向注入整改清单 (Context #6) 并重算正则摘要回 V6 (本次跳过)。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#1E1B4B;fontSize=13;align=left;verticalAlign=top;spacingLeft=13;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1">
