        <mxCell id="node_v6_refill_hdr" value="[闭环1 · 硬编码] 补搜 CRAG" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1E3A8A;strokeColor=#1E3A8A;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="1596" y="1258" width="266" height="36" as="geometry" />
