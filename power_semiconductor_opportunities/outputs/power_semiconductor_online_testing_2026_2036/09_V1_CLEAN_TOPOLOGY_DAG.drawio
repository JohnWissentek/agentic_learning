        <mxCell id="node_v3a_power_body" value="4 路隔离并发 (Context #2)：P1储能固态电池、P2钙钛矿绿氢、&#10;P3特高压/SF6替代/海缆、P4调峰CCUS + 4角色买方拷问。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#1E1B4B;fontSize=14;align=left;verticalAlign=top;spacingLeft=13;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1">
