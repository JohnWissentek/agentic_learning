        <mxCell id="node_v3b_semi_hdr" value="[V3b · 4× 并行 LLM] 半导体 S1–S4 + STORM" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#5B21B6;strokeColor=#5B21B6;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="960" y="666" width="560" height="38" as="geometry" />
        </mxCell>
        <mxCell id="node_v3b_semi_body" value="4 路隔离并发 (Context #2)：S1 Fab AMC湿化、S2 前道OCD/SAXS、&#10;S3 碳化硅/氮化镓KGD、S4 混合键合HBM + 4角色买方拷问。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#1E1B4B;fontSize=14;align=left;verticalAlign=top;spacingLeft=13;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1">
