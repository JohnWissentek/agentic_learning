          <mxGeometry x="48" y="1262" width="246" height="152" as="geometry" />
        </mxCell>
        <mxCell id="node_v6_rewrite_hdr" value="[闭环2 · LLM #6] 定向重写" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#5B21B6;strokeColor=#5B21B6;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="48" y="1262" width="246" height="36" as="geometry" />
