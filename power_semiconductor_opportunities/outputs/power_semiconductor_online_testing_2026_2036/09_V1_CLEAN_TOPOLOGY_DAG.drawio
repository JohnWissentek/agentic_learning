          <mxGeometry x="430" y="1288" width="980" height="106" as="geometry" />
        </mxCell>
        <mxCell id="node_v5_check_hdr" value="[V5 Join · 硬编码 Python] 正则契约审计 &amp; 五卷头尾摘要截取" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1E3A8A;strokeColor=#1E3A8A;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="430" y="1288" width="980" height="38" as="geometry" />
        </mxCell>
        <mxCell id="node_v5_check_body" value="• 正则统计 EV-(CN|GL)-XXX 引用数、[ROI-CALC] 数、CN信源占比 (63.11%) 与五卷字数。&#10;• 截取各卷 头2200字 + 尾800字 预览包（防止 231 KB 全文送审导致审稿大模型注意力退化）。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#0F172A;fontSize=14;align=left;verticalAlign=top;spacingLeft=13;spacingRight=12;spacingTop=8;spacingBottom=8;overflow=hidden;" vertex="1" parent="1">
