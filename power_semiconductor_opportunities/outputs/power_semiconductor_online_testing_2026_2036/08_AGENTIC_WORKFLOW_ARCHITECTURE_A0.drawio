        <mxCell id="node_n6_6_reviser_hdr" value="[Context #6 + LLM #6] 定向分卷重写并行智能体 (Reviser 00–04)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#5B21B6;strokeColor=#5B21B6;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1">
