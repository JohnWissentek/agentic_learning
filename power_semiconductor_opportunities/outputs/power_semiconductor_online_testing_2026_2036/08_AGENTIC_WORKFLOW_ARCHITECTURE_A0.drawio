        <mxCell id="node_n5_1_ctx4" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=0;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
