        <mxCell id="node_n6_1_det_hdr" value="[硬编码] 契约正则核验与头尾摘要截取" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#1E3A8A;strokeColor=#1E3A8A;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1">
