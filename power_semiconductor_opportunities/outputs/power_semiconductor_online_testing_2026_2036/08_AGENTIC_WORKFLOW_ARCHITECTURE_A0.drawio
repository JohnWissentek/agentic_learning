        <mxCell id="node_n6_2_ctx5_hdr" value="[Context 组装 #5] 异构 Critic 审稿载荷" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#B45309;strokeColor=#B45309;strokeWidth=1;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;overflow=hidden;" vertex="1" parent="1">
