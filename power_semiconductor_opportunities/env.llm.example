# ==============================================================================
# LLM Gateway & Tiered Model Routing Template (复制到 .env.llm 后填入真实密钥)
# 注意: 真实密钥文件必须命名为 .env.llm（已加入 .gitignore，严禁提交）
# 对齐《Agentic Design Patterns》Ch 16 资源感知优化 + Ch 4 异构 Critic 分离
# ==============================================================================

# 阿里云百炼 DashScope OpenAI 兼容端点（主力模型池）
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 分级路由模型分配（Ch 16 Tiered Routing & Fallback）
# - FAST_MODEL: 8路并行轨道检索压缩、文档筛选与结构化抽取（高并发低延迟）
# - PRODUCER_MODEL: 顶层规划、4角色STORM拷问、分卷深度研报合成
# - CRITIC_MODEL: 异构推理模型承担深度事实核查、SMART目标审计与Stage-Gate裁判
PSO_FAST_MODEL=qwen3.8-flash
PSO_FAST_FALLBACK_MODEL=qwen-plus
PSO_PRODUCER_MODEL=qwen3.8-max
PSO_PRODUCER_FALLBACK_MODEL=qwen-max
PSO_CRITIC_MODEL=deepseek-v4-pro
PSO_CRITIC_FALLBACK_MODEL=qwen3.8-max

# 可选第三方模型网关覆盖（留空则默认走 DashScope）
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
